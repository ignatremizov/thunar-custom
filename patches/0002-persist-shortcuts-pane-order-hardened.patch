+static void
+test_window_bookmark_monitor_teardown (void)
+{
+  g_autofree gchar *legacy_path =
+    g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  g_autofree gchar *gtk_dir =
+    g_path_get_dirname (bookmarks_path);
+  ThunarApplication *application;
+  ThunarWindow      *window = NULL;
+  WindowMonitorTeardown teardown = { &window, FALSE, 0 };
+  g_autofree gchar *config_dir = g_path_get_dirname (gtk_dir);
+  WindowMonitorArmRace arm_race = { config_dir, FALSE };
+  WindowDirectMonitorArmRace direct_arm_race = { gtk_dir, FALSE };
+  GtkWidget         *bookmark_menu;
+  GtkWidget         *old_bookmark_item = NULL;
+  GFile             *old_bookmark_file = NULL;
+  GList             *menu_items;
+  GList             *lp;
+  gint               action_warning_start;
+  gint               load_warning_start;
+
+  if (!display_available)
+    {
+      g_test_skip ("requires a display; rerun this case under Xvfb");
+      return;
+    }
+
+  action_warning_start =
+    g_atomic_int_get (&expected_bookmark_action_warning_count);
+  expect_bookmark_action_warnings = TRUE;
+  g_remove (bookmarks_path);
+  g_assert_cmpint (g_rmdir (gtk_dir), ==, 0);
+  remove_tree (config_dir);
+  write_bookmark_file (legacy_path, "file:///legacy-window\n");
+  thunar_window_set_bookmark_monitor_arm_test_hook (
+    window_monitor_arm_race_hook,
+    &arm_race);
+  application = thunar_application_get ();
+  g_assert_true (g_application_register (G_APPLICATION (application),
+                                         NULL,
+                                         NULL));
+  window = THUNAR_WINDOW (thunar_application_open_window (
+    application,
+    NULL,
+    gdk_screen_get_default (),
+    NULL,
+    TRUE));
+  thunar_window_set_bookmark_monitor_arm_test_hook (NULL, NULL);
+  g_assert_nonnull (window);
+  g_assert_true (arm_race.fired);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+  if (!g_file_test (config_dir, G_FILE_TEST_IS_DIR))
+    g_assert_cmpint (g_mkdir (config_dir, 0700), ==, 0);
+  iterate_main_context_for (100);
+  if (!g_file_test (gtk_dir, G_FILE_TEST_IS_DIR))
+    g_assert_cmpint (g_mkdir (gtk_dir, 0700), ==, 0);
+  iterate_main_context_for (100);
+  write_bookmark_file (bookmarks_path, "file:///canonical-window-change\n");
+  iterate_main_context_for (200);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+
+  /*
+   * Deleting the canonical parent kills a direct pathname monitor.  The
+   * window must re-arm at the surviving ancestor, follow staged recreation
+   * of gtk-3.0, and continue observing subsequent edits.
+   */
+  g_assert_cmpint (g_remove (bookmarks_path), ==, 0);
+  g_assert_cmpint (g_rmdir (gtk_dir), ==, 0);
+  iterate_main_context_for (300);
+  thunar_window_set_bookmark_monitor_arm_test_hook (
+    window_direct_monitor_arm_race_hook,
+    &direct_arm_race);
+  g_assert_cmpint (g_mkdir (gtk_dir, 0700), ==, 0);
+  iterate_main_context_for (300);
+  thunar_window_set_bookmark_monitor_arm_test_hook (NULL, NULL);
+  g_assert_true (direct_arm_race.fired);
+  if (!g_file_test (gtk_dir, G_FILE_TEST_IS_DIR))
+    g_assert_cmpint (g_mkdir (gtk_dir, 0700), ==, 0);
+  write_bookmark_file (bookmarks_path,
+                       "file:///canonical-window-recreated\n");
+  iterate_main_context_for (400);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+  write_bookmark_file (bookmarks_path,
+                       "file:///canonical-window-after-recreate\n");
+  iterate_main_context_for (400);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+
+  bookmark_menu = thunar_window_test_create_bookmarks_menu (window);
+  menu_items = gtk_container_get_children (GTK_CONTAINER (bookmark_menu));
+  for (lp = menu_items; lp != NULL; lp = lp->next)
+    if (g_object_get_data (G_OBJECT (lp->data), "thunar-bookmark-file") != NULL)
+      {
+        old_bookmark_item = lp->data;
+        old_bookmark_file = g_object_ref (
+          g_object_get_data (G_OBJECT (lp->data), "thunar-bookmark-file"));
+        break;
+      }
+  g_list_free (menu_items);
+  g_assert_nonnull (old_bookmark_item);
+  g_assert_nonnull (old_bookmark_file);
+  {
+    g_autofree gchar *uri = g_file_get_uri (old_bookmark_file);
+
+    g_assert_cmpstr (uri, ==, "file:///canonical-window-after-recreate");
+  }
+  g_assert_true (thunar_window_test_setup_bookmark_accelerator (
+    window,
+    old_bookmark_file));
+  g_assert_true (thunar_window_test_activate_bookmark_accelerator (
+    window,
+    old_bookmark_file));
+
+  /*
+   * Keep the old menu open while the monitor removes its bookmark.  The
+   * retained menu item owns the callback's GFile and may still be activated
+   * safely after the window's bookmark list is rebuilt.
+   */
+  write_bookmark_file (bookmarks_path, "");
+  iterate_main_context_for (300);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 0);
+  g_assert_false (thunar_window_test_activate_bookmark_accelerator (
+    window,
+    old_bookmark_file));
+  gtk_menu_item_activate (GTK_MENU_ITEM (old_bookmark_item));
+  write_bookmark_file (bookmarks_path, "file:///canonical-window-change\n");
+  iterate_main_context_for (300);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+  g_clear_object (&old_bookmark_file);
+  old_bookmark_file = g_file_new_for_uri ("file:///canonical-window-change");
+  g_assert_true (thunar_window_test_setup_bookmark_accelerator (
+    window,
+    old_bookmark_file));
+  g_assert_true (thunar_window_test_activate_bookmark_accelerator (
+    window,
+    old_bookmark_file));
+  gtk_widget_destroy (bookmark_menu);
+  g_object_unref (bookmark_menu);
+
+  /*
+   * A failed full load must leave the last good menu source intact.  Invalid
+   * UTF-8 exercises the parse/read failure path without relying on root's
+   * ability to bypass a chmod-based unreadable-file test.
+   */
+  load_warning_start =
+    g_atomic_int_get (&expected_window_bookmark_load_warning_count);
+  expect_window_bookmark_load_warnings = TRUE;
+  g_assert_true (g_file_set_contents (bookmarks_path, "\xff\n", 2, NULL));
+  iterate_main_context_for (300);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+  thunar_window_reconnect_accelerators (window);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+  g_assert_true (thunar_window_test_activate_bookmark_accelerator (
+    window,
+    old_bookmark_file));
+
+  {
+    g_autofree gchar *oversized =
+      g_malloc0 (THUNAR_UTIL_BOOKMARKS_MAX_BYTES + 1);
+
+    memset (oversized, 'x', THUNAR_UTIL_BOOKMARKS_MAX_BYTES + 1);
+    g_assert_true (g_file_set_contents (bookmarks_path,
+                                        oversized,
+                                        THUNAR_UTIL_BOOKMARKS_MAX_BYTES + 1,
+                                        NULL));
+    iterate_main_context_for (300);
+    g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+  }
+
+  /*
+   * A pathname that becomes a directory is an unreadable canonical source;
+   * canonical-first loading must not fall back to the legacy file or discard
+   * the already-installed menu.
+   */
+  g_assert_cmpint (g_remove (bookmarks_path), ==, 0);
+  g_assert_cmpint (g_mkdir (bookmarks_path, 0700), ==, 0);
+  iterate_main_context_for (300);
+  g_assert_cmpuint (thunar_window_get_bookmark_count (window), ==, 1);
+  g_assert_cmpint (g_rmdir (bookmarks_path), ==, 0);
+  write_bookmark_file (bookmarks_path, "file:///canonical-window-final\n");
+  iterate_main_context_for (200);
+  expect_window_bookmark_load_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_window_bookmark_load_warning_count)
+                   - load_warning_start,
+                   >=,
+                   3);
+  g_assert_cmpint (g_atomic_int_get (&expected_window_bookmark_load_warning_count)
+                   - load_warning_start,
+                   <=,
+                   8);
+  g_object_unref (old_bookmark_file);
+
+  /*
+   * This hook is called after the bookmark monitor has queued the coalesced
+   * idle update.  Close the window from the callback, then drain the context
+   * after the last reference is released.
+   */
+  g_object_ref (window);
+  teardown.queued = FALSE;
+  thunar_window_set_bookmark_monitor_test_hook (
+    window_monitor_teardown_hook,
+    &teardown);
+  write_bookmark_file (bookmarks_path, "file:///canonical-window-final\n");
+  iterate_main_context_for (300);
+  thunar_window_set_bookmark_monitor_test_hook (NULL, NULL);
+  g_assert_true (teardown.queued);
+  g_assert_null (window);
+  g_object_unref (application);
+  iterate_main_context_for (300);
+  g_remove (bookmarks_path);
+  g_remove (legacy_path);
+  write_test_bookmarks ();
+  expect_bookmark_action_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_bookmark_action_warning_count)
+                   - action_warning_start,
+                   >=,
+                   1);
+  g_assert_cmpint (g_atomic_int_get (&expected_bookmark_action_warning_count)
+                   - action_warning_start,
+                   <=,
+                   4);
+}
