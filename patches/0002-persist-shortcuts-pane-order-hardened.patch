+
+
+static gboolean
+thunar_shortcuts_model_bookmark_generation_equal (GFile       *source_file,
+                                                  const gchar *etag,
+                                                  GFile       *expected_file,
+                                                  const gchar *expected_etag)
+{
+  return (source_file == NULL) == (expected_file == NULL)
+         && (source_file == NULL
+             || g_file_equal (source_file, expected_file))
+         && g_strcmp0 (etag, expected_etag) == 0;
+}
