+
+  _thunar_return_val_if_fail (G_IS_FILE (location), NULL);
+
+  uri = g_file_get_uri (location);
+  if (uri == NULL)
+    return NULL;
+
+  order_id = g_strconcat ("bookmark:", uri, NULL);
