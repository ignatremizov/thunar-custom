diff --git a/tests/test-bookmarks.c b/tests/test-bookmarks.c
new file mode 100644
index 0000000..2c6d1c0
--- /dev/null
+++ b/tests/test-bookmarks.c
@@ -0,0 +1,1192 @@
+#include "thunar/thunar-util.h"
+
+#include <errno.h>
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <string.h>
+
+#ifdef G_OS_UNIX
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/file.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#endif
+
+typedef struct
+{
+  GPtrArray *uris;
+  GPtrArray *names;
+  GArray    *rows;
+  guint      calls;
+} BookmarkResults;
+
+static gchar *test_root;
+
+
+
+static void
+collect_bookmark (GFile       *file,
+                  const gchar *name,
+                  gint         row_num,
+                  gpointer     user_data)
+{
+  BookmarkResults *results = user_data;
+
+  results->calls++;
+  g_ptr_array_add (results->uris, g_file_get_uri (file));
+  g_ptr_array_add (results->names, g_strdup (name));
+  g_array_append_val (results->rows, row_num);
+}
+
+
+
+static void
+results_init (BookmarkResults *results)
+{
+  results->uris = g_ptr_array_new_with_free_func (g_free);
+  results->names = g_ptr_array_new_with_free_func (g_free);
+  results->rows = g_array_new (FALSE, FALSE, sizeof (gint));
+  results->calls = 0;
+}
+
+
+
+static void
+results_clear (BookmarkResults *results)
+{
+  g_ptr_array_unref (results->uris);
+  g_ptr_array_unref (results->names);
+  g_array_unref (results->rows);
+}
+
+
+
+static void
+remove_tree (const gchar *path)
+{
+  GDir *dir;
+  const gchar *name;
+
+  dir = g_dir_open (path, 0, NULL);
+  if (dir == NULL)
+    {
+      g_remove (path);
+      return;
+    }
+
+  while ((name = g_dir_read_name (dir)) != NULL)
+    {
+      gchar *child = g_build_filename (path, name, NULL);
+      remove_tree (child);
+      g_free (child);
+    }
+  g_dir_close (dir);
+  g_rmdir (path);
+}
+
+
+
+static gchar *
+make_case_dir (const gchar *name)
+{
+  gchar *path = g_build_filename (test_root, name, NULL);
+
+  g_assert_cmpint (g_mkdir_with_parents (path, 0700), ==, 0);
+  return path;
+}
+
+
+
+static void
+write_path (const gchar *path,
+            const gchar *contents)
+{
+  GError *error = NULL;
+
+  g_assert_true (g_file_set_contents (path, contents, -1, &error));
+  g_assert_no_error (error);
+}
+
+
+
+static void
+write_path_len (const gchar *path,
+                const gchar *contents,
+                gsize        length)
+{
+  GError *error = NULL;
+
+  g_assert_true (g_file_set_contents (path, contents, length, &error));
+  g_assert_no_error (error);
+}
+
+
+
+static gchar *
+read_path (const gchar *path)
+{
+  gchar *contents = NULL;
+  gsize length = 0;
+  GError *error = NULL;
+
+  g_assert_true (g_file_get_contents (path, &contents, &length, &error));
+  g_assert_no_error (error);
+  g_assert_cmpint (length, >, 0);
+  return contents;
+}
+
+
+
+static void
+test_canonical_precedes_legacy (void)
+{
+  g_autofree gchar *case_dir = make_case_dir ("canonical-precedes-legacy");
+  g_autofree gchar *canonical_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autofree gchar *legacy_path = g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  g_autoptr (GFile) canonical = g_file_new_for_path (canonical_path);
+  g_autoptr (GFile) source = NULL;
+  g_autofree gchar *etag = NULL;
+  BookmarkResults results;
+
+  write_path (legacy_path, "file:///legacy\n");
+  write_path (canonical_path, "file:///canonical Canonical\n");
+  results_init (&results);
+
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical,
+    collect_bookmark,
+    &results,
+    &source,
+    &etag));
+  g_assert_cmpuint (results.calls, ==, 1);
+  g_assert_cmpstr (g_ptr_array_index (results.uris, 0), ==, "file:///canonical");
+  g_assert_cmpstr (g_ptr_array_index (results.names, 0), ==, "Canonical");
+  g_assert_true (g_file_equal (source, canonical));
+  g_assert_nonnull (etag);
+
+  results_clear (&results);
+  g_remove (legacy_path);
+}
+
+
+
+static void
+test_legacy_fallback_and_confirmed_empty (void)
+{
+  g_autofree gchar *case_dir = make_case_dir ("legacy-fallback-and-empty");
+  g_autofree gchar *fallback_path = g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  g_autofree gchar *canonical_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autoptr (GFile) canonical = g_file_new_for_path (canonical_path);
+  g_autoptr (GFile) source = NULL;
+  g_autofree gchar *source_path = NULL;
+  g_autofree gchar *etag = NULL;
+  BookmarkResults results;
+
+  write_path (fallback_path, "file:///legacy Legacy\n");
+  results_init (&results);
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  g_assert_cmpuint (results.calls, ==, 1);
+  g_assert_cmpstr (g_ptr_array_index (results.uris, 0), ==, "file:///legacy");
+  g_assert_cmpstr (g_ptr_array_index (results.names, 0), ==, "Legacy");
+  source_path = g_file_get_path (source);
+  g_assert_cmpstr (source_path, ==, fallback_path);
+  g_assert_nonnull (etag);
+  results_clear (&results);
+  g_remove (fallback_path);
+
+  write_path (canonical_path, "");
+  g_clear_object (&source);
+  g_clear_pointer (&etag, g_free);
+  results_init (&results);
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  g_assert_cmpuint (results.calls, ==, 0);
+  g_assert_true (g_file_equal (source, canonical));
+  g_assert_nonnull (etag);
+  results_clear (&results);
+}
+
+
+
+static void
+test_empty_legacy_is_selected_source (void)
+{
+  g_autofree gchar *case_dir = make_case_dir ("empty-legacy-source");
+  g_autofree gchar *fallback_path = g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  g_autofree gchar *canonical_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autoptr (GFile) canonical = g_file_new_for_path (canonical_path);
+  g_autoptr (GFile) source = NULL;
+  g_autofree gchar *source_path = NULL;
+  g_autofree gchar *etag = NULL;
+  BookmarkResults results;
+
+  g_assert_false (g_file_test (canonical_path, G_FILE_TEST_EXISTS));
+  write_path (fallback_path, "");
+  results_init (&results);
+
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  g_assert_cmpuint (results.calls, ==, 0);
+  g_assert_nonnull (source);
+  source_path = g_file_get_path (source);
+  g_assert_cmpstr (source_path, ==, fallback_path);
+  g_assert_nonnull (etag);
+
+  results_clear (&results);
+  g_remove (fallback_path);
+}
+
+
+
+static void
+test_legacy_write_rechecks_canonical_precedence (void)
+{
+  g_autofree gchar *case_dir = make_case_dir ("legacy-write-source-check");
+  g_autofree gchar *canonical_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autofree gchar *legacy_path = g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  g_autoptr (GFile) canonical = g_file_new_for_path (canonical_path);
+  g_autoptr (GFile) legacy = g_file_new_for_path (legacy_path);
+  g_autoptr (GFile) source = NULL;
+  g_autofree gchar *etag = NULL;
+  gchar *new_etag = NULL;
+  gchar *contents;
+  BookmarkResults results;
+  GError *error = NULL;
+
+  /*
+   * A caller which prepared the legacy source must not claim that its write
+   * controls the result once canonical appears.  Check the source and
+   * generation again after the legacy replacement.
+   */
+  write_path (legacy_path, "file:///legacy-before\n");
+  results_init (&results);
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  g_assert_true (g_file_equal (source, legacy));
+  results_clear (&results);
+
+  g_assert_true (thunar_util_create_file_atomically (
+    canonical,
+    "file:///external-before\n",
+    strlen ("file:///external-before\n"),
+    &new_etag,
+    &error));
+  g_assert_no_error (error);
+  g_free (new_etag);
+  new_etag = NULL;
+  g_assert_true (thunar_util_replace_contents_with_etag (
+    source,
+    "file:///local-legacy\n",
+    strlen ("file:///local-legacy\n"),
+    etag,
+    &new_etag,
+    &error));
+  g_assert_no_error (error);
+  g_free (new_etag);
+  new_etag = NULL;
+
+  g_clear_object (&source);
+  g_clear_pointer (&etag, g_free);
+  results_init (&results);
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  g_assert_cmpuint (results.calls, ==, 1);
+  g_assert_cmpstr (g_ptr_array_index (results.uris, 0), ==,
+                   "file:///external-before");
+  g_assert_true (g_file_equal (source, canonical));
+  results_clear (&results);
+
+  /*
+   * The same check is required for a race after the legacy publication.  A
+   * canonical-first reread observes the external canonical content and
+   * provides the state a failed local operation must reconcile to.
+   */
+  g_remove (canonical_path);
+  write_path (legacy_path, "file:///legacy-after\n");
+  g_clear_object (&source);
+  g_clear_pointer (&etag, g_free);
+  results_init (&results);
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  results_clear (&results);
+
+  g_assert_true (thunar_util_replace_contents_with_etag (
+    source,
+    "file:///local-after\n",
+    strlen ("file:///local-after\n"),
+    etag,
+    &new_etag,
+    &error));
+  g_assert_no_error (error);
+  g_free (new_etag);
+  new_etag = NULL;
+  g_assert_true (thunar_util_create_file_atomically (
+    canonical,
+    "file:///external-after\n",
+    strlen ("file:///external-after\n"),
+    &new_etag,
+    &error));
+  g_assert_no_error (error);
+  g_free (new_etag);
+
+  g_clear_object (&source);
+  g_clear_pointer (&etag, g_free);
+  results_init (&results);
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  g_assert_cmpstr (g_ptr_array_index (results.uris, 0), ==,
+                   "file:///external-after");
+  g_assert_true (g_file_equal (source, canonical));
+  contents = read_path (canonical_path);
+  g_assert_cmpstr (contents, ==, "file:///external-after\n");
+  g_free (contents);
+  results_clear (&results);
+  g_remove (legacy_path);
+}
+
+
+
