+static void
+thunar_shortcuts_model_schedule_bookmark_monitor_retry (
+  ThunarShortcutsModel *model)
+{
+  guint delay;
+
+  if (model->bookmarks_monitor_retry_id != 0)
+    return;
+
+  delay = 100U << MIN (model->bookmarks_monitor_retry_attempt, 5U);
+  delay = MIN (delay, 5000U);
+  if (model->bookmarks_monitor_retry_attempt < 5)
+    ++model->bookmarks_monitor_retry_attempt;
+  model->bookmarks_monitor_retry_id =
+    g_timeout_add_full (G_PRIORITY_DEFAULT,
+                        delay,
+                        thunar_shortcuts_model_retry_bookmark_monitors,
+                        model,
+                        NULL);
+}
