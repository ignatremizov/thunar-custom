+
+
+static GLogWriterOutput
+test_log_writer (GLogLevelFlags   log_level,
+                 const GLogField *fields,
+                 gsize            n_fields,
+                 gpointer         user_data)
+{
+  gchar *domain;
+  gchar *message;
+
+  (void) user_data;
+
+  domain = log_field_dup (fields, n_fields, "GLIB_DOMAIN");
+  message = log_field_dup (fields, n_fields, "MESSAGE");
+  if ((log_level & G_LOG_LEVEL_MASK) == G_LOG_LEVEL_WARNING
+      && g_strcmp0 (domain, "thunar") == 0
+      && message != NULL
+      && (g_strcmp0 (
+            message,
+            "ThunarThumbnailer: failed to create proxy: "
+            "Cannot autolaunch D-Bus without X11 $DISPLAY") == 0
+          || g_strcmp0 (
+               message,
+               "ThunarThumbnailer: failed to create proxy: "
+               "Could not connect: Connection refused") == 0))
+    {
+      g_free (message);
+      g_free (domain);
+      return G_LOG_WRITER_HANDLED;
+    }
+
+  if (expect_limit_warning
+      && (log_level & G_LOG_LEVEL_MASK) == G_LOG_LEVEL_WARNING
+      && g_strcmp0 (domain, "thunar") == 0
+      && message != NULL
+      && g_str_has_prefix (message, "Failed to write \""))
+    {
+      g_atomic_int_inc (&expected_limit_warning_count);
+      g_free (message);
+      g_free (domain);
+      return G_LOG_WRITER_HANDLED;
+    }
+
+  if ((log_level & (G_LOG_LEVEL_WARNING | G_LOG_LEVEL_CRITICAL)) != 0)
+    g_atomic_int_inc (&unexpected_warning_count);
+  g_free (message);
+  g_free (domain);
+  return g_log_writer_default (log_level, fields, n_fields, NULL);
+}
