+   * proves that this bookmark still owns a live closure; this helper
+   * deliberately does not rebuild the group.
+   */
+  gtk_accel_groups_activate (G_OBJECT (window),
+                             key.accel_key,
+                             key.accel_mods);
+  return TRUE;
+}
