+static void
+thunar_shortcuts_model_device_added_finish (GFile      *location,
+                                            ThunarFile *file,
+                                            GError     *error,
+                                            gpointer    user_data)
+{
+  ThunarShortcutFileGetData *data = user_data;
+  ThunarShortcut            *shortcut = data->shortcut;
+  ThunarShortcutsModel      *model = data->model;
+  ThunarDevice              *device = g_object_ref (shortcut->device);
+  GFile                     *current_root;
+  gboolean                   locked = FALSE;
+  gboolean                   present;
+  gboolean                   ready = TRUE;
+
+  current_root = thunar_device_get_root (shortcut->device);
+  present = thunar_shortcuts_model_device_is_present (model, shortcut->device);
+  if (!present)
+    {
+      thunar_shortcut_free (shortcut, model);
+    }
+  else if (current_root != NULL
+           && !g_file_equal (location, current_root))
+    {
+      /*
+       * The callback describes an obsolete root.  Retry against the current
+       * root using the same pending row instead of inserting stale data,
+       * including when the obsolete lookup itself failed.
+       *
+       * current_root is an owned reference from thunar_device_get_root().
+       * Transfer that reference to the retry callback: the callback always
+       * consumes its location reference, including the synchronous cached
+       * lookup path.  Do not release it after this call, or a cache hit would
+       * release it twice and an asynchronous lookup could use a dead GFile.
+       */
+      thunar_file_get_async (current_root, NULL,
+                             &thunar_shortcuts_model_device_added_finish,
+                             data);
+      g_object_unref (device);
+      g_object_unref (location);
+      return;
+    }
+  else if (error == NULL)
+    {
+      /*
+       * The device may have changed while its ThunarFile was loading.
+       * Acquire before changing the model, then re-read all state from the
+       * live device and latest durable order immediately before insertion.
+       */
+      if (thunar_preferences_xfconf_available (model->preferences))
+        {
+          locked =
+            thunar_shortcuts_model_acquire_devices_order_lock (model, NULL);
+          ready = locked
+                  && thunar_shortcuts_model_refresh_order (
+                       model,
+                       THUNAR_SHORTCUT_SECTION_DEVICES);
+        }
+
+      if (!ready)
+        {
+          if (locked)
+            thunar_shortcuts_model_release_devices_order_lock (model);
+          thunar_shortcuts_model_request_devices_reconcile (model);
+          thunar_shortcut_free (shortcut, model);
+        }
+      else
+        {
+          thunar_shortcuts_model_update_device_shortcut (model,
+                                                         shortcut,
+                                                         NULL);
+          if (current_root != NULL)
+            shortcut->file = g_object_ref (file);
+
+          /* insert in the model */
+          thunar_shortcuts_model_add_shortcut (model, shortcut);
+          thunar_shortcuts_model_finish_device_add_ordering (model, shortcut);
+          thunar_shortcuts_model_header_visibility (model);
+          if (locked)
+            thunar_shortcuts_model_release_devices_order_lock (model);
+        }
+    }
+  else
+    {
+      thunar_shortcut_free (shortcut, model);
+    }
+
+  g_hash_table_remove (model->pending_device_adds, device);
+  g_object_unref (device);
+  if (current_root != NULL)
+    g_object_unref (current_root);
+  g_object_unref (location);
+  g_object_unref (model);
+  g_slice_free (ThunarShortcutFileGetData, data);
+}
