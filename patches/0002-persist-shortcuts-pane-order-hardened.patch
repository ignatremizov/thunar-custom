+static void
+test_devices_callback_save_rollback_and_restart_claim (void)
+{
+  const gchar *baseline[] = {
+    "device:filesystem",
+    "device:a",
+    "device:b",
+    NULL,
+  };
+  g_autoptr (TestVolume) volume_a =
+    test_volume_new ("A", "a", "/dev/test-owner-a", NULL);
+  g_autoptr (TestVolume) volume_b =
+    test_volume_new ("B", "b", "/dev/test-owner-b", NULL);
+  g_autoptr (ThunarDevice) device_a = test_device_new (volume_a);
+  g_autoptr (ThunarDevice) device_b = test_device_new (volume_b);
+  ThunarDevice *devices[] = {
+    device_a,
+    device_b,
+  };
+  g_autoptr (ThunarPreferences) preferences = thunar_preferences_get ();
+  ThunarDeviceMonitor *monitor = thunar_device_monitor_get ();
+  ThunarShortcutsModel *model;
+  DeviceWriteConflict conflict = {
+    baseline,
+    0,
+  };
+  gchar **stored = NULL;
+  gchar *actual_uuid;
+  gboolean found_claim;
+
+  g_object_set (preferences,
+                "shortcuts-devices-order", baseline,
+                NULL);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  emit_test_devices (monitor, devices, G_N_ELEMENTS (devices));
+  g_assert_true (device_precedes (GTK_TREE_MODEL (model),
+                                  device_a,
+                                  device_b));
+
+  /*
+   * A changes to B while B still exists.  Force a competing durable value
+   * after every production write; callback staging must roll back its claim
+   * metadata and visible order while retaining A's actual current UUID B.
+   */
+  thunar_shortcuts_model_set_device_order_write_test_hook (
+    device_write_conflict_hook,
+    &conflict);
+  test_volume_set_uuid (volume_a, "b");
+  test_device_emit (monitor, "device-changed", device_a);
+  thunar_shortcuts_model_set_device_order_write_test_hook (NULL, NULL);
+  g_assert_cmpuint (conflict.writes, ==, 1);
+  actual_uuid = thunar_device_get_identifier_uuid (device_a);
+  g_assert_cmpstr (actual_uuid, ==, "b");
+  g_free (actual_uuid);
+  g_assert_true (device_precedes (GTK_TREE_MODEL (model),
+                                  device_a,
+                                  device_b));
+  stored = read_devices_order (preferences);
+  g_assert_true (test_strv_equal ((const gchar *const *) stored,
+                                  baseline));
+  g_strfreev (stored);
+  stored = NULL;
+  g_clear_object (&model);
+
+  /*
+   * Let the same collision commit.  The old A slot becomes a durable claim
+   * tied to /dev/test-owner-a, and a fresh model reconstructs that ownership
+   * independently of enumeration order.
+   */
+  test_volume_set_uuid (volume_a, "a");
+  g_object_set (preferences,
+                "shortcuts-devices-order", baseline,
+                NULL);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  emit_test_devices (monitor, devices, G_N_ELEMENTS (devices));
+  test_volume_set_uuid (volume_a, "b");
+  test_device_emit (monitor, "device-changed", device_a);
+  stored = read_devices_order (preferences);
+  found_claim = FALSE;
+  for (guint n = 0; stored != NULL && stored[n] != NULL; ++n)
+    found_claim |= g_str_has_prefix (stored[n], "device:claim-v1:");
+  g_assert_true (found_claim);
+  g_strfreev (stored);
+  stored = NULL;
+  g_clear_object (&model);
+
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  test_device_emit (monitor, "device-added", device_b);
+  test_device_emit (monitor, "device-added", device_a);
+  g_assert_true (device_precedes (GTK_TREE_MODEL (model),
+                                  device_a,
+                                  device_b));
+  {
+    GtkTreePath *source = device_path (GTK_TREE_MODEL (model), device_a);
+    GtkTreePath *anchor = device_path (GTK_TREE_MODEL (model), device_b);
+
+    /* Duplicate current identities remain unrepresentable despite the
+     * restart-stable prior-slot attribution. */
+    g_assert_false (thunar_shortcuts_model_drop_possible (
+      model,
+      source,
+      anchor));
+    gtk_tree_path_free (source);
+    gtk_tree_path_free (anchor);
+  }
+  stored = read_devices_order (preferences);
+  conflict.durable_order = (const gchar *const *) stored;
+  conflict.writes = 0;
+  thunar_shortcuts_model_set_device_order_write_test_hook (
+    device_write_conflict_hook,
+    &conflict);
+  test_device_emit (monitor, "device-removed", device_b);
+  thunar_shortcuts_model_set_device_order_write_test_hook (NULL, NULL);
+  g_assert_cmpuint (conflict.writes, ==, 1);
+  {
+    GtkTreePath *removed_path = device_path (GTK_TREE_MODEL (model),
+                                             device_b);
+    gchar **after_removal = read_devices_order (preferences);
+
+    g_assert_null (removed_path);
+    g_assert_true (test_strv_equal ((const gchar *const *) after_removal,
+                                    (const gchar *const *) stored));
+    g_strfreev (after_removal);
+  }
+  g_strfreev (stored);
+  stored = NULL;
+  g_clear_object (&model);
+  g_object_set (preferences,
+                "shortcuts-devices-order", NULL,
+                NULL);
+  g_object_unref (monitor);
+}
