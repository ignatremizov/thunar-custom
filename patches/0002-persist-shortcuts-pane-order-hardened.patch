+    THUNAR_SHORTCUTS_MODEL_COLUMN_FILE,
+    &changed_file,
+    -1);
+  g_assert_nonnull (changed_file);
+  g_assert_true (gtk_tree_model_get_iter (
+    GTK_TREE_MODEL (model),
+    &iter,
+    g_ptr_array_index (paths, 1)));
+  gtk_tree_model_get (
+    GTK_TREE_MODEL (model),
+    &iter,
+    THUNAR_SHORTCUTS_MODEL_COLUMN_FILE,
+    &second_file,
+    -1);
+  g_assert_true (changed_file == second_file);
+  g_object_unref (second_file);
+  second_file = NULL;
+
+  /*
+   * Change the shared ThunarFile's URI, then exercise the real ::changed
+   * signal path.  The prepare hook inserts another occurrence of the old URI
+   * before the callback can publish.  Occurrence-only replay would update
+   * External and First; the bounded request must reject the whole batch.
+   */
+  thunar_file_replace_file (changed_file, renamed_file);
+  hook.canonical_path = bookmarks_path;
+  hook.canonical_contents = external;
+  hook.point = THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PREPARE;
+  hook.fired = FALSE;
+  thunar_shortcuts_model_set_bookmark_write_test_hook (
+    bookmark_race_hook,
+    &hook);
+  thunar_file_changed (changed_file);
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  iterate_main_context_for (300);
+
+  g_assert_true (hook.fired);
+  g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+  g_assert_cmpstr (contents, ==, external);
+  g_free (contents);
+  g_ptr_array_unref (paths);
+  g_object_unref (changed_file);
+  g_clear_object (&model);
+  iterate_main_context_for (200);
+
+  /*
+   * With no refreshed sequence, even indistinguishable adjacent duplicate
+   * rows retain their original nodes.  The real ::changed signal must update
+   * the complete shared-file set, not re-resolve each middle occurrence by
+   * mutable context.
+   */
+  {
+    ThunarFile *same_file;
+    gchar      *same_initial;
+    gchar      *same_expected;
+    gchar      *renamed_uri;
+
+    same_initial = g_strdup_printf ("%s Same\n%s Same\n",
+                                    shared_uri,
+                                    shared_uri);
+    write_bookmark_file (bookmarks_path, same_initial);
+    model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context_for (200);
+    paths = bookmark_paths (GTK_TREE_MODEL (model));
+    g_assert_cmpuint (paths->len, ==, 2);
+    g_assert_true (gtk_tree_model_get_iter (
+      GTK_TREE_MODEL (model),
+      &iter,
+      g_ptr_array_index (paths, 0)));
+    gtk_tree_model_get (
+      GTK_TREE_MODEL (model),
+      &iter,
+      THUNAR_SHORTCUTS_MODEL_COLUMN_FILE,
+      &same_file,
+      -1);
+    g_assert_nonnull (same_file);
+    thunar_file_replace_file (same_file, renamed_file);
+    thunar_file_changed (same_file);
+    iterate_main_context_for (300);
+    renamed_uri = g_file_get_uri (renamed_file);
+    same_expected = g_strdup_printf ("%s Same\n%s Same\n",
+                                     renamed_uri,
+                                     renamed_uri);
+    g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+    g_assert_cmpstr (contents, ==, same_expected);
+    g_free (contents);
+    contents = NULL;
+    g_free (same_expected);
+    g_free (renamed_uri);
+    g_free (same_initial);
+    g_ptr_array_unref (paths);
+    g_object_unref (same_file);
+    g_clear_object (&model);
+    iterate_main_context_for (200);
+  }
+  g_remove (bookmarks_path);
+}
