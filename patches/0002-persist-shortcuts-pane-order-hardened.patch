+static gboolean
+thunar_shortcuts_model_device_is_present (ThunarShortcutsModel *model,
+                                          ThunarDevice         *device)
+{
+  GList    *devices;
+  GList    *lp;
+  gboolean  present = FALSE;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+  _thunar_return_val_if_fail (THUNAR_IS_DEVICE (device), FALSE);
+
+  devices = thunar_shortcuts_model_get_devices (model);
+  for (lp = devices; lp != NULL; lp = lp->next)
+    {
+      if (lp->data == device)
+        present = TRUE;
+      g_object_unref (lp->data);
+    }
+  g_list_free (devices);
+
+  return present;
+}
