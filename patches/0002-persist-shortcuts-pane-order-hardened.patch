+static gboolean
+thunar_shortcuts_model_device_owner_is_unique (ThunarShortcutsModel *model,
+                                               ThunarShortcut       *shortcut,
+                                               const gchar          *owner_id)
+{
+  GList *lp;
+
+  if (owner_id == NULL)
+    return FALSE;
+
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *other = lp->data;
+
+      if (other != shortcut
+          && other->device != NULL
+          && g_strcmp0 (other->device_order_owner_id, owner_id) == 0)
+        return FALSE;
+    }
+
+  return TRUE;
+}
