+static void
+thunar_shortcuts_model_arm_bookmark_monitor (ThunarShortcutsModel *model,
+                                             gboolean              legacy)
+{
+  GFile        *bookmark_file;
+  GFileMonitor **file_monitor;
+  GFileMonitor **parent_monitor;
+  GFile        *ancestor;
+  GError       *monitor_error = NULL;
+  guint         attempt;
+
+  bookmark_file = legacy ? model->legacy_bookmarks_file : model->bookmarks_file;
+  file_monitor = legacy ? &model->legacy_bookmarks_monitor : &model->bookmarks_monitor;
+  parent_monitor = legacy
+                     ? &model->legacy_bookmarks_parent_monitor
+                     : &model->bookmarks_parent_monitor;
+
+  if (*file_monitor != NULL)
+    return;
+
+  /*
+   * Monitoring setup is best effort.  A backend can reject both directory
+   * and pathname monitors; never spin synchronously on that failure.  Two
+   * passes cover the install/recheck race, after which the model remains
+   * unmonitored until another explicit reload/rearm.
+   */
+  for (attempt = 0; attempt < 2 && *file_monitor == NULL; ++attempt)
+    {
+      ancestor = g_file_get_parent (bookmark_file);
+      if (*parent_monitor != NULL)
+        {
+          g_file_monitor_cancel (*parent_monitor);
+          g_clear_object (parent_monitor);
+        }
+
+      /*
+       * A file monitor for a path whose parent does not exist is not
+       * sufficient: GLib may attach it to the future inode and miss the
+       * parent creation.  Watch the nearest existing ancestor until the
+       * bookmark directory exists, then arm the pathname monitor from its
+       * event.
+       */
+      if (ancestor != NULL && !g_file_query_exists (ancestor, NULL))
+        {
+          GFile *bookmark_parent;
+          GFile *stable_ancestor;
+
+          g_clear_object (&ancestor);
+          ancestor = thunar_shortcuts_model_existing_bookmark_ancestor (
+            bookmark_file);
+          if (ancestor != NULL)
+            {
+              if (g_test_initialized ()
+                  && bookmark_monitor_arm_test_hook != NULL)
+                bookmark_monitor_arm_test_hook (
+                  model,
+                  legacy,
+                  bookmark_monitor_arm_test_hook_data);
+              *parent_monitor = g_file_monitor_directory (
+                ancestor,
+                G_FILE_MONITOR_NONE,
+                NULL,
+                &monitor_error);
+              if (*parent_monitor == NULL)
+                {
+                  g_warning ("Failed to monitor GTK bookmarks ancestor: %s",
+                             monitor_error != NULL
+                               ? monitor_error->message
+                               : "unknown monitor error");
+                  g_clear_error (&monitor_error);
+                  g_object_unref (ancestor);
+                  thunar_shortcuts_model_schedule_bookmark_monitor_retry (model);
+                  return;
+                }
+              if (*parent_monitor != NULL)
+                g_signal_connect_object (
+                  *parent_monitor,
+                  "changed",
+                  G_CALLBACK (thunar_shortcuts_model_monitor_bookmarks_file),
+                  model,
+                  0);
+
+              /*
+               * The directory tree can advance between selecting the
+               * ancestor and installing its monitor.  Recompute immediately
+               * and move the monitor down the tree until the snapshot is
+               * stable.
+               */
+              stable_ancestor =
+                thunar_shortcuts_model_existing_bookmark_ancestor (
+                  bookmark_file);
+              bookmark_parent = g_file_get_parent (bookmark_file);
+              if ((bookmark_parent != NULL
+                   && g_file_query_exists (bookmark_parent, NULL))
+                  || (stable_ancestor != NULL
+                      && !g_file_equal (ancestor, stable_ancestor)))
+                {
+                  if (*parent_monitor != NULL)
+                    {
+                      g_file_monitor_cancel (*parent_monitor);
+                      g_clear_object (parent_monitor);
+                  }
+                  g_clear_object (&stable_ancestor);
+                  g_clear_object (&bookmark_parent);
+                  g_clear_object (&ancestor);
+                  continue;
+                }
+              g_clear_object (&stable_ancestor);
+              g_clear_object (&bookmark_parent);
+              g_object_unref (ancestor);
+            }
+          if (*parent_monitor == NULL)
+            thunar_shortcuts_model_schedule_bookmark_monitor_retry (model);
+          return;
+        }
+
+      if (g_test_initialized ()
+          && bookmark_monitor_arm_test_hook != NULL)
+        bookmark_monitor_arm_test_hook (
+          model,
+          legacy,
+          bookmark_monitor_arm_test_hook_data);
+      *file_monitor = g_file_monitor_file (
+        bookmark_file,
+        G_FILE_MONITOR_NONE,
+        NULL,
+        &monitor_error);
+      if (*file_monitor != NULL)
+        {
+          GFile    *bookmark_parent;
+          gboolean  parent_exists;
+
+          bookmark_parent = g_file_get_parent (bookmark_file);
+          parent_exists = bookmark_parent != NULL
+                          && g_file_query_exists (bookmark_parent, NULL);
+          if (!parent_exists)
+            {
+              g_file_monitor_cancel (*file_monitor);
+              g_clear_object (file_monitor);
+              g_clear_object (&bookmark_parent);
+              g_clear_object (&ancestor);
+              thunar_shortcuts_model_schedule_bookmark_monitor_retry (model);
+              continue;
+            }
+          g_signal_connect_object (
+            *file_monitor,
+            "changed",
+            G_CALLBACK (thunar_shortcuts_model_monitor_bookmarks_file),
+            model,
+            0);
+          thunar_shortcuts_model_update_bookmark_target_monitor (model, legacy);
+          g_clear_object (&bookmark_parent);
+          g_clear_object (&ancestor);
+          return;
+        }
+      g_warning ("Failed to monitor GTK bookmarks file: %s",
+                 monitor_error != NULL
+                   ? monitor_error->message
+                   : "unknown monitor error");
+      g_clear_error (&monitor_error);
+      g_clear_object (&ancestor);
+      thunar_shortcuts_model_schedule_bookmark_monitor_retry (model);
+      return;
+    }
+}
