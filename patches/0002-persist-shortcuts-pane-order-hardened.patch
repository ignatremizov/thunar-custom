+static void
+iterate_main_context_for (guint milliseconds)
+{
+  gint64 deadline = g_get_monotonic_time () + milliseconds * 1000;
+
+  do
+    {
+      iterate_main_context ();
+      g_usleep (10 * 1000);
+    }
+  while (g_get_monotonic_time () < deadline);
