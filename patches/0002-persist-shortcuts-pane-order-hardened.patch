+typedef struct
+{
+  GMutex   mutex;
+  GCond    cond;
+  guint    ready;
+  gboolean start;
+} CreateRaceGate;
+
+typedef struct
+{
+  CreateRaceGate *gate;
+  GFile          *file;
+  gchar          *contents;
+  gchar          *new_etag;
+  GError         *error;
+  gboolean        success;
+} CreateRaceWriter;
+
+
+
+static gpointer
+create_file_race_writer (gpointer user_data)
+{
+  CreateRaceWriter *writer = user_data;
+
+  g_mutex_lock (&writer->gate->mutex);
+  ++writer->gate->ready;
+  g_cond_broadcast (&writer->gate->cond);
+  while (!writer->gate->start)
+    g_cond_wait (&writer->gate->cond, &writer->gate->mutex);
+  g_mutex_unlock (&writer->gate->mutex);
+
+  writer->success = thunar_util_create_file_atomically (
+    writer->file,
+    writer->contents,
+    strlen (writer->contents),
+    &writer->new_etag,
+    &writer->error);
+  return NULL;
+}
+
+
+
+static void
+run_concurrent_absent_source_writers_install_once (gboolean force_no_hard_links)
+{
+  enum
+  {
+    N_WRITERS = 16,
+  };
+  g_autofree gchar *case_dir = make_case_dir (
+    force_no_hard_links ? "concurrent-exclusive-rename" : "concurrent-staged-create");
+  g_autofree gchar *target_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autoptr (GFile) target_file = g_file_new_for_path (target_path);
+  CreateRaceGate gate = {
+    0,
+  };
+  CreateRaceWriter writers[N_WRITERS] = {
+    0,
+  };
+  GThread *threads[N_WRITERS];
+  gchar   *installed_contents;
+  guint    success_count = 0;
+  guint    winner = 0;
+  guint    n;
+
+  if (force_no_hard_links)
+    thunar_util_set_bookmarks_no_hard_links_for_test (TRUE);
+
+  g_mutex_init (&gate.mutex);
+  g_cond_init (&gate.cond);
+  for (n = 0; n < N_WRITERS; ++n)
+    {
+      writers[n].gate = &gate;
+      writers[n].file = g_object_ref (target_file);
+      writers[n].contents = g_strdup_printf ("file:///writer-%u Writer %u\n",
+                                             n,
+                                             n);
+      threads[n] = g_thread_new ("bookmark-create-racer",
+                                 create_file_race_writer,
+                                 &writers[n]);
+    }
+
+  g_mutex_lock (&gate.mutex);
+  while (gate.ready != N_WRITERS)
+    g_cond_wait (&gate.cond, &gate.mutex);
+  gate.start = TRUE;
+  g_cond_broadcast (&gate.cond);
+  g_mutex_unlock (&gate.mutex);
+
+  for (n = 0; n < N_WRITERS; ++n)
+    {
+      g_thread_join (threads[n]);
+      if (writers[n].success)
+        {
+          ++success_count;
+          winner = n;
+          g_assert_no_error (writers[n].error);
+          g_assert_nonnull (writers[n].new_etag);
+        }
+      else
+        {
+          g_assert_error (writers[n].error, G_IO_ERROR, G_IO_ERROR_EXISTS);
+          g_assert_null (writers[n].new_etag);
+        }
+    }
+
+  g_assert_cmpuint (success_count, ==, 1);
+  installed_contents = read_path (target_path);
+  g_assert_cmpstr (installed_contents, ==, writers[winner].contents);
+  g_free (installed_contents);
+  assert_no_staging_files (case_dir);
+#ifdef G_OS_UNIX
+  {
+    struct stat installed_stat;
+
+    g_assert_cmpint (g_stat (target_path, &installed_stat), ==, 0);
+    g_assert_cmpuint (installed_stat.st_mode & 0777, ==, 0600);
+  }
+#endif
+
+  for (n = 0; n < N_WRITERS; ++n)
+    {
+      g_clear_object (&writers[n].file);
+      g_free (writers[n].contents);
+      g_free (writers[n].new_etag);
+      g_clear_error (&writers[n].error);
+    }
+  g_cond_clear (&gate.cond);
+  g_mutex_clear (&gate.mutex);
+
+  if (force_no_hard_links)
+    thunar_util_set_bookmarks_no_hard_links_for_test (FALSE);
+}
+
+
+
+static void
+test_concurrent_absent_source_writers_install_once (void)
+{
+  run_concurrent_absent_source_writers_install_once (FALSE);
+}
