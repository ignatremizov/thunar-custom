+
+
+static gboolean
+thunar_shortcuts_model_order_id_is_unique (ThunarShortcutsModel *model,
+                                           ThunarShortcut       *shortcut)
+{
+  GList *lp;
+
+  if (shortcut->order_id == NULL)
+    return FALSE;
+
+  if (shortcut->device_prior_order_id != NULL)
+    return FALSE;
+
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *other = lp->data;
+
+      if (other != shortcut
+          && other->order_id != NULL
+          && thunar_shortcuts_model_get_section (other->group)
+               == thunar_shortcuts_model_get_section (shortcut->group)
+          && g_strcmp0 (other->order_id, shortcut->order_id) == 0)
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+
+
+static void
+thunar_shortcuts_model_set_order_id (ThunarShortcutsModel *model,
+                                     ThunarShortcut       *shortcut,
+                                     const gchar          *order_id)
+{
+  const gchar *const *order = NULL;
+  guint               n;
+
+  g_free (shortcut->order_id);
+  shortcut->order_id = g_strdup (order_id);
+  shortcut->order_position = G_MAXINT;
+
+  switch (thunar_shortcuts_model_get_section (shortcut->group))
+    {
+    case THUNAR_SHORTCUT_SECTION_PLACES:
+      order = (const gchar *const *) model->places_order;
+      break;
+
+    case THUNAR_SHORTCUT_SECTION_DEVICES:
+      order = (const gchar *const *) model->devices_order;
+      break;
+
+    default:
+      return;
+    }
+
+  if (order != NULL)
+    {
+      for (n = 0; order[n] != NULL; ++n)
+        {
+          if (g_strcmp0 (order[n], shortcut->order_id) == 0)
+            {
+              shortcut->order_position = n;
+              break;
+            }
+        }
+    }
+}
+
+
+
+gboolean
+thunar_shortcuts_model_device_order_id_available_for_rows (const gchar *const *persisted_order,
+                                                           const gchar *const *active_identity_claims,
+                                                           const gchar           *current_order_id,
+                                                           const gchar           *prior_order_id,
+                                                           const gchar           *ignored_order_id,
+                                                           const gchar           *candidate_order_id)
+{
+  gboolean active_owner = FALSE;
+  gboolean own_current_slot = FALSE;
+  gboolean own_prior_slot = FALSE;
+  gboolean ignored_slot = FALSE;
+  gboolean claim_retained_slot;
+
+  if (candidate_order_id == NULL)
+    return FALSE;
+
+  if (active_identity_claims != NULL)
+    {
+      for (guint n = 0; active_identity_claims[n] != NULL; ++n)
+        {
+          if (g_strcmp0 (active_identity_claims[n], candidate_order_id) == 0)
+            {
+              active_owner = TRUE;
+              break;
+            }
+        }
+    }
+
+  if (active_owner)
+    return FALSE;
+
+  /*
+   * A newly constructed row has no identity yet.  It may claim one retained
+   * occurrence only when no active row already owns that UUID.  A row which
+   * is changing away from an existing identity must not claim the target:
+   * its old slot remains reserved while the target is ambiguous.
+   */
+  claim_retained_slot = !active_owner
+                        && current_order_id == NULL
+                        && prior_order_id == NULL;
+
+  if (persisted_order != NULL)
+    {
+      for (guint n = 0; persisted_order[n] != NULL; ++n)
+        {
+          if (g_strcmp0 (persisted_order[n], candidate_order_id) != 0)
+            continue;
+
+          if (!own_current_slot
+              && prior_order_id == NULL
+              && g_strcmp0 (current_order_id, candidate_order_id) == 0)
+            {
+              own_current_slot = TRUE;
+              continue;
+            }
+
+          if (!own_prior_slot
+              && prior_order_id != NULL
+              && g_strcmp0 (prior_order_id, candidate_order_id) == 0)
+            {
+              own_prior_slot = TRUE;
+              continue;
+            }
+
+          if (!ignored_slot
+              && ignored_order_id != NULL
+              && g_strcmp0 (ignored_order_id, candidate_order_id) == 0)
+            {
+              ignored_slot = TRUE;
+              continue;
+            }
+
+          if (claim_retained_slot)
+            {
+              claim_retained_slot = FALSE;
+              continue;
+            }
+
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_device_order_id_in_use (ThunarShortcutsModel *model,
+                                               ThunarShortcut       *shortcut,
+                                               const gchar          *order_id,
+                                               const gchar          *ignored_order_id)
+{
+  GList    *lp;
+  gchar   **active_identity_claims;
+  guint     n_active = 0;
+  gboolean  available;
+
+  /*
+   * Keep the ownership policy independent from the live list so construction
+   * and device-change paths apply exactly the same retained-slot rules.
+   * A prior identity is an active claim until its ambiguity is resolved.
+   */
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *other = lp->data;
+
+      if (other != shortcut
+          && thunar_shortcuts_model_get_section (other->group)
+               == THUNAR_SHORTCUT_SECTION_DEVICES
+          && (other->order_id != NULL
+              || other->device_prior_order_id != NULL))
+        {
+          if (other->order_id != NULL)
+            ++n_active;
+          if (other->device_prior_order_id != NULL)
+            ++n_active;
+        }
+    }
+
+  active_identity_claims = g_newa (gchar *, n_active + 1);
+  n_active = 0;
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *other = lp->data;
+
+      if (other != shortcut
+          && thunar_shortcuts_model_get_section (other->group)
+               == THUNAR_SHORTCUT_SECTION_DEVICES
+          && (other->order_id != NULL
+              || other->device_prior_order_id != NULL))
+        {
+          if (other->order_id != NULL)
+            active_identity_claims[n_active++] = other->order_id;
+          if (other->device_prior_order_id != NULL)
+            active_identity_claims[n_active++] = other->device_prior_order_id;
+        }
+    }
+  active_identity_claims[n_active] = NULL;
+
+  available = thunar_shortcuts_model_device_order_id_available_for_rows (
+    (const gchar *const *) model->devices_order,
+    (const gchar *const *) active_identity_claims,
+    shortcut->order_id,
+    shortcut->device_prior_order_id,
+    ignored_order_id,
+    order_id);
+  return !available;
+}
+
+
+
+static gchar *
+thunar_shortcuts_model_build_device_claim_id (const gchar *owner_id,
+                                              const gchar *order_id)
+{
+  gchar *order_digest;
+  gchar *claim_id;
+
+  if (owner_id == NULL || order_id == NULL)
+    return NULL;
+
+  order_digest = g_compute_checksum_for_string (G_CHECKSUM_SHA256,
+                                                order_id,
+                                                -1);
+  claim_id = g_strconcat (DEVICE_ORDER_CLAIM_VERSION,
+                          owner_id,
+                          ":",
+                          order_digest,
+                          NULL);
+  g_free (order_digest);
+  return claim_id;
+}
+
