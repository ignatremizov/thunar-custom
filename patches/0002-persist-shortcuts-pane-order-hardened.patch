+
+      gtk_tree_model_get (model,
+                          &iter,
+                          THUNAR_SHORTCUTS_MODEL_COLUMN_GROUP,
+                          &group,
+                          -1);
+      if ((group & THUNAR_SHORTCUT_GROUP_PLACES) != 0
+          && (group & THUNAR_SHORTCUT_GROUP_HEADER) == 0
+          && group != THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS)
+        return gtk_tree_path_new_from_indices (index, -1);
+    }
+
+  return NULL;
+}
