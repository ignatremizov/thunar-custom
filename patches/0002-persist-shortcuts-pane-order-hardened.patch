+static gboolean
+thunar_shortcuts_model_replace_order_id (gchar       **order,
+                                         const gchar  *old_order_id,
+                                         const gchar  *new_order_id)
+{
+  if (order == NULL || old_order_id == NULL || new_order_id == NULL)
+    return FALSE;
+
+  for (guint n = 0; order[n] != NULL; ++n)
+    {
+      if (g_strcmp0 (order[n], old_order_id) == 0)
+        {
+          g_free (order[n]);
+          order[n] = g_strdup (new_order_id);
+          return TRUE;
+        }
+    }
+
+  return FALSE;
+}
