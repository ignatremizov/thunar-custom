+
+
+static GPtrArray *
+bookmark_paths (GtkTreeModel *model)
+{
+  return shortcut_paths (model,
+                         THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+                         TRUE);
+}
+
+
+
+static GtkTreePath *
+find_bookmark_path (GtkTreeModel *model,
+                    const gchar  *uri)
+{
+  GPtrArray *paths;
+
+  paths = bookmark_paths (model);
+  for (guint n = 0; n < paths->len; ++n)
+    {
+      GtkTreeIter iter;
+      GFile       *location = NULL;
+      gchar       *candidate_uri;
+
+      gtk_tree_model_get_iter (model, &iter, g_ptr_array_index (paths, n));
+      gtk_tree_model_get (model,
+                          &iter,
+                          THUNAR_SHORTCUTS_MODEL_COLUMN_LOCATION,
+                          &location,
+                          -1);
+      candidate_uri = location == NULL ? NULL : g_file_get_uri (location);
+      g_clear_object (&location);
+      if (g_strcmp0 (candidate_uri, uri) == 0)
+        {
+          GtkTreePath *path = gtk_tree_path_copy (
+            g_ptr_array_index (paths, n));
+
+          g_free (candidate_uri);
+          g_ptr_array_unref (paths);
+          return path;
+        }
+      g_free (candidate_uri);
+    }
+  g_ptr_array_unref (paths);
+  return NULL;
+}
+
+
+
+static GPtrArray *
+shortcut_paths (GtkTreeModel       *model,
+                ThunarShortcutGroup group_filter,
+                gboolean            exact_match)
+{
+  GPtrArray  *paths;
+  GtkTreeIter iter;
+  gboolean    valid;
+
+  paths = g_ptr_array_new_with_free_func (
+    (GDestroyNotify) gtk_tree_path_free);
+  for (valid = gtk_tree_model_get_iter_first (model, &iter);
+       valid;
+       valid = gtk_tree_model_iter_next (model, &iter))
+    {
+      ThunarShortcutGroup group;
+      gboolean            matches;
+
+      gtk_tree_model_get (model,
+                          &iter,
+                          THUNAR_SHORTCUTS_MODEL_COLUMN_GROUP, &group,
+                          -1);
+      matches = exact_match
+                  ? group == group_filter
+                  : ((group & group_filter) != 0
+                     && (group & THUNAR_SHORTCUT_GROUP_HEADER) == 0);
+      if (matches)
+        g_ptr_array_add (paths, gtk_tree_model_get_path (model, &iter));
+    }
+
+  return paths;
+}
+
+
+
+static GtkTreePath *
+group_path (GtkTreeModel       *model,
+            ThunarShortcutGroup wanted_group)
+{
+  GtkTreeIter iter;
+  gboolean    valid;
+
+  for (valid = gtk_tree_model_get_iter_first (model, &iter);
+       valid;
+       valid = gtk_tree_model_iter_next (model, &iter))
+    {
+      ThunarShortcutGroup group;
+
+      gtk_tree_model_get (model,
+                          &iter,
+                          THUNAR_SHORTCUTS_MODEL_COLUMN_GROUP, &group,
+                          -1);
+      if (group == wanted_group)
+        return gtk_tree_model_get_path (model, &iter);
+    }
+
+  return NULL;
+}
