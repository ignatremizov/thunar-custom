+static void
+test_duplicate_labels_and_long_line_are_single_entries (void)
+{
+  g_autofree gchar *case_dir = make_case_dir ("parsing");
+  g_autofree gchar *canonical_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autoptr (GFile) canonical = g_file_new_for_path (canonical_path);
+  g_autoptr (GFile) source = NULL;
+  g_autofree gchar *etag = NULL;
+  g_autoptr (GString) contents = g_string_new (
+    "file:///duplicate First\n"
+    "file:///duplicate Second\n"
+    "\n"
+    " \n");
+  BookmarkResults results;
+  gchar *long_uri;
+
+  long_uri = g_strnfill (1300, 'a');
+  g_string_append_printf (contents, "file:///%s Long\n", long_uri);
+  g_free (long_uri);
+  write_path (canonical_path, contents->str);
+  results_init (&results);
+
+  g_assert_true (thunar_util_load_bookmarks_with_etag (
+    canonical, collect_bookmark, &results, &source, &etag));
+  g_assert_cmpuint (results.calls, ==, 3);
+  g_assert_cmpstr (g_ptr_array_index (results.uris, 0), ==, "file:///duplicate");
+  g_assert_cmpstr (g_ptr_array_index (results.names, 0), ==, "First");
+  g_assert_cmpstr (g_ptr_array_index (results.names, 1), ==, "Second");
+  g_assert_cmpint (g_array_index (results.rows, gint, 0), ==, 1);
+  g_assert_cmpint (g_array_index (results.rows, gint, 1), ==, 2);
+  g_assert_cmpint (g_array_index (results.rows, gint, 2), ==, 3);
+  g_assert_cmpuint (strlen (g_ptr_array_index (results.uris, 2)), >, 1023);
+  g_assert_cmpstr (g_ptr_array_index (results.names, 2), ==, "Long");
+  results_clear (&results);
+}
+
