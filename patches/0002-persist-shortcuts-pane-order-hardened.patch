+
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *shortcut = lp->data;
+
+      if (shortcut->group == THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS)
+        shortcut->sort_id = ++sort_id;
+    }
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_query_bookmark_path_state (
+  GFile     *pathname,
+  gboolean  *present,
+  gchar    **etag,
+  GError   **error)
+{
+  GFileInputStream *stream;
+  GFileInfo        *info;
+  GError           *local_error = NULL;
+
+  _thunar_return_val_if_fail (G_IS_FILE (pathname), FALSE);
+  _thunar_return_val_if_fail (present != NULL, FALSE);
+  _thunar_return_val_if_fail (etag != NULL && *etag == NULL, FALSE);
+  _thunar_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+
+  *present = FALSE;
+  /*
+   * Ask the opened generation for its metadata, exactly as the bookmark
+   * loader does.  This deliberately makes a dangling symlink absent: link
+   * metadata must never make a pathname appear present when its target
+   * cannot be opened.
+   */
+  stream = g_file_read (pathname, NULL, &local_error);
+  if (stream == NULL)
+    {
+      if (g_error_matches (local_error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND)
+          || g_error_matches (local_error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+        {
+          g_clear_error (&local_error);
+          return TRUE;
+        }
+
+      if (error != NULL)
+        *error = local_error;
+      else
+        g_clear_error (&local_error);
+      return FALSE;
+    }
+
+  info = g_file_input_stream_query_info (
+    stream,
+    G_FILE_ATTRIBUTE_ETAG_VALUE,
+    NULL,
+    &local_error);
+  g_input_stream_close (G_INPUT_STREAM (stream), NULL, NULL);
+  g_object_unref (stream);
+  if (info == NULL)
+    {
+      if (error != NULL)
+        *error = local_error;
+      else
+        g_clear_error (&local_error);
+      return FALSE;
+    }
+
+  if (g_file_info_get_etag (info) == NULL)
+    {
+      g_set_error (error,
+                   G_IO_ERROR,
+                   G_IO_ERROR_NOT_SUPPORTED,
+                   "The GTK bookmarks pathname generation is unavailable");
+      g_object_unref (info);
+      return FALSE;
+    }
+
+  *present = TRUE;
+  *etag = g_strdup (g_file_info_get_etag (info));
+  g_object_unref (info);
+  return TRUE;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_query_bookmark_pathname_generation (
+  ThunarShortcutsModel *model,
+  GFile                **source_file,
+  gchar                **etag,
+  GError              **error)
+{
+  GFile *candidates[2] = {
+    model->bookmarks_file,
+    model->legacy_bookmarks_file,
+  };
+  GFile *found_source = NULL;
+  gchar *found_etag = NULL;
+  guint n;
+
+  _thunar_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+  if (source_file != NULL)
+    *source_file = NULL;
+  if (etag != NULL)
+    *etag = NULL;
+
+  for (n = 0; n < G_N_ELEMENTS (candidates); ++n)
+    {
+      gboolean present = FALSE;
+
+      if (!thunar_shortcuts_model_query_bookmark_path_state (
+            candidates[n], &present, &found_etag, error))
+        {
+          g_clear_pointer (&found_etag, g_free);
+          g_clear_object (&found_source);
+          return FALSE;
+        }
+      if (!present)
+        continue;
+
+      found_source = g_object_ref (candidates[n]);
+      break;
+    }
+
+  if (source_file != NULL)
+    *source_file = g_steal_pointer (&found_source);
+  if (etag != NULL)
+    *etag = g_steal_pointer (&found_etag);
+  g_clear_object (&found_source);
+  g_clear_pointer (&found_etag, g_free);
+
+  /* Both canonical and legacy pathnames are absent. */
+  return TRUE;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_query_bookmark_pathname_states (
+  ThunarShortcutsModel *model,
+  gboolean              *canonical_present,
+  gchar                **canonical_etag,
+  gboolean              *legacy_present,
+  gchar                **legacy_etag,
+  GError              **error)
+{
+  GFile        *candidates[2] = {
+    model->bookmarks_file,
+    model->legacy_bookmarks_file,
+  };
+  gboolean      found_present[2] = { FALSE, FALSE };
+  gchar        *found_etag[2] = { NULL, NULL };
+  guint         n;
+
+  _thunar_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+
+  for (n = 0; n < G_N_ELEMENTS (candidates); ++n)
+    {
+      if (!thunar_shortcuts_model_query_bookmark_path_state (
+            candidates[n],
+            &found_present[n],
+            &found_etag[n],
+            error))
+        {
+          g_clear_pointer (&found_etag[0], g_free);
+          g_clear_pointer (&found_etag[1], g_free);
+          return FALSE;
+        }
+    }
+
+  if (canonical_present != NULL)
+    *canonical_present = found_present[0];
+  if (legacy_present != NULL)
+    *legacy_present = found_present[1];
+  if (canonical_etag != NULL)
+    *canonical_etag = g_steal_pointer (&found_etag[0]);
+  if (legacy_etag != NULL)
+    *legacy_etag = g_steal_pointer (&found_etag[1]);
+  g_clear_pointer (&found_etag[0], g_free);
+  g_clear_pointer (&found_etag[1], g_free);
+  return TRUE;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_update_bookmark_pathname_states (
+  ThunarShortcutsModel *model,
+  GError              **error)
+{
+  gboolean canonical_present;
+  gboolean legacy_present;
+  gchar  *canonical_etag = NULL;
+  gchar  *legacy_etag = NULL;
+
+  if (!thunar_shortcuts_model_query_bookmark_pathname_states (
+        model,
+        &canonical_present,
+        &canonical_etag,
+        &legacy_present,
+        &legacy_etag,
+        error))
+    return FALSE;
+
+  model->bookmark_canonical_present = canonical_present;
+  model->bookmark_legacy_present = legacy_present;
+  g_free (model->bookmark_canonical_etag);
+  model->bookmark_canonical_etag = canonical_etag;
+  g_free (model->bookmark_legacy_etag);
+  model->bookmark_legacy_etag = legacy_etag;
+  return TRUE;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_verify_bookmark_pathnames_before_write (
+  ThunarShortcutsModel *model,
+  GError              **error)
+{
+  gboolean canonical_present;
+  gboolean legacy_present;
+  gchar  *canonical_etag = NULL;
+  gchar  *legacy_etag = NULL;
+  gboolean matches;
+
+  if (!thunar_shortcuts_model_query_bookmark_pathname_states (
+        model,
+        &canonical_present,
+        &canonical_etag,
+        &legacy_present,
+        &legacy_etag,
+        error))
+    return FALSE;
+
+  /*
+   * Only the authoritative source generation can invalidate a prepared
+   * write.  A legacy edit is shadowed while canonical exists and must not
+   * reject an otherwise safe canonical publication.  When canonical was
+   * absent, its continued absence is still authoritative because its
+   * appearance changes source selection.
+   */
+  if (model->bookmark_canonical_present)
+    {
+      matches =
+        canonical_present
+        && g_strcmp0 (canonical_etag, model->bookmark_canonical_etag) == 0;
+    }
+  else
+    {
+      matches =
+        !canonical_present
+        && legacy_present == model->bookmark_legacy_present
+        && g_strcmp0 (legacy_etag, model->bookmark_legacy_etag) == 0;
+    }
+  if (!matches && error != NULL)
+    g_set_error_literal (error,
+                         G_IO_ERROR,
+                         G_IO_ERROR_WRONG_ETAG,
+                         "The GTK bookmarks pathnames changed before write");
+  g_free (canonical_etag);
+  g_free (legacy_etag);
+  return matches;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_verify_bookmark_pathnames_after_write (
+  ThunarShortcutsModel *model,
+  GFile                *write_file,
+  const gchar          *new_etag,
+  GError              **error)
+{
+  gboolean canonical_present;
+  gboolean legacy_present;
+  gchar  *canonical_etag = NULL;
+  gchar  *legacy_etag = NULL;
+  gboolean expected_canonical_present;
+  gboolean expected_legacy_present;
+  const gchar *expected_canonical_etag;
+  const gchar *expected_legacy_etag;
+  gboolean matches;
+
+  if (!thunar_shortcuts_model_query_bookmark_pathname_states (
+        model,
+        &canonical_present,
+        &canonical_etag,
+        &legacy_present,
+        &legacy_etag,
+        error))
+    return FALSE;
+
+  expected_canonical_present = model->bookmark_canonical_present;
+  expected_legacy_present = model->bookmark_legacy_present;
+  expected_canonical_etag = model->bookmark_canonical_etag;
+  expected_legacy_etag = model->bookmark_legacy_etag;
+  if (g_file_equal (write_file, model->bookmarks_file))
+    {
+      expected_canonical_present = TRUE;
+      expected_canonical_etag = new_etag;
+    }
+  else if (g_file_equal (write_file, model->legacy_bookmarks_file))
+    {
+      expected_legacy_present = TRUE;
+      expected_legacy_etag = new_etag;
+    }
+
+  if (g_file_equal (write_file, model->bookmarks_file))
+    {
+      matches =
+        canonical_present == expected_canonical_present
+        && g_strcmp0 (canonical_etag, expected_canonical_etag) == 0
+        /*
+         * A canonical file created from an initially empty state must not
+         * shadow a legacy file which appeared during publication.  Once a
+         * canonical source already existed, legacy remains non-authoritative.
+         */
+        && (model->bookmark_canonical_present
+            || legacy_present == model->bookmark_legacy_present);
+    }
+  else
+    {
+      matches =
+        canonical_present == expected_canonical_present
+        && legacy_present == expected_legacy_present
+        && g_strcmp0 (canonical_etag, expected_canonical_etag) == 0
+        && g_strcmp0 (legacy_etag, expected_legacy_etag) == 0;
+    }
+  if (!matches && error != NULL)
+    g_set_error_literal (error,
+                         G_IO_ERROR,
+                         G_IO_ERROR_WRONG_ETAG,
+                         "The GTK bookmarks pathnames changed after write");
+  g_free (canonical_etag);
+  g_free (legacy_etag);
+  return matches;
+}
+
+
+
+static GPtrArray *
+thunar_shortcuts_model_read_bookmark_entries (ThunarShortcutsModel *model,
+                                              GFile                **source_file,
+                                              gchar                **etag,
+                                              GError              **error)
+{
+  GFile     *path_source = NULL;
+  gchar     *path_etag = NULL;
+  GPtrArray *entries;
+
+  _thunar_return_val_if_fail (error == NULL || *error == NULL, NULL);
+  if (source_file != NULL)
+    *source_file = NULL;
+  if (etag != NULL)
+    *etag = NULL;
+
+  entries =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) thunar_shortcuts_model_bookmark_entry_free);
+  if (!thunar_util_load_bookmarks_with_etag_full (
+        model->bookmarks_file,
+        thunar_shortcuts_model_collect_bookmark,
+        entries,
+        source_file,
+        etag,
+        error))
+    {
+      g_ptr_array_unref (entries);
+      return NULL;
+    }
+
+  if (!thunar_shortcuts_model_query_bookmark_pathname_generation (
+        model,
+        &path_source,
+        &path_etag,
+        error))
+    {
+      g_clear_object (source_file);
+      g_clear_pointer (etag, g_free);
+      g_ptr_array_unref (entries);
+      return NULL;
+    }
+
+  if (!thunar_shortcuts_model_bookmark_generation_equal (
+        path_source,
+        path_etag,
+        source_file != NULL ? *source_file : NULL,
+        etag != NULL ? *etag : NULL))
+    {
+      if (error != NULL)
+        g_set_error_literal (error,
+                             G_IO_ERROR,
+                             G_IO_ERROR_WRONG_ETAG,
+                             "The GTK bookmarks pathname changed while reading");
+      g_clear_object (source_file);
+      g_clear_pointer (etag, g_free);
+      g_ptr_array_unref (entries);
+      g_clear_object (&path_source);
+      g_free (path_etag);
+      return NULL;
+    }
+
+  g_clear_object (&path_source);
+  g_free (path_etag);
+  return entries;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_verify_bookmark_pathname_generation (
+  ThunarShortcutsModel *model,
+  GFile                *expected_source_file,
+  const gchar          *expected_etag,
+  GError              **error)
+{
+  GFile    *source_file = NULL;
+  gchar    *etag = NULL;
+  gboolean  matches;
+
+  if (!thunar_shortcuts_model_query_bookmark_pathname_generation (
+        model,
+        &source_file,
+        &etag,
+        error))
+    return FALSE;
+
+  matches = thunar_shortcuts_model_bookmark_generation_equal (
+    source_file,
+    etag,
+    expected_source_file,
+    expected_etag);
+  if (!matches && error != NULL)
+    g_set_error_literal (error,
+                         G_IO_ERROR,
+                         G_IO_ERROR_WRONG_ETAG,
+                         "The GTK bookmarks pathname changed while reading");
+  g_clear_object (&source_file);
+  g_free (etag);
+  return matches;
+}
+
