+
+
+static void
+thunar_shortcuts_model_refresh_persisted_places_order (ThunarShortcutsModel *model,
+                                                       GPtrArray             *bookmark_order)
+{
+  thunar_shortcuts_model_refresh_order (model, THUNAR_SHORTCUT_SECTION_PLACES);
+  thunar_shortcuts_model_merge_bookmark_order (model, bookmark_order);
+  thunar_shortcuts_model_refresh_order_positions (
+    model,
+    THUNAR_SHORTCUT_SECTION_PLACES);
+  thunar_shortcuts_model_sort_shortcuts (model);
+}
