+static GVariant *
+thunar_preferences_call_xfconf (ThunarPreferences   *preferences,
+                                const gchar         *method,
+                                GVariant            *parameters,
+                                const GVariantType  *reply_type,
+                                GError             **error)
+{
+  GDBusConnection *connection = NULL;
