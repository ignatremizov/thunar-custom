+
+  if (g_dbus_connection_is_closed (connection))
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_CLOSED,
+                           "The Xfconf D-Bus connection is closed");
+      g_object_unref (connection);
+      return NULL;
+    }
+
+  reply = g_dbus_connection_call_sync (
+    connection,
+    "org.xfce.Xfconf",
+    "/org/xfce/Xfconf",
+    "org.xfce.Xfconf",
+    method,
+    parameters,
+    reply_type,
+    G_DBUS_CALL_FLAGS_NONE,
+    250,
+    NULL,
+    error);
+  g_object_unref (connection);
+  return reply;
