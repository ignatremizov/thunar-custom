+static void
+thunar_shortcuts_model_apply_bookmark_entries (ThunarShortcutsModel *model,
+                                               GPtrArray             *entries)
+{
+  GList     *lp;
+  GList     *places_bookmarks = NULL;
+  GPtrArray *bookmark_order;
+  guint      n;
+
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *shortcut = THUNAR_SHORTCUT (lp->data);
+      if (shortcut->group == THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS)
+        places_bookmarks = g_list_append (places_bookmarks, shortcut);
+    }
+
+  g_list_foreach (places_bookmarks, (GFunc) (void (*) (void)) thunar_shortcuts_model_remove_shortcut, model);
+  g_list_free (places_bookmarks);
+
+  thunar_shortcuts_model_refresh_order (model, THUNAR_SHORTCUT_SECTION_PLACES);
+  bookmark_order = thunar_shortcuts_model_get_bookmark_entries_order (entries);
+  thunar_shortcuts_model_merge_bookmark_order (model, bookmark_order);
+  g_ptr_array_unref (bookmark_order);
+
+  for (n = 0; n < entries->len; ++n)
+    {
+      ThunarShortcutBookmark *bookmark;
+
+      bookmark = g_ptr_array_index (entries, n);
+      thunar_shortcuts_model_add_bookmark (model,
+                                           bookmark->file,
+                                           bookmark->name,
+                                           bookmark->row_num);
+    }
+
+  if (model->places_order != NULL)
+    thunar_shortcuts_model_save_order (model, THUNAR_SHORTCUT_SECTION_PLACES, FALSE);
+  thunar_shortcuts_model_header_visibility (model);
+}
+
+
+
+static void
+thunar_shortcuts_model_restore_bookmark_snapshot (ThunarShortcutsModel *model)
+{
+  if (model->bookmark_snapshot != NULL)
+    thunar_shortcuts_model_apply_bookmark_entries (model, model->bookmark_snapshot);
+}
