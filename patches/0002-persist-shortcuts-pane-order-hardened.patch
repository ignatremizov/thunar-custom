+static void
+test_cooperative_lock_serializes_pending_window (void)
+{
+#ifdef G_OS_UNIX
+  g_autofree gchar *case_dir = make_case_dir ("cooperative-bookmarks-lock");
+  g_autofree gchar *lock_path = g_build_filename (g_get_user_cache_dir (),
+                                                  "Thunar",
+                                                  "gtk-bookmarks-write.lock",
+                                                  NULL);
+  g_autofree gchar *pending_path = g_build_filename (case_dir, "pending", NULL);
+  gint a_ready[2];
+  gint a_release[2];
+  gint a_done[2];
+  gint b_release[2];
+  gint b_attempting[2];
+  gint b_busy[2];
+  gint b_entered[2];
+  pid_t writer_a;
+  pid_t writer_b;
+  struct pollfd entered_poll;
+  gchar *pending_contents;
+  gint status;
+
+  g_assert_cmpint (pipe (a_ready), ==, 0);
+  g_assert_cmpint (pipe (a_release), ==, 0);
+  g_assert_cmpint (pipe (a_done), ==, 0);
+  g_assert_cmpint (pipe (b_release), ==, 0);
+
+  writer_a = fork ();
+  g_assert_cmpint (writer_a, >=, 0);
+  if (writer_a == 0)
+    {
+      g_autofree gchar *contents = NULL;
+      GError *error = NULL;
+      gint lock_fd;
+
+      close (a_ready[0]);
+      close (a_release[1]);
+      close (a_done[0]);
+      close (b_release[0]);
+      close (b_release[1]);
+
+      lock_fd = thunar_util_acquire_bookmarks_lock (&error);
+      if (lock_fd < 0
+          || !g_file_set_contents (pending_path, "writer-a", -1, NULL)
+          || !write_pipe_byte (a_ready[1])
+          || !read_pipe_byte (a_release[0])
+          || !g_file_get_contents (pending_path, &contents, NULL, NULL)
+          || g_strcmp0 (contents, "writer-a") != 0
+          || g_remove (pending_path) != 0)
+        _exit (10);
+
+      thunar_util_release_bookmarks_lock (lock_fd);
+      if (!write_pipe_byte (a_done[1]))
+        _exit (11);
+      _exit (0);
+    }
+
+  close (a_ready[1]);
+  close (a_release[0]);
+  close (a_done[1]);
+  g_assert_true (read_pipe_byte (a_ready[0]));
+
+  g_assert_cmpint (pipe (b_attempting), ==, 0);
+  g_assert_cmpint (pipe (b_busy), ==, 0);
+  g_assert_cmpint (pipe (b_entered), ==, 0);
+  writer_b = fork ();
+  g_assert_cmpint (writer_b, >=, 0);
+  if (writer_b == 0)
+    {
+      GError *error = NULL;
+      gint lock_fd;
+      gint probe_fd;
+      gint probe_errno;
+
+      close (a_ready[0]);
+      close (a_release[1]);
+      close (a_done[0]);
+      close (b_release[1]);
+      close (b_attempting[0]);
+      close (b_busy[0]);
+      close (b_entered[0]);
+
+      probe_fd = g_open (lock_path, O_RDWR, 0600);
+      if (probe_fd < 0)
+        _exit (20);
+      probe_errno = flock (probe_fd, LOCK_EX | LOCK_NB) < 0 ? errno : 0;
+      close (probe_fd);
+      if ((probe_errno != EWOULDBLOCK && probe_errno != EAGAIN)
+          || !write_pipe_byte (b_attempting[1]))
+        _exit (20);
+
+      lock_fd = thunar_util_acquire_bookmarks_lock (&error);
+      if (lock_fd >= 0
+          || !g_error_matches (error,
+                               G_IO_ERROR,
+                               G_IO_ERROR_WOULD_BLOCK)
+          || !write_pipe_byte (b_busy[1])
+          || !read_pipe_byte (b_release[0]))
+        _exit (21);
+
+      g_clear_error (&error);
+      lock_fd = thunar_util_acquire_bookmarks_lock (&error);
+      if (lock_fd < 0
+          || !g_file_set_contents (pending_path, "writer-b", -1, NULL)
+          || !write_pipe_byte (b_entered[1]))
+        _exit (22);
+
+      thunar_util_release_bookmarks_lock (lock_fd);
+      _exit (0);
+    }
+
+  close (b_attempting[1]);
+  close (b_busy[1]);
+  close (b_entered[1]);
+  close (b_release[0]);
+  g_assert_true (read_pipe_byte (b_attempting[0]));
+
+  entered_poll.fd = b_busy[0];
+  entered_poll.events = POLLIN;
+  entered_poll.revents = 0;
+  g_assert_cmpint (poll (&entered_poll, 1, 200), ==, 1);
+  g_assert_true ((entered_poll.revents & POLLIN) != 0);
+  g_assert_true (g_file_get_contents (pending_path,
+                                      &pending_contents,
+                                      NULL,
+                                      NULL));
+  g_assert_cmpstr (pending_contents, ==, "writer-a");
+  g_free (pending_contents);
+
+  /*
+   * Writer B must report contention promptly and leave the pending value
+   * untouched.  Its later retry is deliberately held until A has finished.
+   */
+  entered_poll.fd = b_entered[0];
+  entered_poll.events = POLLIN;
+  entered_poll.revents = 0;
+  g_assert_cmpint (poll (&entered_poll, 1, 200), ==, 0);
+
+  /*
+   * Writer A performs its compare-and-clear while B has already failed
+   * nonblockingly.  Only after A releases can B install its newer value.
+   */
+  g_assert_true (write_pipe_byte (a_release[1]));
+  g_assert_true (read_pipe_byte (a_done[0]));
+  g_assert_true (write_pipe_byte (b_release[1]));
+  g_assert_true (read_pipe_byte (b_entered[0]));
+
+  g_assert_cmpint (waitpid (writer_a, &status, 0), ==, writer_a);
+  g_assert_true (WIFEXITED (status));
+  g_assert_cmpint (WEXITSTATUS (status), ==, 0);
+  g_assert_cmpint (waitpid (writer_b, &status, 0), ==, writer_b);
+  g_assert_true (WIFEXITED (status));
+  g_assert_cmpint (WEXITSTATUS (status), ==, 0);
+
+  pending_contents = read_path (pending_path);
+  g_assert_cmpstr (pending_contents, ==, "writer-b");
+  g_free (pending_contents);
+  g_assert_true (g_str_has_prefix (lock_path, g_get_user_cache_dir ()));
+  g_assert_true (g_file_test (lock_path, G_FILE_TEST_IS_REGULAR));
+
+  close (a_ready[0]);
+  close (a_release[1]);
+  close (a_done[0]);
+  close (b_release[1]);
+  close (b_attempting[0]);
+  close (b_busy[0]);
+  close (b_entered[0]);
+#else
+  g_test_skip ("requires fork, flock, poll, and waitpid");
+#endif
+}
+
