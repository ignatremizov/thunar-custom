+static void
+test_two_writer_places_moves_rebase_without_lost_update (void)
+{
+  const ThunarShortcutGroup initial_groups[] = {
+    THUNAR_SHORTCUT_GROUP_PLACES_HEADER,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_PLACES_DEFAULT,
+    THUNAR_SHORTCUT_GROUP_PLACES_TRASH,
+    THUNAR_SHORTCUT_GROUP_DEVICES_HEADER,
+  };
+  const gchar *initial_ids[] = {
+    NULL,
+    "bookmark:file:///a",
+    "bookmark:file:///b",
+    "place:home",
+    "place:trash",
+    NULL,
+  };
+  ThunarShortcutGroup persisted_groups[] = {
+    THUNAR_SHORTCUT_GROUP_PLACES_HEADER,
+    THUNAR_SHORTCUT_GROUP_PLACES_TRASH,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_PLACES_DEFAULT,
+    THUNAR_SHORTCUT_GROUP_DEVICES_HEADER,
+  };
+  const gchar *persisted_ids[] = {
+    NULL,
+    "place:trash",
+    "bookmark:file:///a",
+    "bookmark:file:///b",
+    "place:home",
+    NULL,
+  };
+  const gchar *expected_ids[] = {
+    NULL,
+    "place:trash",
+    "bookmark:file:///a",
+    "place:home",
+    "bookmark:file:///b",
+    NULL,
+  };
+  ThunarShortcutMoveRequest writer_b_request = {
+    0,
+  };
+  gint src_index;
+  gint dst_index;
+  gint effective_dst;
+  guint n;
+
+  /*
+   * B requested "home before bookmark B" from the old view.  While B waited
+   * for the cooperative lock, A committed "trash first".  B's stale source
+   * index now names bookmark B, so applying numeric paths would move the
+   * wrong row and overwrite A's ordering decision.
+   */
+  g_assert_true (thunar_shortcuts_model_capture_move_request_for_rows (
+    initial_groups,
+    initial_ids,
+    NULL,
+    G_N_ELEMENTS (initial_groups),
+    3,
+    2,
+    &writer_b_request));
+  g_assert_cmpstr (persisted_ids[3], ==, "bookmark:file:///b");
+
+  g_assert_true (thunar_shortcuts_model_rebase_move_request_for_rows (
+    persisted_groups,
+    persisted_ids,
+    NULL,
+    G_N_ELEMENTS (persisted_groups),
+    &writer_b_request,
+    &src_index,
+    &dst_index,
+    &effective_dst));
+  g_assert_cmpint (src_index, ==, 4);
+  g_assert_cmpint (dst_index, ==, 3);
+  g_assert_cmpint (effective_dst, ==, 3);
+
+  apply_row_move (persisted_groups,
+                  persisted_ids,
+                  src_index,
+                  effective_dst);
+  for (n = 0; n < G_N_ELEMENTS (expected_ids); ++n)
+    g_assert_cmpstr (persisted_ids[n], ==, expected_ids[n]);
+  thunar_shortcuts_model_clear_move_request (&writer_b_request);
+}
