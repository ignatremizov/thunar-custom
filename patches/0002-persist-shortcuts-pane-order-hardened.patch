+
+
+static ThunarBookmarkPrepareResult
+thunar_shortcuts_model_prepare_bookmark_write (ThunarShortcutsModel *model)
+{
+  GFile     *source_file = NULL;
+  gchar     *etag = NULL;
+  GError    *error = NULL;
+  GPtrArray *bookmark_order;
+  GPtrArray *entries;
+
+  _thunar_return_val_if_fail (model->bookmarks_lock_depth > 0,
+                              THUNAR_BOOKMARK_PREPARE_FAILED);
+
+  if (model->bookmark_snapshot == NULL)
+    thunar_shortcuts_model_update_bookmark_snapshot (model);
+  entries = thunar_shortcuts_model_read_bookmark_entries (
+    model,
+    &source_file,
+    &etag,
+    &error);
+  if (entries == NULL)
+    {
+      g_warning ("Failed to read GTK bookmarks before write: %s",
+                 error != NULL ? error->message : "unknown read error");
+      g_clear_error (&error);
+      g_clear_object (&source_file);
+      thunar_shortcuts_model_restore_bookmark_snapshot (model);
+      return THUNAR_BOOKMARK_PREPARE_FAILED;
+    }
+
+  model->bookmark_source_confirmed = TRUE;
+  thunar_shortcuts_model_update_bookmark_generation (model, source_file, etag);
+  /* The model retained its own reference; release the loader's reference. */
+  g_clear_object (&source_file);
+  if (!thunar_shortcuts_model_update_bookmark_pathname_states (model,
+                                                                &error))
+    {
+      g_warning ("Failed to read GTK bookmark pathname state before write: %s",
+                 error != NULL ? error->message : "unknown read error");
+      g_clear_error (&error);
+      g_ptr_array_unref (entries);
+      thunar_shortcuts_model_restore_bookmark_snapshot (model);
+      return THUNAR_BOOKMARK_PREPARE_FAILED;
+    }
+  bookmark_order = thunar_shortcuts_model_get_bookmark_entries_order (entries);
+  if (!thunar_shortcuts_model_recover_places_order_transaction (model,
+                                                                bookmark_order))
+    {
+      g_ptr_array_unref (bookmark_order);
+      g_ptr_array_unref (entries);
+      return THUNAR_BOOKMARK_PREPARE_FAILED;
+    }
+  if (!thunar_shortcuts_model_bookmark_entries_equal (entries, model->bookmark_snapshot))
+    {
+      thunar_shortcuts_model_apply_bookmark_entries (model, entries);
+      if (model->bookmark_snapshot != NULL)
+        g_ptr_array_unref (model->bookmark_snapshot);
+      model->bookmark_snapshot = entries;
+      g_ptr_array_unref (bookmark_order);
+      return THUNAR_BOOKMARK_PREPARE_RECONCILED;
+    }
+
+  thunar_shortcuts_model_refresh_persisted_places_order (model,
+                                                         bookmark_order);
+  g_ptr_array_unref (bookmark_order);
+  g_ptr_array_unref (entries);
+  return THUNAR_BOOKMARK_PREPARE_READY;
+}
+
+
+
+static void
+thunar_shortcuts_model_schedule_bookmark_reconcile (ThunarShortcutsModel *model)
+{
+  if (model->bookmarks_idle_id == 0)
+    model->bookmarks_idle_id = g_idle_add (thunar_shortcuts_model_reload_bookmarks, model);
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_reconcile_bookmarks (ThunarShortcutsModel *model)
+{
+  GFile     *source_file = NULL;
+  gchar     *etag = NULL;
+  GError    *error = NULL;
+  GPtrArray *entries;
+  GPtrArray *bookmark_order;
+  gboolean   success = FALSE;
+  gboolean   recovery_failed = FALSE;
+  gboolean   lock_busy = FALSE;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+
+  if (model->reconciling_bookmarks)
+    {
