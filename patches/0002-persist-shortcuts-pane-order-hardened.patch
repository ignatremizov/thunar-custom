+
+
+static void
+thunar_shortcuts_model_bookmark_entry_free (ThunarShortcutBookmark *bookmark)
+{
+  g_clear_object (&bookmark->file);
+  g_free (bookmark->name);
+  g_free (bookmark->order_id);
+  g_free (bookmark);
+}
