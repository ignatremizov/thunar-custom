+static void
+test_two_writer_devices_moves_and_stale_noop_rebase (void)
+{
+  ThunarShortcutGroup groups[] = {
+    THUNAR_SHORTCUT_GROUP_DEVICES_HEADER,
+    THUNAR_SHORTCUT_GROUP_DEVICES_FILESYSTEM,
+    THUNAR_SHORTCUT_GROUP_DEVICES_VOLUMES,
+    THUNAR_SHORTCUT_GROUP_DEVICES_VOLUMES,
+    THUNAR_SHORTCUT_GROUP_DEVICES_VOLUMES,
+    THUNAR_SHORTCUT_GROUP_DEVICES_VOLUMES,
+    THUNAR_SHORTCUT_GROUP_NETWORK_HEADER,
+  };
+  const gchar *initial_ids[] = {
+    NULL,
+    "device:filesystem",
+    "device:a",
+    "device:b",
+    "device:c",
+    "device:d",
+    NULL,
+  };
+  const gchar *writer_a_committed_ids[] = {
+    NULL,
+    "device:filesystem",
+    "device:a",
+    "device:b",
+    "device:d",
+    "device:c",
+    NULL,
+  };
+  const gchar *combined_expected[] = {
+    NULL,
+    "device:filesystem",
+    "device:b",
+    "device:a",
+    "device:d",
+    "device:c",
+    NULL,
+  };
+  const gchar *stale_noop_latest_ids[] = {
+    NULL,
+    "device:filesystem",
+    "device:b",
+    "device:a",
+    "device:c",
+    "device:d",
+    NULL,
+  };
+  ThunarShortcutMoveRequest disjoint_request = {
+    0,
+  };
+  ThunarShortcutMoveRequest stale_noop_request = {
+    0,
+  };
+  gint src_index;
+  gint dst_index;
+  gint effective_dst;
+
+  /* Writer B captures "B before A" while writer A later commits the
+   * disjoint relation "D before C". */
+  g_assert_true (thunar_shortcuts_model_capture_move_request_for_rows (
+    groups,
+    initial_ids,
+    NULL,
+    G_N_ELEMENTS (groups),
+    3,
+    2,
+    &disjoint_request));
+  g_assert_true (thunar_shortcuts_model_rebase_move_request_for_rows (
+    groups,
+    writer_a_committed_ids,
+    NULL,
+    G_N_ELEMENTS (groups),
+    &disjoint_request,
+    &src_index,
+    &dst_index,
+    &effective_dst));
+  apply_row_move (groups,
+                  writer_a_committed_ids,
+                  src_index,
+                  effective_dst);
+  for (guint n = 0; n < G_N_ELEMENTS (combined_expected); ++n)
+    g_assert_cmpstr (writer_a_committed_ids[n], ==, combined_expected[n]);
+  thunar_shortcuts_model_clear_move_request (&disjoint_request);
+
+  /*
+   * "A before B" is a no-op in the captured view.  It is not a no-op after
+   * another writer commits B before A, so classification must happen only
+   * after refreshing and rebasing against the latest vector.
+   */
+  g_assert_true (thunar_shortcuts_model_capture_move_request_for_rows (
+    groups,
+    initial_ids,
+    NULL,
+    G_N_ELEMENTS (groups),
+    2,
+    3,
+    &stale_noop_request));
+  g_assert_true (stale_noop_request.no_op);
+  g_assert_true (thunar_shortcuts_model_rebase_move_request_for_rows (
+    groups,
+    stale_noop_latest_ids,
+    NULL,
+    G_N_ELEMENTS (groups),
+    &stale_noop_request,
+    &src_index,
+    &dst_index,
+    &effective_dst));
+  g_assert_cmpint (src_index, !=, effective_dst);
+  apply_row_move (groups,
+                  stale_noop_latest_ids,
+                  src_index,
+                  effective_dst);
+  g_assert_cmpstr (stale_noop_latest_ids[2], ==, "device:a");
+  g_assert_cmpstr (stale_noop_latest_ids[3], ==, "device:b");
+  thunar_shortcuts_model_clear_move_request (&stale_noop_request);
+}
