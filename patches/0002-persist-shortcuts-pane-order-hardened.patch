+gboolean
+thunar_preferences_get_string_list (ThunarPreferences *preferences,
+                                    const gchar       *prop_name,
+                                    gchar            ***values,
+                                    GError           **error)
+{
+  ThunarPreferencesPropertyState state;
+  GVariant                      *reply;
+  GVariant                      *value;
+  gsize                          n_values;
+  gsize                          n;
+
+  _thunar_return_val_if_fail (THUNAR_IS_PREFERENCES (preferences), FALSE);
+  _thunar_return_val_if_fail (prop_name != NULL, FALSE);
+  _thunar_return_val_if_fail (values != NULL && *values == NULL, FALSE);
+  _thunar_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+
+  if (g_test_initialized ()
+      && main_order_test_read_failure
+      && g_strcmp0 (prop_name, "/shortcuts-places-order") == 0)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_FAILED,
+                           "Injected Xfconf main-order read failure");
+      return FALSE;
+    }
+
+  state = thunar_preferences_query_property (preferences, prop_name, error);
+  if (state == THUNAR_PREFERENCES_PROPERTY_ERROR)
+    return FALSE;
+  if (state == THUNAR_PREFERENCES_PROPERTY_ABSENT)
+    return TRUE;
+
+  reply = thunar_preferences_call_xfconf (
+    preferences,
+    "GetProperty",
+    g_variant_new ("(ss)", "thunar", prop_name),
+    G_VARIANT_TYPE ("(v)"),
+    error);
+  if (reply == NULL)
+    return FALSE;
+
+  g_variant_get (reply, "(v)", &value);
+  if (g_variant_is_of_type (value, G_VARIANT_TYPE ("as")))
+    {
+      *values = g_variant_dup_strv (value, NULL);
+    }
+  else if (g_variant_is_of_type (value, G_VARIANT_TYPE ("av")))
+    {
+      n_values = g_variant_n_children (value);
+      *values = g_new0 (gchar *, n_values + 1);
+      for (n = 0; n < n_values; ++n)
+        {
+          GVariant *child;
+          GVariant *string_value;
+
+          child = g_variant_get_child_value (value, n);
+          string_value = g_variant_get_variant (child);
+          if (!g_variant_is_of_type (string_value, G_VARIANT_TYPE_STRING))
+            {
+              g_set_error (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_INVALID_DATA,
+                           "Xfconf property %s contains a non-string value",
+                           prop_name);
+              g_variant_unref (string_value);
+              g_variant_unref (child);
+              g_strfreev (*values);
+              *values = NULL;
+              g_variant_unref (value);
+              g_variant_unref (reply);
+              return FALSE;
+            }
+          (*values)[n] = g_variant_dup_string (string_value, NULL);
+          g_variant_unref (string_value);
+          g_variant_unref (child);
+        }
+    }
+  else
+    {
+      g_set_error (error,
+                   G_IO_ERROR,
+                   G_IO_ERROR_INVALID_DATA,
+                   "Xfconf property %s is not a string list",
+                   prop_name);
+      g_variant_unref (value);
+      g_variant_unref (reply);
+      return FALSE;
+    }
+
+  g_variant_unref (value);
+  g_variant_unref (reply);
+  return TRUE;
+}
+
+
+
+gboolean
+thunar_preferences_set_string_list (ThunarPreferences  *preferences,
+                                    const gchar        *prop_name,
+                                    const gchar *const *values,
+                                    GError            **error)
+{
+  GVariantBuilder builder;
+  GVariant       *reply;
+  GVariant       *string_list;
+  guint           n;
+
+  _thunar_return_val_if_fail (THUNAR_IS_PREFERENCES (preferences), FALSE);
+  _thunar_return_val_if_fail (prop_name != NULL, FALSE);
+  _thunar_return_val_if_fail (values != NULL, FALSE);
+  _thunar_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+
+  if (preferences->channel == NULL)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_FAILED,
+                           "Xfconf channel is unavailable");
+      return FALSE;
+    }
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("av"));
+  for (n = 0; values[n] != NULL; ++n)
+    g_variant_builder_add (&builder, "v", g_variant_new_string (values[n]));
+  string_list = g_variant_builder_end (&builder);
+
+  g_signal_handler_block (preferences->channel,
+                          preferences->property_changed_id);
+  reply = thunar_preferences_call_xfconf (
+    preferences,
+    "SetProperty",
+    g_variant_new ("(ssv)", "thunar", prop_name, string_list),
+    G_VARIANT_TYPE_UNIT,
+    error);
+  g_signal_handler_unblock (preferences->channel,
+                            preferences->property_changed_id);
+  if (reply == NULL)
+    return FALSE;
+
+  g_variant_unref (reply);
+  return TRUE;
+}
