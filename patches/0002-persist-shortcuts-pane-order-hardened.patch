+static void
+thunar_window_arm_bookmark_monitor (ThunarWindow *window,
+                                    gboolean      legacy)
+{
+  GFile        *bookmark_file;
+  GFileMonitor **file_monitor;
+  GFileMonitor **parent_monitor;
+  GFile        *ancestor;
+  GError       *monitor_error = NULL;
+  guint         attempt;
+
+  bookmark_file = legacy ? window->legacy_bookmark_file : window->bookmark_file;
+  file_monitor = legacy ? &window->legacy_bookmark_monitor
+                        : &window->bookmark_monitor;
+  parent_monitor = legacy ? &window->legacy_bookmark_parent_monitor
+                          : &window->bookmark_parent_monitor;
+
+  if (*file_monitor != NULL)
+    return;
+
+  /*
+   * Monitoring is best effort.  Bound the install/recheck passes and leave
+   * this source unmonitored if the backend rejects a monitor; retrying
+   * synchronously on the GTK main thread can otherwise spin forever.
+   */
+  for (attempt = 0; attempt < 2 && *file_monitor == NULL; ++attempt)
+    {
+      ancestor = g_file_get_parent (bookmark_file);
+      if (*parent_monitor != NULL)
+        {
+          g_file_monitor_cancel (*parent_monitor);
+          g_clear_object (parent_monitor);
+        }
+
+      /*
+       * Do not create a pathname monitor while its parent directory is
+       * absent. Recompute after installing an ancestor monitor because the
+       * directory tree can advance during that installation.
+       */
+      if (ancestor != NULL && !g_file_query_exists (ancestor, NULL))
+        {
+          GFile *bookmark_parent;
+          GFile *stable_ancestor;
+
+          g_clear_object (&ancestor);
+          ancestor = thunar_window_existing_bookmark_ancestor (bookmark_file);
+          if (ancestor != NULL)
+            {
+              if (g_test_initialized ()
+                  && bookmark_monitor_arm_test_hook != NULL)
+                bookmark_monitor_arm_test_hook (
+                  window,
+                  legacy,
+                  bookmark_monitor_arm_test_hook_data);
+              *parent_monitor = g_file_monitor_directory (
+                ancestor,
+                G_FILE_MONITOR_NONE,
+                NULL,
+                &monitor_error);
+              if (*parent_monitor == NULL)
+                {
+                  g_warning ("Failed to monitor GTK bookmarks ancestor: %s",
+                             monitor_error != NULL
+                               ? monitor_error->message
+                               : "unknown monitor error");
+                  g_clear_error (&monitor_error);
+                  g_object_unref (ancestor);
+                  thunar_window_schedule_bookmark_monitor_retry (window);
+                  return;
+                }
+              if (*parent_monitor != NULL)
+                g_signal_connect_object (
+                  *parent_monitor,
+                  "changed",
+                  G_CALLBACK (thunar_window_bookmarks_changed),
+                  window,
+                  0);
+
+              stable_ancestor =
+                thunar_window_existing_bookmark_ancestor (bookmark_file);
+              bookmark_parent = g_file_get_parent (bookmark_file);
+              if ((bookmark_parent != NULL
+                   && g_file_query_exists (bookmark_parent, NULL))
+                  || (stable_ancestor != NULL
+                      && !g_file_equal (ancestor, stable_ancestor)))
+                {
+                  if (*parent_monitor != NULL)
+                    {
+                      g_file_monitor_cancel (*parent_monitor);
+                      g_clear_object (parent_monitor);
+                    }
+                  g_clear_object (&stable_ancestor);
+                  g_clear_object (&bookmark_parent);
+                  g_clear_object (&ancestor);
+                  continue;
+                }
+              g_clear_object (&stable_ancestor);
+              g_clear_object (&bookmark_parent);
+              g_object_unref (ancestor);
+            }
+          if (*parent_monitor == NULL)
+            thunar_window_schedule_bookmark_monitor_retry (window);
+          return;
+        }
+
+      if (g_test_initialized ()
+          && bookmark_monitor_arm_test_hook != NULL)
+        bookmark_monitor_arm_test_hook (
+          window,
+          legacy,
+          bookmark_monitor_arm_test_hook_data);
+      *file_monitor = g_file_monitor_file (
+        bookmark_file,
+        G_FILE_MONITOR_NONE,
+        NULL,
+        &monitor_error);
+      if (*file_monitor != NULL)
+        {
+          GFile    *bookmark_parent;
+          gboolean  parent_exists;
+
+          bookmark_parent = g_file_get_parent (bookmark_file);
+          parent_exists = bookmark_parent != NULL
+                          && g_file_query_exists (bookmark_parent, NULL);
+          if (!parent_exists)
+            {
+              g_file_monitor_cancel (*file_monitor);
+              g_clear_object (file_monitor);
+              g_clear_object (&bookmark_parent);
+              g_clear_object (&ancestor);
+              thunar_window_schedule_bookmark_monitor_retry (window);
+              continue;
+            }
+          g_signal_connect_object (*file_monitor,
+                                   "changed",
+                                   G_CALLBACK (thunar_window_bookmarks_changed),
+                                   window,
+                                   0);
+          thunar_window_update_bookmark_target_monitor (window, legacy);
+          g_clear_object (&bookmark_parent);
+          g_clear_object (&ancestor);
+          return;
+        }
+      g_warning ("Failed to monitor GTK bookmarks file: %s",
+                 monitor_error != NULL
+                   ? monitor_error->message
+                   : "unknown monitor error");
+      g_clear_error (&monitor_error);
+      g_clear_object (&ancestor);
+      thunar_window_schedule_bookmark_monitor_retry (window);
+      return;
+    }
+}
