+
+
+static gboolean
+device_precedes (GtkTreeModel *model,
+                 ThunarDevice *first,
+                 ThunarDevice *second)
+{
+  g_autoptr (GtkTreePath) first_path = device_path (model, first);
+  g_autoptr (GtkTreePath) second_path = device_path (model, second);
+
+  g_assert_nonnull (first_path);
+  g_assert_nonnull (second_path);
+  return gtk_tree_path_compare (first_path, second_path) < 0;
+}
