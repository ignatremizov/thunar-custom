+typedef struct
+{
+  const gchar *canonical_path;
+  const gchar *canonical_contents;
+  ThunarShortcutsModelBookmarkWriteHookPoint point;
+  gboolean fired;
+} BookmarkRaceHook;
+
+
+
+static void
+bookmark_race_hook (ThunarShortcutsModel                       *model,
+                    ThunarShortcutsModelBookmarkWriteHookPoint  point,
+                    gpointer                                    user_data)
+{
+  BookmarkRaceHook *hook = user_data;
+
+  (void) model;
+  if (!hook->fired && hook->point == point)
+    {
+      g_assert_true (g_file_set_contents (hook->canonical_path,
+                                          hook->canonical_contents,
+                                          -1,
+                                          NULL));
+      hook->fired = TRUE;
+    }
+}
