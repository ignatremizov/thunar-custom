+      request->previous_order_id = g_strdup (order_ids[row_index - 1]);
+    }
+  if (row_index + 1 < (gint) n_rows)
+    {
+      request->next_group = groups[row_index + 1];
+      request->next_order_id = g_strdup (order_ids[row_index + 1]);
