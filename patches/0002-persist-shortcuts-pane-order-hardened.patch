+static GFile *
+thunar_window_existing_bookmark_ancestor (GFile *bookmark_file)
+{
+  GFile *ancestor;
+
+  ancestor = g_file_get_parent (bookmark_file);
+  while (ancestor != NULL && !g_file_query_exists (ancestor, NULL))
+    {
+      GFile *parent = g_file_get_parent (ancestor);
+
+      g_object_unref (ancestor);
+      ancestor = parent;
+    }
+
+  return ancestor;
+}
+
+
+
+static void
+thunar_window_update_bookmark_target_monitor (ThunarWindow *window,
+                                              gboolean      legacy)
+{
+  GFile         *bookmark_file;
+  GFile        **target_file;
+  GFileMonitor **target_monitor;
+  GFileInfo     *info;
+  GFile         *new_target = NULL;
+  const gchar   *target_uri;
+  gchar         *bookmark_path = NULL;
+  gchar         *link_path = NULL;
+  GFile         *parent = NULL;
+  GError        *error = NULL;
+
+  bookmark_file = legacy ? window->legacy_bookmark_file : window->bookmark_file;
+  target_file = legacy
+                  ? &window->legacy_bookmark_target_file
+                  : &window->bookmark_target_file;
+  target_monitor = legacy
+                     ? &window->legacy_bookmark_target_monitor
+                     : &window->bookmark_target_monitor;
+
+  info = g_file_query_info (
+    bookmark_file,
+    G_FILE_ATTRIBUTE_STANDARD_IS_SYMLINK ","
+    G_FILE_ATTRIBUTE_STANDARD_TARGET_URI,
+    G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS,
+    NULL,
+    &error);
+  if (info == NULL)
+    {
+      g_clear_error (&error);
+      goto clear_target;
+    }
+  if (!g_file_info_get_is_symlink (info))
+    {
+      g_object_unref (info);
+      goto clear_target;
+    }
+  target_uri = g_file_info_get_attribute_string (
+    info,
+    G_FILE_ATTRIBUTE_STANDARD_TARGET_URI);
+  if (target_uri == NULL)
+    {
+      bookmark_path = g_file_get_path (bookmark_file);
+      link_path = bookmark_path != NULL
+                    ? g_file_read_link (bookmark_path, &error)
+                    : NULL;
+      if (link_path == NULL)
+        {
+          g_clear_error (&error);
+          g_free (bookmark_path);
+          g_object_unref (info);
+          goto clear_target;
+        }
+      if (g_path_is_absolute (link_path))
+        new_target = g_file_new_for_path (link_path);
+      else
+        {
+          parent = g_file_get_parent (bookmark_file);
+          new_target = parent != NULL
+                         ? g_file_resolve_relative_path (parent, link_path)
+                         : NULL;
+        }
+      g_clear_object (&parent);
+      g_free (link_path);
+      g_free (bookmark_path);
+      g_object_unref (info);
+      info = NULL;
+    }
+  else
+    new_target = g_file_new_for_uri (target_uri);
+  g_clear_object (&info);
+  if (new_target == NULL)
+    goto clear_target;
+
+  if (g_file_equal (new_target, bookmark_file)
+      || !g_file_query_exists (new_target, NULL))
+    {
+      g_clear_object (&new_target);
+      goto clear_target;
+    }
+  if (*target_monitor != NULL
+      && *target_file != NULL
+      && g_file_equal (*target_file, new_target))
+    {
+      g_object_unref (new_target);
+      return;
+    }
+  if (*target_monitor != NULL)
+    {
+      g_file_monitor_cancel (*target_monitor);
+      g_clear_object (target_monitor);
+    }
+  g_set_object (target_file, new_target);
+  *target_monitor = g_file_monitor_file (
+    new_target,
+    G_FILE_MONITOR_NONE,
+    NULL,
+    &error);
+  if (*target_monitor == NULL)
+    {
+      g_warning ("Failed to monitor GTK bookmarks symlink target: %s",
+                 error != NULL ? error->message : "unknown monitor error");
+      g_clear_error (&error);
+      g_clear_object (target_file);
+      g_clear_object (&new_target);
+      return;
+    }
+  g_signal_connect_object (
+    *target_monitor,
+    "changed",
+    G_CALLBACK (thunar_window_bookmarks_changed),
+    window,
+    0);
+  g_clear_object (&new_target);
+  return;
+
+clear_target:
+  if (*target_monitor != NULL)
+    {
+      g_file_monitor_cancel (*target_monitor);
+      g_clear_object (target_monitor);
+    }
+  g_clear_object (target_file);
+}
+
+
+
+static void
+thunar_window_schedule_bookmark_monitor_retry (ThunarWindow *window)
+{
+  guint delay;
+
+  if (window->bookmark_monitor_retry_id != 0)
+    return;
+  delay = 100U << MIN (window->bookmark_monitor_retry_attempt, 5U);
+  delay = MIN (delay, 5000U);
+  if (window->bookmark_monitor_retry_attempt < 5)
+    ++window->bookmark_monitor_retry_attempt;
+  window->bookmark_monitor_retry_id =
+    g_timeout_add_full (G_PRIORITY_DEFAULT,
+                        delay,
+                        thunar_window_retry_bookmark_monitors,
+                        window,
+                        NULL);
+}
+
+
+
+static gboolean
+thunar_window_retry_bookmark_monitors (gpointer user_data)
+{
+  ThunarWindow *window = THUNAR_WINDOW (user_data);
+
