+
+static gint
+hold_order_lock (const gchar *filename)
+{
+  g_autofree gchar *lock_dir = g_build_filename (
+    g_get_user_cache_dir (), "Thunar", NULL);
+  g_autofree gchar *lock_path = g_build_filename (lock_dir, filename, NULL);
+  gint               lock_fd;
+
+  g_assert_cmpint (g_mkdir_with_parents (lock_dir, 0700), ==, 0);
+  lock_fd = g_open (lock_path, O_CREAT | O_RDWR, 0600);
+  g_assert_cmpint (lock_fd, >=, 0);
+  g_assert_cmpint (flock (lock_fd, LOCK_EX | LOCK_NB), ==, 0);
+  return lock_fd;
+}
+
+
+
+static gboolean
+contention_heartbeat (gpointer user_data)
+{
+  guint *heartbeats = user_data;
+
+  ++*heartbeats;
+  return G_SOURCE_CONTINUE;
+}
+
+
+
+typedef struct
+{
+  ThunarDevice *const *devices;
+  guint                n_devices;
+  guint                calls;
+  gint                *lock_fd;
+  gboolean             lock_on_next_call;
+} DeviceListSnapshot;
+
+
+
+static GList *
+device_list_snapshot_hook (ThunarShortcutsModel *model,
+                           gpointer              user_data)
+{
+  DeviceListSnapshot *snapshot = user_data;
+  GList              *devices = NULL;
+
+  (void) model;
+
+  if (snapshot->lock_on_next_call)
+    {
+      g_assert_nonnull (snapshot->lock_fd);
+      g_assert_cmpint (*snapshot->lock_fd, ==, -1);
+      snapshot->lock_on_next_call = FALSE;
+      *snapshot->lock_fd = hold_order_lock ("devices-order-write.lock");
+    }
+
+  ++snapshot->calls;
+  for (guint n = 0; n < snapshot->n_devices; ++n)
+    devices = g_list_prepend (devices,
+                              g_object_ref (snapshot->devices[n]));
+  return g_list_reverse (devices);
+}
+
+
+
+static void
+device_order_write_count_hook (
+  ThunarShortcutsModel                          *model,
+  ThunarShortcutsModelDeviceOrderWriteHookPoint  point,
+  gpointer                                       user_data)
+{
+  guint *writes = user_data;
+
+  (void) model;
+
+  if (point == THUNAR_SHORTCUTS_MODEL_DEVICE_ORDER_WRITE_COMPLETE)
+    ++*writes;
+}
