+static gboolean
+device_hidden (GtkTreeModel *model,
+               ThunarDevice *device)
+{
+  g_autoptr (GtkTreePath) path = device_path (model, device);
+  GtkTreeIter             iter;
+  gboolean                visible = TRUE;
+
+  g_assert_nonnull (path);
+  g_assert_true (gtk_tree_model_get_iter (model, &iter, path));
+  gtk_tree_model_get (model,
+                      &iter,
+                      THUNAR_SHORTCUTS_MODEL_COLUMN_VISIBLE, &visible,
+                      -1);
+  return !visible;
+}
