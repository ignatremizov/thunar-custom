+static void
+test_device_order_id_ownership (void)
+{
+  const gchar *persisted[] = {
+    "device:b",
+    NULL,
+  };
+  const gchar *active_b[] = {
+    "device:b",
+    NULL,
+  };
+  const gchar *active_prior_a[] = {
+    "device:a",
+    NULL,
+  };
+  const gchar *persisted_a[] = {
+    "device:a",
+    NULL,
+  };
+  const gchar *duplicate_persisted[] = {
+    "device:b",
+    "device:b",
+    NULL,
+  };
+
+  /*
+   * A newly constructed unmounted row has no identity yet, so it claims one
+   * retained UUID slot and becomes draggable.  A second active owner keeps
+   * the UUID ambiguous.
+   */
+  g_assert_true (thunar_shortcuts_model_device_order_id_available_for_rows (
+    persisted,
+    NULL,
+    NULL,
+    NULL,
+    NULL,
+    "device:b"));
+  g_assert_false (thunar_shortcuts_model_device_order_id_available_for_rows (
+    persisted,
+    active_b,
+    NULL,
+    NULL,
+    NULL,
+    "device:b"));
+
+  /* A row changing A -> retained B keeps A as an active prior claim.  A new
+   * identity-less row must not reclaim that retained A identity. */
+  g_assert_false (thunar_shortcuts_model_device_order_id_available_for_rows (
+    persisted_a,
+    active_prior_a,
+    NULL,
+    NULL,
+    NULL,
+    "device:a"));
+
+  /* A device changing from A to retained B reserves its former A slot and
+   * must not steal B's retained slot. */
+  g_assert_false (thunar_shortcuts_model_device_order_id_available_for_rows (
+    persisted,
+    NULL,
+    "device:a",
+    NULL,
+    NULL,
+    "device:b"));
+  g_assert_false (thunar_shortcuts_model_device_order_id_available_for_rows (
+    persisted,
+    NULL,
+    "device:a",
+    "device:a",
+    NULL,
+    "device:b"));
+
+  /* Even malformed duplicate persistence grants only one retained slot. */
+  g_assert_false (thunar_shortcuts_model_device_order_id_available_for_rows (
+    duplicate_persisted,
+    NULL,
+    NULL,
+    NULL,
+    NULL,
+    "device:b"));
+}
