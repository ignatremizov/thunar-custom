+gchar *
+thunar_shortcuts_model_build_device_order_id (const gchar *uuid,
+                                              const gchar *stable_identity)
+{
+  gchar *digest;
+  gchar *order_id;
+
+  if (uuid != NULL && *uuid != '\0')
+    return g_strconcat ("device:", uuid, NULL);
+  if (stable_identity == NULL || *stable_identity == '\0')
+    return NULL;
+
+  digest = g_compute_checksum_for_string (G_CHECKSUM_SHA256,
+                                          stable_identity,
+                                          -1);
+  order_id = g_strconcat ("device:fallback-v1:", digest, NULL);
+  g_free (digest);
+  return order_id;
+}
+
+
+
+static gchar *
+thunar_shortcuts_model_get_device_order_id (ThunarDevice *device)
+{
+  gchar *uuid;
+  gchar *stable_identity;
+  gchar *order_id;
+
+  _thunar_return_val_if_fail (THUNAR_IS_DEVICE (device), NULL);
+
+  uuid = thunar_device_get_identifier_uuid (device);
+  stable_identity = thunar_device_get_stable_order_identity (device);
+  order_id = thunar_shortcuts_model_build_device_order_id (
+    uuid,
+    stable_identity);
+  g_free (stable_identity);
+  g_free (uuid);
+  return order_id;
+}
