+static gboolean
+hide_devices (GtkTreeModel *model,
+              GtkTreeIter  *iter,
+              gpointer      user_data)
+{
+  ThunarShortcutGroup group;
+
+  (void) user_data;
+
+  gtk_tree_model_get (model,
+                      iter,
+                      THUNAR_SHORTCUTS_MODEL_COLUMN_GROUP, &group,
+                      -1);
+  return (group & THUNAR_SHORTCUT_GROUP_DEVICES) == 0;
+}
