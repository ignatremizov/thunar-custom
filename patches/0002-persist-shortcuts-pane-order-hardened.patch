+static void
+test_model_dangling_alias_and_symlink_target_monitor (void)
+{
+  g_autofree gchar *legacy_path =
+    g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  g_autofree gchar *target_path =
+    g_build_filename (test_root, "canonical-target", NULL);
+  g_autofree gchar *dangling_target =
+    g_build_filename (test_root, "missing-canonical-target", NULL);
+  ThunarShortcutsModel *model;
+  GtkTreePath          *path;
+
+  g_remove (bookmarks_path);
+  g_remove (legacy_path);
+  g_remove (target_path);
+  write_bookmark_file (legacy_path, "file:///legacy-dangling-fallback\n");
+  g_assert_cmpint (symlink (dangling_target, bookmarks_path), ==, 0);
+
+  /*
+   * Metadata for a dangling symlink can be queried successfully without
+   * following it.  Source-state validation must nevertheless classify it as
+   * absent, matching the loader's open-and-fallback behavior.
+   */
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  path = find_bookmark_path (
+    GTK_TREE_MODEL (model),
+    "file:///legacy-dangling-fallback");
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+
+  g_remove (bookmarks_path);
+  g_remove (legacy_path);
+  write_bookmark_file (target_path, "file:///symlink-target-before\n");
+  g_assert_cmpint (symlink (target_path, bookmarks_path), ==, 0);
+  g_clear_object (&model);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  path = find_bookmark_path (
+    GTK_TREE_MODEL (model),
+    "file:///symlink-target-before");
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+
+  /*
+   * The canonical pathname is an alias, so an edit of its resolved target
+   * has no useful alias-path event on some GIO backends.  The model's target
+   * monitor must still reload the effective canonical source.
+   */
+  write_bookmark_file (target_path, "file:///symlink-target-after\n");
+  iterate_main_context_for (500);
+  path = find_bookmark_path (
+    GTK_TREE_MODEL (model),
+    "file:///symlink-target-after");
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+
+  g_clear_object (&model);
+  g_remove (bookmarks_path);
+  g_remove (legacy_path);
+  g_remove (target_path);
+}
