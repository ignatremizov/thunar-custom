+
+
+static void
+test_model_guarded_bookmark_source_races (void)
+{
+  g_autofree gchar *legacy_path =
+    g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  g_autofree gchar *local_path =
+    g_build_filename (test_root, "guarded-local", NULL);
+  g_autoptr (GFile) local_file = NULL;
+  g_autofree gchar *local_uri = NULL;
+  g_autofree gchar *local_order_id = NULL;
+  ThunarShortcutsModel *model = NULL;
+  BookmarkRaceHook hook = {
+    bookmarks_path,
+    "file:///external-pre\n",
+    THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PRE_VALIDATION,
+    FALSE,
+  };
+  gchar *contents;
+  gint   warning_start;
+  gint   write_warning_total_start;
+  gint   cancellation_total_start;
+
+  write_warning_total_start =
+    g_atomic_int_get (&expected_write_failure_warning_count);
+  cancellation_total_start =
+    g_atomic_int_get (&expected_xfconf_cancellation_warning_count);
+  /*
+   * The write-failure epochs below can deliver their exact cancellation
+   * diagnostic after the initiating call returns.  Keep one scoped
+   * expectation over those epochs and drain it before leaving this test.
+   */
+  expect_xfconf_cancellation_warnings = TRUE;
+  g_assert_cmpint (g_mkdir_with_parents (local_path, 0700), ==, 0);
+  local_file = g_file_new_for_path (local_path);
+  local_uri = g_file_get_uri (local_file);
+  local_order_id = g_strdup_printf ("bookmark:%s", local_uri);
+
+  g_remove (bookmarks_path);
+  write_bookmark_file (legacy_path, "file:///legacy-before\n");
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  warning_start = g_atomic_int_get (&expected_write_failure_warning_count);
+  expect_write_failure_warnings = TRUE;
+  thunar_shortcuts_model_set_bookmark_write_test_hook (
+    bookmark_race_hook,
+    &hook);
+  thunar_shortcuts_model_add (model, NULL, local_file);
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  iterate_main_context_for (100);
+  expect_write_failure_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   >=,
+                   1);
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   <=,
+                   3);
+  g_assert_true (hook.fired);
+  g_assert_true (g_file_get_contents (legacy_path, &contents, NULL, NULL));
+  g_assert_cmpstr (contents, ==, "file:///legacy-before\n");
+  g_free (contents);
+  contents = NULL;
+  g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+  g_assert_cmpstr (contents, ==, "file:///external-pre\n");
+  g_free (contents);
+  g_clear_object (&model);
+
+  hook.canonical_contents = "file:///external-post\n";
+  hook.point = THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PUBLICATION;
+  hook.fired = FALSE;
+  g_remove (bookmarks_path);
+  write_bookmark_file (legacy_path, "file:///legacy-after\n");
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  warning_start = g_atomic_int_get (&expected_write_failure_warning_count);
+  expect_write_failure_warnings = TRUE;
+  thunar_shortcuts_model_set_bookmark_write_test_hook (
+    bookmark_race_hook,
+    &hook);
+  thunar_shortcuts_model_add (model, NULL, local_file);
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  iterate_main_context_for (1000);
+  expect_write_failure_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   >=,
+                   1);
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   <=,
+                   3);
+  g_assert_true (hook.fired);
+  g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+  g_assert_cmpstr (contents, ==, "file:///external-post\n");
+  g_free (contents);
+
+  {
+    ThunarPreferences *preferences = thunar_preferences_get ();
+    gchar **places_order = NULL;
+    gchar **pending_order = NULL;
+
+    g_object_get (preferences,
+                  "shortcuts-places-order", &places_order,
+                  "shortcuts-places-order-pending", &pending_order,
+                  NULL);
+    for (guint n = 0; places_order != NULL && places_order[n] != NULL; ++n)
+      g_assert_cmpstr (places_order[n], !=, local_order_id);
+    g_strfreev (places_order);
+    g_assert_null (pending_order);
+    g_strfreev (pending_order);
+    g_object_unref (preferences);
+  }
+  g_clear_object (&model);
+
+  /*
+   * Once canonical is authoritative, a change to the shadowed legacy path
+   * cannot change source selection.  Keep that path behind a symlink as well
+   * to exercise the same-file/alias case without rejecting the canonical
+   * publication.
+   */
+  {
+    g_autofree gchar *legacy_alias_target =
+      g_build_filename (test_root, "legacy-alias-target", NULL);
+
+    g_remove (bookmarks_path);
+    g_remove (legacy_path);
+    write_bookmark_file (bookmarks_path, "file:///canonical-authoritative\n");
+    write_bookmark_file (legacy_alias_target, "file:///legacy-before-alias\n");
+    g_assert_cmpint (symlink (legacy_alias_target, legacy_path), ==, 0);
+    model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context_for (200);
+    hook.canonical_path = legacy_path;
+    hook.canonical_contents = "file:///legacy-after-alias\n";
+    hook.point = THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PRE_VALIDATION;
+    hook.fired = FALSE;
+    thunar_shortcuts_model_set_bookmark_write_test_hook (
+      bookmark_race_hook,
+      &hook);
+    thunar_shortcuts_model_add (model, NULL, local_file);
+    thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+    g_assert_true (hook.fired);
+    g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+    g_assert_nonnull (strstr (contents, local_uri));
+    g_free (contents);
+    contents = NULL;
+    g_assert_true (g_file_get_contents (legacy_path, &contents, NULL, NULL));
+    g_assert_cmpstr (contents, ==, "file:///legacy-after-alias\n");
+    g_free (contents);
+    g_clear_object (&model);
+    g_remove (bookmarks_path);
+    g_remove (legacy_path);
+    g_remove (legacy_alias_target);
+  }
+
+  /*
+   * With neither source present at prepare, an external legacy writer may
+   * appear immediately after canonical publication.  The post-publication
+   * two-path check must reject the local write/reconcile without touching the
+   * external legacy contents.
+   */
+  g_remove (bookmarks_path);
+  g_remove (legacy_path);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  hook.canonical_path = legacy_path;
+  hook.canonical_contents = "file:///legacy-appeared-during-publication\n";
+  hook.point = THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PUBLICATION;
+  hook.fired = FALSE;
+  warning_start = g_atomic_int_get (&expected_write_failure_warning_count);
+  expect_write_failure_warnings = TRUE;
+  thunar_shortcuts_model_set_bookmark_write_test_hook (
+    bookmark_race_hook,
+    &hook);
+  thunar_shortcuts_model_add (model, NULL, local_file);
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  iterate_main_context_for (1000);
+  expect_write_failure_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   >=,
+                   1);
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   <=,
+                   3);
+  g_assert_true (hook.fired);
+  g_assert_true (g_file_get_contents (legacy_path, &contents, NULL, NULL));
+  g_assert_cmpstr (contents, ==,
+                   "file:///legacy-appeared-during-publication\n");
+  g_free (contents);
+  /*
+   * No unsafe rollback is possible here: deleting the canonical pathname
+   * after an ETag check could remove a newer uncooperative writer's file.
+   * Canonical precedence therefore remains deterministic.  Both writers'
+   * bytes survive; the local canonical publication is effective and the
+   * newly-created legacy file remains a preserved, shadowed fallback.
+   */
+  g_assert_true (g_file_test (bookmarks_path, G_FILE_TEST_EXISTS));
+  g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+  g_assert_nonnull (strstr (contents, local_uri));
+  g_free (contents);
+  contents = NULL;
+  {
+    GtkTreePath       *effective_local_path;
+    ThunarPreferences *preferences;
+    gchar            **places_order = NULL;
+    gchar            **pending_order = NULL;
+
+    effective_local_path = find_bookmark_path (
+      GTK_TREE_MODEL (model),
+      local_uri);
+    g_assert_nonnull (effective_local_path);
+    gtk_tree_path_free (effective_local_path);
+
+    preferences = thunar_preferences_get ();
+    g_object_get (preferences,
+                  "shortcuts-places-order", &places_order,
+                  "shortcuts-places-order-pending", &pending_order,
+                  NULL);
+    g_assert_nonnull (places_order);
+    {
+      gboolean found_local = FALSE;
+
+      for (guint n = 0; places_order[n] != NULL; ++n)
+        found_local |= g_strcmp0 (places_order[n], local_order_id) == 0;
+      g_assert_true (found_local);
+    }
+    g_assert_null (pending_order);
+    g_strfreev (places_order);
+    g_strfreev (pending_order);
+    g_object_unref (preferences);
+  }
+  g_clear_object (&model);
+
+  /*
+   * A failed journal begin happens before GTK publication.  It must not leave
+   * a local transaction behind that makes every later mutation look like an
+   * ambiguous recovery.  Inject the pending-property write failure, then
+   * prove the next mutation succeeds once the fault is removed.
+   */
+  g_remove (bookmarks_path);
+  write_bookmark_file (legacy_path, "file:///legacy-begin-failure\n");
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  warning_start = g_atomic_int_get (&expected_write_failure_warning_count);
+  expect_write_failure_warnings = TRUE;
+  expect_pending_read_warnings = TRUE;
+  thunar_preferences_set_pending_order_test_write_failure (TRUE);
+  thunar_shortcuts_model_add (model, NULL, local_file);
+  iterate_main_context_for (100);
+  thunar_preferences_set_pending_order_test_write_failure (FALSE);
+  expect_write_failure_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   >=,
+                   1);
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - warning_start,
+                   <=,
+                   3);
+  expect_pending_read_warnings = FALSE;
+
+  g_assert_true (g_file_get_contents (legacy_path, &contents, NULL, NULL));
+  g_assert_cmpstr (contents, ==, "file:///legacy-begin-failure\n");
+  g_free (contents);
+  contents = NULL;
+
+  thunar_shortcuts_model_add (model, NULL, local_file);
+  g_assert_true (g_file_get_contents (legacy_path, &contents, NULL, NULL));
+  g_assert_nonnull (strstr (contents, local_uri));
+  g_free (contents);
+  contents = NULL;
+  g_clear_object (&model);
+
+  /*
+   * A NULL pending getter is ambiguous.  Keep the durable and in-memory
+   * intent through the failed recovery, then prove a later readable retry
+   * recovers and clears it.
+   */
+  warning_start = g_atomic_int_get (&expected_pending_read_warning_count);
+  expect_pending_read_warnings = TRUE;
+  write_bookmark_file (legacy_path, "file:///legacy-pending\n");
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  thunar_shortcuts_model_set_bookmark_write_test_hook (
+    pending_read_failure_hook,
+    NULL);
+  thunar_shortcuts_model_add (model, NULL, local_file);
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  iterate_main_context_for (100);
+  thunar_preferences_set_pending_order_test_read_failure (FALSE);
+  expect_pending_read_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_pending_read_warning_count)
+                   - warning_start,
+                   >=,
+                   1);
+  g_assert_cmpint (g_atomic_int_get (&expected_pending_read_warning_count)
+                   - warning_start,
+                   <=,
+                   2);
+
+  {
+    ThunarPreferences *preferences = thunar_preferences_get ();
+    gchar **pending_order = NULL;
+
+    g_object_get (preferences,
+                  "shortcuts-places-order-pending", &pending_order,
+                  NULL);
+    g_assert_nonnull (pending_order);
+    g_strfreev (pending_order);
+    g_object_unref (preferences);
+  }
+
+  thunar_shortcuts_model_reload (model);
+  iterate_main_context_for (300);
+  {
+    ThunarPreferences *preferences = thunar_preferences_get ();
+    gchar **pending_order = NULL;
+
+    g_object_get (preferences,
+                  "shortcuts-places-order-pending", &pending_order,
+                  NULL);
+    g_assert_null (pending_order);
+    g_object_unref (preferences);
+  }
+  g_clear_object (&model);
+  iterate_main_context_for (300);
+  g_remove (bookmarks_path);
+  g_remove (legacy_path);
+  iterate_main_context_for (1000);
+  expect_xfconf_cancellation_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_xfconf_cancellation_warning_count)
+                   - cancellation_total_start,
+                   <=,
+                   4);
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - write_warning_total_start,
+                   >=,
+                   4);
+  g_assert_cmpint (g_atomic_int_get (&expected_write_failure_warning_count)
+                   - write_warning_total_start,
+                   <=,
+                   12);
+}
