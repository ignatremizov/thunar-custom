+static void
+thunar_shortcuts_model_collect_bookmark (GFile       *file_path,
+                                         const gchar *name,
+                                         gint         row_num,
+                                         gpointer     user_data)
+{
+  GPtrArray              *entries = user_data;
+  ThunarShortcutBookmark *bookmark;
+
+  _thunar_return_if_fail (G_IS_FILE (file_path));
+  _thunar_return_if_fail (entries != NULL);
+
+  bookmark = g_new0 (ThunarShortcutBookmark, 1);
+  bookmark->file = g_object_ref (file_path);
+  bookmark->name = g_strdup (name);
+  bookmark->row_num = row_num;
+  bookmark->order_id = thunar_shortcuts_model_get_bookmark_order_id (file_path);
+  g_ptr_array_add (entries, bookmark);
+}
