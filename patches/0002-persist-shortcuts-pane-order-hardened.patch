+static gchar *
+thunar_shortcuts_model_get_device_order_owner_id (ThunarDevice *device)
+{
+  gchar *digest;
+  gchar *stable_identity;
+  gchar *owner_id;
+
+  stable_identity = thunar_device_get_stable_order_identity (device);
+  if (stable_identity == NULL)
+    return NULL;
+
+  digest = g_compute_checksum_for_string (G_CHECKSUM_SHA256,
+                                          stable_identity,
+                                          -1);
+  owner_id = g_strconcat ("device-owner-v1:", digest, NULL);
+  g_free (digest);
+  g_free (stable_identity);
+  return owner_id;
+}
