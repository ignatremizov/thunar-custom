+static gchar *
+log_field_dup (const GLogField *fields,
+               gsize            n_fields,
+               const gchar     *key)
+{
+  gsize n;
+
+  for (n = 0; n < n_fields; ++n)
+    {
+      if (g_strcmp0 (fields[n].key, key) != 0 || fields[n].value == NULL)
+        continue;
+
+      if (fields[n].length < 0)
+        return g_strdup (fields[n].value);
+      return g_strndup (fields[n].value, fields[n].length);
+    }
+
+  return NULL;
+}
