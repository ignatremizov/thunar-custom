+    NULL,
+    NULL,
+    NULL));
+  thunar_shortcuts_model_clear_move_request (&hidden_request);
+
+  /* A span containing only unique identities is valid and its resulting
+   * full-model vector survives the Places merge/recovery boundary unchanged. */
+  g_assert_true (thunar_shortcuts_model_move_destination_for_rows (
+    round_trip_groups,
+    round_trip_ids,
+    NULL,
+    G_N_ELEMENTS (round_trip_groups),
+    3,
+    1,
+    &effective_destination));
+  g_assert_cmpint (effective_destination, ==, 1);
+  apply_row_move (round_trip_groups,
+                  round_trip_ids,
+                  3,
+                  effective_destination);
+  for (guint n = 0; n < G_N_ELEMENTS (round_trip_expected); ++n)
+    g_assert_cmpstr (round_trip_ids[n], ==, round_trip_expected[n]);
+
+  resolved = thunar_shortcuts_model_recover_places_order (
+    round_trip_ids + 1,
+    NULL,
+    round_trip_bookmarks,
+    NULL);
+  assert_strv (resolved, round_trip_order_expected);
+  g_strfreev (resolved);
+}
