+
+static void
+test_gtk_only_places_contract (void)
+{
+  g_autofree gchar *uri_a = make_uri ("a");
+  g_autofree gchar *uri_b = make_uri ("b");
+  g_autofree gchar *uri_c = make_uri ("c");
+  g_autofree gchar *uri_d = make_uri ("d");
+  g_autofree gchar *uri_edge_before = make_uri ("edge-before");
+  g_autofree gchar *uri_edge_after = make_uri ("edge-after");
+  g_autoptr (GFile) file_c = g_file_new_for_uri (uri_c);
+  g_autoptr (GFile) file_d = g_file_new_for_uri (uri_d);
+  g_autoptr (GFile) file_edge_before = g_file_new_for_uri (uri_edge_before);
+  g_autoptr (GFile) file_edge_after = g_file_new_for_uri (uri_edge_after);
+  g_autoptr (ThunarPreferences) preferences = NULL;
+  ThunarShortcutsModel *model;
+  GtkTreePath         *path_a = NULL;
+  GtkTreePath         *path_b = NULL;
+  GtkTreePath         *path_c = NULL;
+  GtkTreePath         *path_builtin = NULL;
+  GtkTreePath         *path_devices_header = NULL;
+  GtkTreePath         *path_devices_item = NULL;
+  GtkTreePath         *path_edge_before = NULL;
+  g_autofree gchar *contents = NULL;
+  g_autofree gchar *initial = NULL;
+  gchar *expected;
+
+  initial = g_strdup_printf ("%s A\n%s B\n", uri_a, uri_b);
+  write_bookmarks (initial);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context ();
+
+  preferences = thunar_preferences_get ();
+  g_assert_false (thunar_preferences_xfconf_available (preferences));
+
+  /* A NULL destination is the GTK append operation. */
+  thunar_shortcuts_model_add (model, NULL, file_c);
+  iterate_main_context ();
+  contents = read_bookmarks ();
+  expected = g_strdup_printf ("%s A\n%s B\n%s\n", uri_a, uri_b, uri_c);
+  g_assert_cmpstr (contents, ==, expected);
+  g_free (expected);
+  g_clear_pointer (&contents, g_free);
+
+  /* Rename is a GTK-only presentation mutation. */
+  g_clear_pointer (&path_a, gtk_tree_path_free);
+  path_a = find_bookmark_path (GTK_TREE_MODEL (model), uri_a);
+  g_assert_nonnull (path_a);
+  {
+    GtkTreeIter iter;
+
+    g_assert_true (gtk_tree_model_get_iter (GTK_TREE_MODEL (model), &iter, path_a));
+    thunar_shortcuts_model_rename (model, &iter, "Alpha");
+  }
+  contents = read_bookmarks ();
+  expected = g_strdup_printf ("%s Alpha\n%s B\n%s\n", uri_a, uri_b, uri_c);
+  g_assert_cmpstr (contents, ==, expected);
+  g_free (expected);
+  g_clear_pointer (&contents, g_free);
+
+  /* A pure relative bookmark reorder is durable without the integrated order. */
+  g_clear_pointer (&path_b, gtk_tree_path_free);
+  g_clear_pointer (&path_a, gtk_tree_path_free);
+  path_b = find_bookmark_path (GTK_TREE_MODEL (model), uri_b);
+  path_a = find_bookmark_path (GTK_TREE_MODEL (model), uri_a);
+  g_assert_nonnull (path_a);
+  g_assert_nonnull (path_b);
+  g_assert_true (thunar_shortcuts_model_move (model, path_b, path_a, NULL));
+  contents = read_bookmarks ();
+  expected = g_strdup_printf ("%s B\n%s Alpha\n%s\n", uri_b, uri_a, uri_c);
+  g_assert_cmpstr (contents, ==, expected);
+  g_free (expected);
+  g_clear_pointer (&contents, g_free);
+
+  /* Reload and then mutate again; sort_id must retain the GTK sequence. */
+  thunar_shortcuts_model_reload (model);
+  iterate_main_context ();
+  thunar_shortcuts_model_add (model, NULL, file_d);
+  iterate_main_context ();
+  contents = read_bookmarks ();
+  expected = g_strdup_printf ("%s B\n%s Alpha\n%s\n%s\n",
+                              uri_b,
+                              uri_a,
+                              uri_c,
+                              uri_d);
+  g_assert_cmpstr (contents, ==, expected);
+  g_free (expected);
+  g_clear_pointer (&contents, g_free);
+
+  /* Explicit adds are durable only inside or at the edges of the block. */
+  g_clear_pointer (&path_c, gtk_tree_path_free);
+  g_clear_pointer (&path_builtin, gtk_tree_path_free);
+  g_clear_pointer (&path_devices_header, gtk_tree_path_free);
+  path_devices_item = find_first_devices_item_path (GTK_TREE_MODEL (model));
+  path_c = find_bookmark_path (GTK_TREE_MODEL (model), uri_c);
+  path_builtin = find_first_places_builtin_path (GTK_TREE_MODEL (model));
+  path_devices_header = find_devices_header_path (GTK_TREE_MODEL (model));
+  g_assert_nonnull (path_c);
+  g_assert_nonnull (path_builtin);
+  g_assert_nonnull (path_devices_header);
+  g_assert_nonnull (path_devices_item);
+  g_assert_true (thunar_shortcuts_model_drop_possible (
+    model, NULL, path_c));
+  g_assert_true (thunar_shortcuts_model_drop_possible (
+    model, NULL, path_devices_header));
+  g_assert_false (thunar_shortcuts_model_drop_possible (
+    model, NULL, path_devices_item));
+  g_assert_false (gtk_tree_drag_source_row_draggable (
+    GTK_TREE_DRAG_SOURCE (model),
+    path_devices_item));
+  {
+    GtkTreePath *device_destination = gtk_tree_path_copy (
+      path_devices_item);
+
+    gtk_tree_path_next (device_destination);
+    g_assert_false (thunar_shortcuts_model_drop_possible (
+      model,
+      path_devices_item,
+      device_destination));
+    g_assert_false (thunar_shortcuts_model_move (
+      model,
+      path_devices_item,
+      device_destination,
+      NULL));
+    gtk_tree_path_free (device_destination);
+  }
+  g_assert_false (thunar_shortcuts_model_drop_possible (
+    model, NULL, path_builtin));
+  thunar_shortcuts_model_add (model, path_c, file_edge_before);
+  g_clear_pointer (&path_devices_header, gtk_tree_path_free);
+  g_clear_pointer (&path_devices_item, gtk_tree_path_free);
+  path_devices_header = find_devices_header_path (GTK_TREE_MODEL (model));
+  g_assert_nonnull (path_devices_header);
+  thunar_shortcuts_model_add (model, path_devices_header, file_edge_after);
+  iterate_main_context ();
+  contents = read_bookmarks ();
+  expected = g_strdup_printf (
+    "%s B\n%s Alpha\n%s\n%s\n%s\n%s\n",
+    uri_b,
+    uri_a,
+    uri_edge_before,
+    uri_c,
+    uri_d,
+    uri_edge_after);
+  g_assert_cmpstr (contents, ==, expected);
+  g_free (expected);
+  g_clear_pointer (&contents, g_free);
+
+  /* Built-in-relative movement is rejected before the model is mutated. */
+  g_clear_pointer (&path_c, gtk_tree_path_free);
+  path_c = find_bookmark_path (GTK_TREE_MODEL (model), uri_c);
+  g_assert_nonnull (path_c);
+  g_assert_false (thunar_shortcuts_model_drop_possible (
+    model, path_c, path_builtin));
+  g_assert_false (thunar_shortcuts_model_move (
+    model, path_c, path_builtin, NULL));
+
+  /* Removal is another GTK-only mutation. */
+  g_clear_pointer (&path_edge_before, gtk_tree_path_free);
+  path_edge_before =
+    find_bookmark_path (GTK_TREE_MODEL (model), uri_edge_before);
+  g_assert_nonnull (path_edge_before);
+  thunar_shortcuts_model_remove (model, path_edge_before);
+  iterate_main_context ();
+  contents = read_bookmarks ();
+  expected = g_strdup_printf (
+    "%s B\n%s Alpha\n%s\n%s\n%s\n",
+    uri_b,
+    uri_a,
+    uri_c,
+    uri_d,
+    uri_edge_after);
+  g_assert_cmpstr (contents, ==, expected);
+  g_assert_null (strstr (contents, uri_edge_before));
+  g_free (expected);
+
+  g_clear_pointer (&path_a, gtk_tree_path_free);
+  g_clear_pointer (&path_b, gtk_tree_path_free);
+  g_clear_pointer (&path_c, gtk_tree_path_free);
+  g_clear_pointer (&path_builtin, gtk_tree_path_free);
+  g_clear_pointer (&path_devices_header, gtk_tree_path_free);
+  g_clear_pointer (&path_edge_before, gtk_tree_path_free);
+  g_object_unref (model);
+}
