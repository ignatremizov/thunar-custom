+static void
+test_hard_link_unavailable_writers_install_once (void)
+{
+#if defined(__linux__) || (defined(__APPLE__) && defined(RENAME_EXCL)) || defined(G_OS_WIN32)
+  run_concurrent_absent_source_writers_install_once (TRUE);
+#else
+  g_test_skip ("platform has no guarded exclusive-rename fallback");
+#endif
