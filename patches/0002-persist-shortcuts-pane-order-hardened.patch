+
+static gboolean
+thunar_shortcuts_model_refresh_order_id (ThunarShortcutsModel *model,
+                                         ThunarShortcut       *shortcut,
+                                         const gchar          *order_id,
+                                         const gchar          *ignored_order_id)
+{
+  gchar **order = NULL;
+  guint   n;
+  gboolean changed = FALSE;
+  gboolean collision;
+  gboolean migrated_prior = FALSE;
+  gboolean preserve_order_position = FALSE;
+  gint     preserved_order_position;
+  gchar   *claim_id = NULL;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+  _thunar_return_val_if_fail (shortcut != NULL, FALSE);
+
+  switch (thunar_shortcuts_model_get_section (shortcut->group))
+    {
+    case THUNAR_SHORTCUT_SECTION_PLACES:
+      order = model->places_order;
+      break;
+
+    case THUNAR_SHORTCUT_SECTION_DEVICES:
+      order = model->devices_order;
+      break;
+
+    default:
+      break;
+    }
+
+  collision = thunar_shortcuts_model_get_section (shortcut->group)
+                == THUNAR_SHORTCUT_SECTION_DEVICES
+              && order_id != NULL
+              && thunar_shortcuts_model_device_order_id_in_use (model,
+                                                                shortcut,
+                                                                order_id,
+                                                                ignored_order_id);
+
+  if (thunar_shortcuts_model_get_section (shortcut->group)
+        == THUNAR_SHORTCUT_SECTION_DEVICES
+      && order_id != NULL)
+    {
+      claim_id = thunar_shortcuts_model_build_device_claim_id (
+        shortcut->device_order_owner_id,
+        order_id);
+
+      /*
+       * Reconstruct an unresolved collision claim before considering whether
+       * the current UUID is available.  The claim is tied to a non-label
+       * secondary identity and therefore survives process restart without
+       * allowing whichever duplicate row is enumerated first to steal it.
+       */
+      if (shortcut->device_prior_order_id == NULL
+          && thunar_shortcuts_model_device_owner_is_unique (
+               model,
+               shortcut,
+               shortcut->device_order_owner_id)
+          && thunar_shortcuts_model_order_has_id (
+               (const gchar *const *) order,
+               claim_id))
+        shortcut->device_prior_order_id = g_strdup (claim_id);
+
+      /*
+       * A secondary-identity collision makes the persisted attribution
+       * ambiguous.  Relinquish it immediately and leave the encoded slot
+       * disconnected; identical ambiguous rows then remain fail-closed both
+       * before and after restart.
+       */
+      if (shortcut->device_prior_order_id != NULL
+          && g_str_has_prefix (shortcut->device_prior_order_id,
+                               DEVICE_ORDER_CLAIM_VERSION)
+          && (!thunar_shortcuts_model_device_owner_is_unique (
+                model,
+                shortcut,
+                shortcut->device_order_owner_id)
+              || g_strcmp0 (shortcut->device_prior_order_id, claim_id) != 0))
+        g_clear_pointer (&shortcut->device_prior_order_id, g_free);
+    }
+
+  if (g_strcmp0 (shortcut->order_id, order_id) == 0
+      && shortcut->device_prior_order_id == NULL)
+    {
+      if (!collision
+          && thunar_shortcuts_model_get_section (shortcut->group)
+               == THUNAR_SHORTCUT_SECTION_DEVICES)
+        thunar_shortcuts_model_set_order_id (model, shortcut, order_id);
+      g_free (claim_id);
+      return FALSE;
+    }
+
+  if (shortcut->device_prior_order_id != NULL
+      && model->loading_devices)
+    {
+      preserve_order_position = TRUE;
+      preserved_order_position = G_MAXINT;
+      if (order != NULL)
+        {
+          for (n = 0; order[n] != NULL; ++n)
+            if (g_strcmp0 (order[n],
+                           shortcut->device_prior_order_id) == 0)
+              {
+                preserved_order_position = n;
+                break;
+              }
+        }
+    }
+
+  /*
+   * Keep a persisted identity at the same position when a URI or device
+   * identifier changes.  The next save also removes any duplicate identity
+   * that may have been introduced by an external bookmark edit.
+   */
+  if (collision)
+    {
+      /*
+       * Preserve the row's former slot while its current identity is
+       * ambiguous.  It is consumed when the collision disappears.
+       */
+      if (shortcut->device_prior_order_id == NULL && shortcut->order_id != NULL)
+        {
+          if (claim_id != NULL
+              && thunar_shortcuts_model_device_owner_is_unique (
+                   model,
+                   shortcut,
+                   shortcut->device_order_owner_id)
+              && thunar_shortcuts_model_replace_order_id (
+                   order,
+                   shortcut->order_id,
+                   claim_id))
+            {
+              shortcut->device_prior_order_id = g_strdup (claim_id);
+              changed = TRUE;
+            }
+          else
+            {
+              /*
+               * There is no restart-stable owner.  Keep the old durable slot
+               * disconnected rather than assigning it process-locally.
+               */
+              shortcut->device_prior_order_id = NULL;
+            }
+        }
+      preserve_order_position = TRUE;
+      preserved_order_position = G_MAXINT;
+      if (shortcut->device_prior_order_id != NULL && order != NULL)
+        {
+          for (n = 0; order[n] != NULL; ++n)
+            if (g_strcmp0 (order[n],
+                           shortcut->device_prior_order_id) == 0)
+              {
+                preserved_order_position = n;
+                break;
+              }
+        }
+      else if (shortcut->device_prior_order_id != NULL)
+        {
+          preserved_order_position = shortcut->order_position;
+        }
+    }
+  else if (thunar_shortcuts_model_get_section (shortcut->group)
+           == THUNAR_SHORTCUT_SECTION_DEVICES
+           && shortcut->device_prior_order_id != NULL
+           && order_id != NULL
+           && !model->loading_devices)
+    {
+      if (order != NULL)
+        {
+          guint prior_position = G_MAXUINT;
+
+          for (n = 0; order[n] != NULL; ++n)
+            {
+              if (g_strcmp0 (order[n], shortcut->device_prior_order_id) == 0)
+                {
+                  prior_position = n;
+                  break;
+                }
+            }
+
+          if (prior_position != G_MAXUINT)
+            {
+              /*
+               * The current ID may still occupy the disappeared peer's
+               * earlier slot.  Remove those stale occurrences first so
+               * replacing the preserved slot cannot be collapsed onto the
+               * peer's position by save_order().
+               */
+              for (n = 0; order[n] != NULL;)
+                {
+                  guint m;
+
+                  if (n == prior_position
+                      || g_strcmp0 (order[n], order_id) != 0)
+                    {
+                      n++;
+                      continue;
+                    }
+
+                  g_free (order[n]);
+                  for (m = n; order[m] != NULL; ++m)
+                    order[m] = order[m + 1];
+                  if (n < prior_position)
+                    prior_position--;
+                  changed = TRUE;
+                }
+
+              g_free (order[prior_position]);
+              order[prior_position] = g_strdup (order_id);
+              changed = TRUE;
+              migrated_prior = TRUE;
+            }
+        }
+
+      g_clear_pointer (&shortcut->device_prior_order_id, g_free);
+    }
+
+  if (order != NULL
+      && shortcut->order_id != NULL
+      && order_id != NULL
+      && !collision
+      && !migrated_prior)
+    {
+      for (n = 0; order[n] != NULL; ++n)
+        {
+          if (g_strcmp0 (order[n], shortcut->order_id) == 0)
+            {
+              g_free (order[n]);
+              order[n] = g_strdup (order_id);
+              changed = TRUE;
+              break;
+            }
+        }
+    }
+
+  thunar_shortcuts_model_set_order_id (model, shortcut, order_id);
+  if (preserve_order_position)
+    shortcut->order_position = preserved_order_position;
+  g_free (claim_id);
+  return changed;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_update_device_shortcut (ThunarShortcutsModel *model,
+                                               ThunarShortcut       *shortcut,
+                                               const gchar           *ignored_order_id)
+{
+  ThunarDeviceKind kind;
+  ThunarShortcutGroup group;
+  gchar *order_id;
+  gchar *owner_id;
+  gboolean order_changed;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+  _thunar_return_val_if_fail (shortcut != NULL, FALSE);
+  _thunar_return_val_if_fail (THUNAR_IS_DEVICE (shortcut->device), FALSE);
+
+  kind = thunar_device_get_kind (shortcut->device);
+  switch (kind)
+    {
+    case THUNAR_DEVICE_KIND_VOLUME:
+      group = THUNAR_SHORTCUT_GROUP_DEVICES_VOLUMES;
+      break;
+
+    case THUNAR_DEVICE_KIND_MOUNT_LOCAL:
+      group = THUNAR_SHORTCUT_GROUP_DEVICES_MOUNTS;
+      break;
+
+    case THUNAR_DEVICE_KIND_MOUNT_REMOTE:
+      group = THUNAR_SHORTCUT_GROUP_NETWORK_MOUNTS;
+      break;
+
+    default:
+      group = THUNAR_SHORTCUT_GROUP_NETWORK_MOUNTS;
+      break;
+    }
+
+  shortcut->group = group;
+  shortcut->hidden = thunar_device_get_hidden (shortcut->device);
+
+  owner_id = (group & THUNAR_SHORTCUT_GROUP_DEVICES) != 0
+               ? thunar_shortcuts_model_get_device_order_owner_id (
+                   shortcut->device)
+               : NULL;
+  g_free (shortcut->device_order_owner_id);
+  shortcut->device_order_owner_id = owner_id;
+
+  order_id = (group & THUNAR_SHORTCUT_GROUP_DEVICES) != 0
+               ? thunar_shortcuts_model_get_device_order_id (shortcut->device)
+               : NULL;
+  order_changed = thunar_shortcuts_model_refresh_order_id (model,
+                                                           shortcut,
+                                                           order_id,
+                                                           ignored_order_id);
+  g_free (order_id);
+
+  return order_changed;
+}
+
+
+
+static void
+thunar_shortcuts_model_update_device_shortcut_without_order (
+  ThunarShortcutsModel *model,
+  ThunarShortcut       *shortcut)
+{
+  gchar **last_good_order;
+
+  /*
+   * Preserve the live device facts when Xfconf is unreadable, but do not let
+   * the update consume, replace, or attribute any slot from the last known
+   * durable vector.  A later successful add/change reconciliation will
+   * reconstruct ownership from the backend.
+   */
+  last_good_order = model->devices_order;
+  model->devices_order = NULL;
+  thunar_shortcuts_model_update_device_shortcut (model, shortcut, NULL);
+  model->devices_order = last_good_order;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_order_contains (GPtrArray   *order,
+                                       const gchar *order_id)
+{
+  guint n;
+
+  for (n = 0; n < order->len; ++n)
+    {
+      if (g_strcmp0 (g_ptr_array_index (order, n), order_id) == 0)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+
+
+gchar **
+thunar_shortcuts_model_merge_device_order (const gchar *const *previous_order,
+                                           const gchar *const *active_order)
+{
+  GPtrArray *active;
+  GPtrArray *merged;
+  guint      active_position = 0;
+  guint      n;
+
+  active = g_ptr_array_new_with_free_func (g_free);
+  if (active_order != NULL)
+    {
+      for (n = 0; active_order[n] != NULL; ++n)
+        {
+          if (!thunar_shortcuts_model_order_contains (active, active_order[n]))
+            g_ptr_array_add (active, g_strdup (active_order[n]));
+        }
+    }
+
+  merged = g_ptr_array_new_with_free_func (g_free);
+  if (previous_order != NULL)
+    {
+      for (n = 0; previous_order[n] != NULL; ++n)
+        {
+          if (thunar_shortcuts_model_order_contains (active, previous_order[n]))
+            {
+              if (active_position < active->len)
+                g_ptr_array_add (merged,
+                                 g_strdup (g_ptr_array_index (active,
+                                                              active_position++)));
+            }
+          else if (!thunar_shortcuts_model_order_contains (merged, previous_order[n]))
+            {
+              g_ptr_array_add (merged, g_strdup (previous_order[n]));
+            }
+        }
+    }
+
+  while (active_position < active->len)
+    g_ptr_array_add (merged,
+                     g_strdup (g_ptr_array_index (active, active_position++)));
+
+  g_ptr_array_add (merged, NULL);
+  g_ptr_array_unref (active);
+  return (gchar **) g_ptr_array_free (merged, FALSE);
+}
+
+
+
+static guint
+thunar_shortcuts_model_strv_length (const gchar *const *strv)
+{
+  guint length = 0;
+
+  if (strv != NULL)
+    while (strv[length] != NULL)
+      ++length;
+
+  return length;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_strv_equal (const gchar *const *strv_a,
+                                   const gchar *const *strv_b)
+{
+  guint length_a;
+  guint length_b;
+  guint n;
+
+  if (strv_a == strv_b)
+    return TRUE;
+
+  length_a = thunar_shortcuts_model_strv_length (strv_a);
+  length_b = thunar_shortcuts_model_strv_length (strv_b);
+  if (length_a != length_b)
+    return FALSE;
+
+  for (n = 0; n < length_a; ++n)
+    if (g_strcmp0 (strv_a[n], strv_b[n]) != 0)
+      return FALSE;
+
+  return TRUE;
+}
+
+
+
+static gchar **
+thunar_shortcuts_model_bookmarks_from_order (const gchar *const *order)
+{
+  GPtrArray *bookmarks;
+  guint      n;
+
+  bookmarks = g_ptr_array_new_with_free_func (g_free);
+  if (order != NULL)
+    {
+      for (n = 0; order[n] != NULL; ++n)
+        {
+          if (g_str_has_prefix (order[n], "bookmark:")
+              && !thunar_shortcuts_model_order_contains (bookmarks, order[n]))
+            g_ptr_array_add (bookmarks, g_strdup (order[n]));
+        }
+    }
+
+  g_ptr_array_add (bookmarks, NULL);
+  return (gchar **) g_ptr_array_free (bookmarks, FALSE);
+}
+
+
+
+static gchar **
+thunar_shortcuts_model_merge_places_order (const gchar *const *places_order,
+                                           const gchar *const *canonical_bookmark_order)
+{
+  GPtrArray *merged;
+  guint      bookmark_position = 0;
+  guint      n;
+
+  merged = g_ptr_array_new_with_free_func (g_free);
+  if (places_order != NULL)
+    {
+      for (n = 0; places_order[n] != NULL; ++n)
+        {
+          if (g_str_has_prefix (places_order[n], "bookmark:"))
+            {
+              if (canonical_bookmark_order != NULL
+                  && canonical_bookmark_order[bookmark_position] != NULL)
+                g_ptr_array_add (
+                  merged,
+                  g_strdup (canonical_bookmark_order[bookmark_position++]));
+            }
+          else
+            {
+              g_ptr_array_add (merged, g_strdup (places_order[n]));
+            }
+        }
+    }
+
+  if (canonical_bookmark_order != NULL)
+    {
+      while (canonical_bookmark_order[bookmark_position] != NULL)
+        g_ptr_array_add (
+          merged,
+          g_strdup (canonical_bookmark_order[bookmark_position++]));
+    }
+
+  g_ptr_array_add (merged, NULL);
+  return (gchar **) g_ptr_array_free (merged, FALSE);
+}
+
+
+
+gchar **
+thunar_shortcuts_model_recover_places_order (const gchar *const        *places_order,
+                                             const gchar *const        *pending_places_order,
+                                             const gchar *const        *canonical_bookmark_order,
+                                             ThunarPlacesOrderRecovery *recovery)
+{
+  const gchar *const *selected_order = places_order;
+  gchar              **pending_bookmark_order = NULL;
+
+  if (recovery != NULL)
+    *recovery = THUNAR_PLACES_ORDER_RECOVERY_NONE;
+
+  if (pending_places_order != NULL)
+    {
+      if (thunar_shortcuts_model_strv_equal (places_order,
+                                             pending_places_order))
+        {
+          if (recovery != NULL)
+            *recovery = THUNAR_PLACES_ORDER_RECOVERY_CLEAR_PENDING;
+        }
+      else
+        {
+          pending_bookmark_order =
+            thunar_shortcuts_model_bookmarks_from_order (pending_places_order);
+          if (thunar_shortcuts_model_strv_equal (
+                (const gchar *const *) pending_bookmark_order,
+                canonical_bookmark_order))
+            {
+              selected_order = pending_places_order;
+              if (recovery != NULL)
+                *recovery = THUNAR_PLACES_ORDER_RECOVERY_PROMOTE_PENDING;
+            }
+          else if (recovery != NULL)
+            {
+              *recovery = THUNAR_PLACES_ORDER_RECOVERY_CLEAR_PENDING;
+            }
+        }
+    }
+
+  g_strfreev (pending_bookmark_order);
+  return thunar_shortcuts_model_merge_places_order (selected_order,
+                                                    canonical_bookmark_order);
+}
+
+
+
+static gchar **
+thunar_shortcuts_model_collect_order (ThunarShortcutsModel *model,
+                                      ThunarShortcutSection section)
+{
+  GPtrArray      *order;
+  GList          *lp;
+  ThunarShortcut *shortcut;
+  gchar         **previous_order;
+  gchar         **new_order;
+  guint           n;
+
+  if (section == THUNAR_SHORTCUT_SECTION_PLACES)
+    previous_order = model->places_order;
+  else if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    previous_order = model->devices_order;
+  else
+    return NULL;
+
+  order = g_ptr_array_new_with_free_func (g_free);
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      shortcut = lp->data;
+      if (thunar_shortcuts_model_get_section (shortcut->group) != section
+          || (shortcut->group & THUNAR_SHORTCUT_GROUP_HEADER) != 0
+          || shortcut->order_id == NULL)
+        continue;
+
+      if (!thunar_shortcuts_model_order_contains (order, shortcut->order_id))
+        {
+          g_ptr_array_add (order, g_strdup (shortcut->order_id));
+        }
+    }
+
+  if (section == THUNAR_SHORTCUT_SECTION_DEVICES && previous_order != NULL)
+    {
+      gchar **active_order;
+      gchar **merged_order;
+
+      g_ptr_array_add (order, NULL);
+      active_order = (gchar **) g_ptr_array_free (order, FALSE);
+      merged_order = thunar_shortcuts_model_merge_device_order (
+        (const gchar *const *) previous_order,
+        (const gchar *const *) active_order);
+      g_strfreev (active_order);
+      order = g_ptr_array_new_with_free_func (g_free);
+      for (n = 0; merged_order[n] != NULL; ++n)
+        g_ptr_array_add (order, g_strdup (merged_order[n]));
+      g_strfreev (merged_order);
+    }
+
+  g_ptr_array_add (order, NULL);
+  new_order = (gchar **) g_ptr_array_free (order, FALSE);
+  return new_order;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_save_order (ThunarShortcutsModel *model,
+                                   ThunarShortcutSection section,
+                                   gboolean              refresh_preferences)
+{
+  gchar **new_order;
+  gboolean stored;
+
+  if (section == THUNAR_SHORTCUT_SECTION_PLACES)
+    {
+      _thunar_return_val_if_fail (model->bookmarks_lock_depth > 0,
+                                  THUNAR_ORDER_STORE_ERROR);
+      if (!thunar_preferences_xfconf_available (model->preferences)
+          || !model->bookmark_source_confirmed)
+        return FALSE;
+    }
+  else if (section != THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      return FALSE;
+    }
+  else
+    {
+      _thunar_return_val_if_fail (model->devices_order_lock_depth > 0,
+                                  FALSE);
+      if (!thunar_preferences_xfconf_available (model->preferences))
+        return FALSE;
+    }
+
+  if (refresh_preferences
+      && !thunar_shortcuts_model_refresh_order (model, section))
+    return FALSE;
+
+  new_order = thunar_shortcuts_model_collect_order (model, section);
+  if (new_order == NULL)
+    return FALSE;
+
+  stored = thunar_shortcuts_model_store_order_verified (
+             model,
+             section,
+             (const gchar *const *) new_order)
+           == THUNAR_ORDER_STORE_COMMITTED;
+  g_strfreev (new_order);
+  if (stored)
+    thunar_shortcuts_model_refresh_order_positions (model, section);
+  else if (section == THUNAR_SHORTCUT_SECTION_PLACES)
+    thunar_shortcuts_model_refresh_order (model, section);
+  return stored;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_refresh_order (ThunarShortcutsModel *model,
+                                      ThunarShortcutSection section)
+{
+  gchar **order = NULL;
+  GError *error = NULL;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+
+  if (section == THUNAR_SHORTCUT_SECTION_PLACES)
+    {
+      g_object_get (G_OBJECT (model->preferences),
+                    "shortcuts-places-order", &order,
+                    NULL);
+      g_strfreev (model->places_order);
+      model->places_order = order;
+      return TRUE;
+    }
+  else if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      if (!thunar_preferences_xfconf_available (model->preferences))
+        return TRUE;
+      if (!thunar_preferences_get_string_list (
+            model->preferences,
+            "/shortcuts-devices-order",
+            &order,
+            &error))
+        {
+          g_warning ("Unable to read the Devices order: %s",
+                     error != NULL ? error->message : "unknown Xfconf error");
+          g_clear_error (&error);
+          return FALSE;
+        }
+      g_strfreev (model->devices_order);
+      model->devices_order = order;
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+
+
+static gchar **
+thunar_shortcuts_model_encode_pending_places_order (const gchar *const *order)
+{
+  gchar **encoded;
+  guint   length;
+  guint   n;
+
+  length = thunar_shortcuts_model_strv_length (order);
+  encoded = g_new0 (gchar *, length + 2);
+  encoded[0] = g_strdup (PLACES_ORDER_PENDING_VERSION);
+  for (n = 0; n < length; ++n)
+    encoded[n + 1] = g_strdup (order[n]);
+
+  return encoded;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_acquire_devices_order_lock (ThunarShortcutsModel *model,
+                                                   gboolean              *busy)
+{
+  GError *error = NULL;
+  gchar  *lock_dir;
+  gchar  *lock_path;
+  gint    open_flags = O_CREAT | O_RDWR;
+  gint    lock_errno;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+
+  if (busy != NULL)
+    *busy = FALSE;
+
+  if (model->devices_order_lock_depth > 0)
+    {
+      _thunar_assert (model->devices_order_lock_fd >= 0);
+      ++model->devices_order_lock_depth;
+      return TRUE;
+    }
+
+#ifdef O_CLOEXEC
+  open_flags |= O_CLOEXEC;
+#endif
+#ifdef O_NOFOLLOW
+  open_flags |= O_NOFOLLOW;
+#endif
+
+  lock_dir = g_build_filename (g_get_user_cache_dir (), "Thunar", NULL);
+  if (g_mkdir_with_parents (lock_dir, 0700) < 0)
+    {
+      lock_errno = errno;
+      g_warning ("Failed to create the Devices-order lock directory: %s",
+                 g_strerror (lock_errno));
+      g_free (lock_dir);
+      return FALSE;
+    }
+
+  lock_path = g_build_filename (lock_dir, "devices-order-write.lock", NULL);
+  model->devices_order_lock_fd = g_open (lock_path, open_flags, 0600);
+  if (model->devices_order_lock_fd < 0)
+    {
+      lock_errno = errno;
+      g_warning ("Failed to open the Devices-order lock \"%s\": %s",
+                 lock_path,
+                 g_strerror (lock_errno));
+      g_free (lock_path);
+      g_free (lock_dir);
+      return FALSE;
+    }
+
+#ifndef O_CLOEXEC
+  {
+    GError *close_error = NULL;
+    gint descriptor_flags;
+
+    descriptor_flags = fcntl (model->devices_order_lock_fd, F_GETFD);
+    if (descriptor_flags >= 0)
+      descriptor_flags = fcntl (model->devices_order_lock_fd,
+                                F_SETFD,
+                                descriptor_flags | FD_CLOEXEC);
+    if (descriptor_flags < 0)
+      {
+        lock_errno = errno;
+        g_warning ("Failed to make the Devices-order lock close-on-exec: %s",
+                   g_strerror (lock_errno));
+        g_close (model->devices_order_lock_fd, &close_error);
+        g_clear_error (&close_error);
+        model->devices_order_lock_fd = -1;
+        g_free (lock_path);
+        g_free (lock_dir);
+        return FALSE;
+      }
+  }
+#endif
+
+  do
+    {
+      lock_errno = flock (model->devices_order_lock_fd, LOCK_EX | LOCK_NB) < 0
+                     ? errno
+                     : 0;
+    }
+  while (lock_errno == EINTR);
+
+  if (lock_errno != 0)
+    {
+      if (lock_errno == EWOULDBLOCK || lock_errno == EAGAIN)
+        {
+          if (busy != NULL)
+            *busy = TRUE;
+          g_debug ("The Devices-order lock \"%s\" is busy",
+                   lock_path);
+        }
+      else
+        {
+          g_warning ("Failed to acquire the Devices-order lock \"%s\": %s",
+                     lock_path,
+                     g_strerror (lock_errno));
+        }
+      g_close (model->devices_order_lock_fd, &error);
+      g_clear_error (&error);
+      model->devices_order_lock_fd = -1;
+      g_free (lock_path);
+      g_free (lock_dir);
+      return FALSE;
+    }
+
+  model->devices_order_lock_depth = 1;
+  g_free (lock_path);
+  g_free (lock_dir);
+  return TRUE;
+}
+
+
+
+static void
+thunar_shortcuts_model_release_devices_order_lock (ThunarShortcutsModel *model)
+{
+  GError *error = NULL;
+
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+  _thunar_return_if_fail (model->devices_order_lock_depth > 0);
+  _thunar_return_if_fail (model->devices_order_lock_fd >= 0);
+
+  --model->devices_order_lock_depth;
+  if (model->devices_order_lock_depth > 0)
+    return;
+
+  if (!g_close (model->devices_order_lock_fd, &error))
+    {
+      g_warning ("Failed to close the Devices-order lock: %s",
+                 error->message);
+      g_clear_error (&error);
+    }
+  model->devices_order_lock_fd = -1;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_retry_devices_reconcile (gpointer user_data);
+
+
+
+static void
+thunar_shortcuts_model_schedule_devices_reconcile_retry (
+  ThunarShortcutsModel *model)
+{
+  guint delay;
+
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+  _thunar_return_if_fail (model->devices_reconcile_retry_id == 0);
+  _thunar_return_if_fail (
+    model->devices_reconcile_retry_attempt
+    < DEVICES_RECONCILE_RETRY_MAX_ATTEMPTS);
+
+  delay = DEVICES_RECONCILE_RETRY_INITIAL_DELAY
+          << model->devices_reconcile_retry_attempt;
+  delay = MIN (delay, DEVICES_RECONCILE_RETRY_MAX_DELAY);
+  ++model->devices_reconcile_retry_attempt;
+  model->devices_reconcile_retry_id =
+    g_timeout_add_full (G_PRIORITY_DEFAULT,
+                        delay,
+                        thunar_shortcuts_model_retry_devices_reconcile,
+                        model,
+                        NULL);
+}
+
+
+
+static void
+thunar_shortcuts_model_request_devices_reconcile (
+  ThunarShortcutsModel *model)
+{
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+
+  model->devices_reconcile_pending = TRUE;
+  if (model->devices_reconcile_retry_id != 0
+      || model->devices_reconcile_running)
+    return;
+
+  /*
+   * One retry cycle is finite.  A later independent lifecycle/property
+   * notification starts a fresh cycle so a recovered backend can converge.
+   */
+  if (model->devices_reconcile_retry_attempt
+      >= DEVICES_RECONCILE_RETRY_MAX_ATTEMPTS)
+    model->devices_reconcile_retry_attempt = 0;
+  thunar_shortcuts_model_schedule_devices_reconcile_retry (model);
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_retry_devices_reconcile (gpointer user_data)
+{
+  ThunarShortcutsModel *model = THUNAR_SHORTCUTS_MODEL (user_data);
+  gboolean              reconciled;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model),
+                              G_SOURCE_REMOVE);
+
+  model->devices_reconcile_retry_id = 0;
+  model->devices_reconcile_pending = FALSE;
+  model->devices_reconcile_running = TRUE;
+  reconciled = thunar_shortcuts_model_reconcile_devices_from_source (model);
+  model->devices_reconcile_running = FALSE;
+
+  if (reconciled && !model->devices_reconcile_pending)
+    model->devices_reconcile_retry_attempt = 0;
+  else
+    model->devices_reconcile_pending = TRUE;
+
+  if (!model->devices_reconcile_pending)
+    return G_SOURCE_REMOVE;
+
+  if (model->devices_reconcile_retry_attempt
+      >= DEVICES_RECONCILE_RETRY_MAX_ATTEMPTS)
+    {
+      g_warning ("Unable to reconcile Devices after %u attempts; "
+                 "waiting for a later device or order change",
+                 DEVICES_RECONCILE_RETRY_MAX_ATTEMPTS);
+      return G_SOURCE_REMOVE;
+    }
+
+  thunar_shortcuts_model_schedule_devices_reconcile_retry (model);
+  return G_SOURCE_REMOVE;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_acquire_bookmarks_lock (ThunarShortcutsModel *model)
+{
+  return thunar_shortcuts_model_acquire_bookmarks_lock_with_busy (model, NULL);
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_acquire_bookmarks_lock_with_busy (
+  ThunarShortcutsModel *model,
+  gboolean              *busy)
+{
+  GError *error = NULL;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+
+  if (busy != NULL)
+    *busy = FALSE;
+
+  if (model->bookmarks_lock_depth > 0)
+    {
+      _thunar_assert (model->bookmarks_lock_fd >= 0);
+      ++model->bookmarks_lock_depth;
+      return TRUE;
+    }
+
+  _thunar_assert (model->bookmarks_lock_fd < 0);
+  model->bookmarks_lock_fd = thunar_util_acquire_bookmarks_lock (&error);
+  if (model->bookmarks_lock_fd < 0)
+    {
+      if (error != NULL
+          && g_error_matches (error, G_IO_ERROR, G_IO_ERROR_WOULD_BLOCK))
+        {
+          if (busy != NULL)
+            *busy = TRUE;
+          g_debug ("The GTK bookmarks lock is busy");
+        }
+      else
+        {
+          g_warning ("Failed to serialize GTK bookmarks persistence: %s",
+                     error != NULL ? error->message : "unknown lock error");
+        }
+      g_clear_error (&error);
+      return FALSE;
+    }
+
+  model->bookmarks_lock_depth = 1;
+  return TRUE;
+}
+
+
+
+static void
+thunar_shortcuts_model_release_bookmarks_lock (ThunarShortcutsModel *model)
+{
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+  _thunar_return_if_fail (model->bookmarks_lock_depth > 0);
+  _thunar_return_if_fail (model->bookmarks_lock_fd >= 0);
+
+  --model->bookmarks_lock_depth;
+  if (model->bookmarks_lock_depth == 0)
+    {
+      thunar_util_release_bookmarks_lock (model->bookmarks_lock_fd);
+      model->bookmarks_lock_fd = -1;
+    }
+}
+
+
+
+static ThunarOrderStoreResult
+thunar_shortcuts_model_store_order_verified (ThunarShortcutsModel *model,
+                                             ThunarShortcutSection section,
+                                             const gchar *const   *order)
+{
+  gchar       ***cached_order;
+  const gchar  *property_name;
+  gchar       **stored_order = NULL;
+  gboolean      verified;
+  GError       *error = NULL;
+
+  if (section == THUNAR_SHORTCUT_SECTION_PLACES)
+    {
+      _thunar_return_val_if_fail (model->bookmarks_lock_depth > 0, FALSE);
+      if (!thunar_preferences_xfconf_available (model->preferences))
+        return THUNAR_ORDER_STORE_ERROR;
+      cached_order = &model->places_order;
+      property_name = "shortcuts-places-order";
+    }
+  else if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      _thunar_return_val_if_fail (model->devices_order_lock_depth > 0,
+                                  THUNAR_ORDER_STORE_ERROR);
+      if (!thunar_preferences_xfconf_available (model->preferences))
+        return THUNAR_ORDER_STORE_ERROR;
+      cached_order = &model->devices_order;
+      property_name = "shortcuts-devices-order";
+    }
+  else
+    {
+      return THUNAR_ORDER_STORE_ERROR;
+    }
+
+  model->saving_order = TRUE;
+  if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      if (g_test_initialized () && device_order_write_test_hook != NULL)
+        device_order_write_test_hook (
+          model,
+          THUNAR_SHORTCUTS_MODEL_DEVICE_ORDER_WRITE_PREPARE,
+          device_order_write_test_hook_data);
+      if (!thunar_preferences_set_string_list (
+            model->preferences,
+            "/shortcuts-devices-order",
+            order,
+            &error))
+        {
+          g_warning ("Unable to write the Devices order: %s",
+                     error != NULL ? error->message : "unknown Xfconf error");
+          g_clear_error (&error);
+          model->saving_order = FALSE;
+          return THUNAR_ORDER_STORE_ERROR;
+        }
+      if (g_test_initialized () && device_order_write_test_hook != NULL)
+        device_order_write_test_hook (
+          model,
+          THUNAR_SHORTCUTS_MODEL_DEVICE_ORDER_WRITE_COMPLETE,
+          device_order_write_test_hook_data);
+      if (!thunar_preferences_get_string_list (
+            model->preferences,
+            "/shortcuts-devices-order",
+            &stored_order,
+            &error))
+        {
+          g_warning ("Unable to verify the Devices order: %s",
+                     error != NULL ? error->message : "unknown Xfconf error");
+          g_clear_error (&error);
+          model->saving_order = FALSE;
+          return THUNAR_ORDER_STORE_ERROR;
+        }
+    }
+  else
+    {
+      g_object_set (G_OBJECT (model->preferences),
+                    property_name, order,
+                    NULL);
+      g_object_get (G_OBJECT (model->preferences),
+                    property_name, &stored_order,
+                    NULL);
+    }
+  model->saving_order = FALSE;
+
+  verified = thunar_shortcuts_model_strv_equal (
+    order,
+    (const gchar *const *) stored_order);
+  if (verified)
+    {
+      g_strfreev (*cached_order);
+      *cached_order = stored_order;
+      stored_order = NULL;
+    }
+  else if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      /*
+       * A successful read of a different value is a compare conflict, not a
+       * transport failure.  Adopt that latest durable vector so the caller
+       * can rebase the stable request and retry without losing the winner.
+       */
+      g_strfreev (*cached_order);
+      *cached_order = stored_order;
+      stored_order = NULL;
+    }
+
+  g_strfreev (stored_order);
+  return verified
+           ? THUNAR_ORDER_STORE_COMMITTED
+           : THUNAR_ORDER_STORE_CONFLICT;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_clear_pending_places_order (ThunarShortcutsModel *model,
+                                                   const gchar *const   *expected_encoded_order)
+{
+  gchar   **stored_order = NULL;
+  gboolean cleared;
+  GError   *error = NULL;
+
+  _thunar_return_val_if_fail (model->bookmarks_lock_depth > 0, FALSE);
+
+  if (!thunar_preferences_get_string_list (
+        model->preferences,
+        "/shortcuts-places-order-pending",
+        &stored_order,
+        &error))
+    {
+      g_clear_error (&error);
+      return FALSE;
+    }
+  if (expected_encoded_order != NULL
+      && !thunar_shortcuts_model_strv_equal (
+        expected_encoded_order,
+        (const gchar *const *) stored_order))
+    {
+      g_strfreev (stored_order);
+      return FALSE;
+    }
+  g_strfreev (stored_order);
+  stored_order = NULL;
+
+  g_object_set (G_OBJECT (model->preferences),
+                "shortcuts-places-order-pending", NULL,
+                NULL);
+  if (!thunar_preferences_get_string_list (
+        model->preferences,
+        "/shortcuts-places-order-pending",
+        &stored_order,
+        &error))
+    {
+      g_clear_error (&error);
+      return FALSE;
+    }
+  cleared = stored_order == NULL;
+  g_strfreev (stored_order);
+  return cleared;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_begin_places_order_transaction (ThunarShortcutsModel *model)
+{
+  gchar   **encoded_order;
+  gchar   **stored_order = NULL;
+  gboolean verified;
+
+  _thunar_return_val_if_fail (model->bookmarks_lock_depth > 0, FALSE);
+  _thunar_return_val_if_fail (model->places_order_transaction == NULL, FALSE);
+
+  thunar_shortcuts_model_refresh_order (model, THUNAR_SHORTCUT_SECTION_PLACES);
+  model->places_order_transaction =
+    thunar_shortcuts_model_collect_order (model, THUNAR_SHORTCUT_SECTION_PLACES);
+  encoded_order = thunar_shortcuts_model_encode_pending_places_order (
+    (const gchar *const *) model->places_order_transaction);
+
+  g_object_set (G_OBJECT (model->preferences),
+                "shortcuts-places-order-pending", encoded_order,
+                NULL);
+  g_object_get (G_OBJECT (model->preferences),
+                "shortcuts-places-order-pending", &stored_order,
+                NULL);
+  verified = thunar_shortcuts_model_strv_equal (
+    (const gchar *const *) encoded_order,
+    (const gchar *const *) stored_order);
+  if (!verified)
+    {
+      g_warning ("Failed to persist the pending integrated Places order");
+      if (!thunar_shortcuts_model_clear_pending_places_order (
+            model,
+            (const gchar *const *) encoded_order))
+        g_warning ("Failed to clear the unverified pending integrated Places order");
+      /*
+       * The GTK file has not been touched yet.  This is a failed journal
+       * begin, not an ambiguous post-publication intent; discard the local
+       * copy even when the best-effort durable clear could not be verified.
+       */
+      g_clear_pointer (&model->places_order_transaction, g_strfreev);
+    }
+
+  g_strfreev (encoded_order);
+  g_strfreev (stored_order);
+  return verified;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_commit_places_order_transaction (ThunarShortcutsModel *model)
+{
+  gchar **encoded_order;
+  gboolean committed;
+
+  _thunar_return_val_if_fail (model->bookmarks_lock_depth > 0, FALSE);
+  _thunar_return_val_if_fail (model->places_order_transaction != NULL, FALSE);
+
+  encoded_order = thunar_shortcuts_model_encode_pending_places_order (
+    (const gchar *const *) model->places_order_transaction);
+  committed = thunar_shortcuts_model_store_order_verified (
+                model,
+                THUNAR_SHORTCUT_SECTION_PLACES,
+                (const gchar *const *) model->places_order_transaction)
+              == THUNAR_ORDER_STORE_COMMITTED;
+  if (!committed)
+    {
+      /*
+       * GTK is already committed.  Keep the verified pending vector for the
+       * next reconciliation, and use it as the current in-process order.
+       */
+      g_warning ("Failed to commit the integrated Places order; recovery remains pending");
+      g_strfreev (model->places_order);
+      model->places_order = g_strdupv (model->places_order_transaction);
+    }
+  else if (!thunar_shortcuts_model_clear_pending_places_order (
+             model,
+             (const gchar *const *) encoded_order))
+    {
+      /*
+       * A crash here is harmless because main already equals pending.  Do not
+       * clear an unexpected vector which could belong to a newer mutation.
+       */
+      g_warning ("Failed to clear the committed pending integrated Places order");
+      committed = FALSE;
+    }
+
+  thunar_shortcuts_model_refresh_order_positions (
+    model,
+    THUNAR_SHORTCUT_SECTION_PLACES);
+  if (committed)
+    g_clear_pointer (&model->places_order_transaction, g_strfreev);
+  g_strfreev (encoded_order);
+  return committed;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_recover_places_order_transaction (ThunarShortcutsModel *model,
+                                                         GPtrArray             *bookmark_order)
+{
+  gchar                     **canonical_order;
+  gchar                     **encoded_order = NULL;
+  gchar                     **main_order = NULL;
+  gchar                     **pending_order;
+  gchar                     **recovered_order;
+  gboolean                    success;
+  guint                       n;
+
+  _thunar_return_val_if_fail (model->bookmarks_lock_depth > 0, FALSE);
+  if (!thunar_preferences_xfconf_available (model->preferences))
+    return TRUE;
+
+  {
+    GError *property_error = NULL;
+
+    /*
+     * The ordinary GObject getter intentionally preserves Thunar's default
+     * preference semantics, where a failed Xfconf read looks like NULL.
+     * Recovery is stricter: only this error-bearing operation can discharge
+     * a durable journal.
+     */
+    if (!thunar_preferences_get_string_list (
+          model->preferences,
+          "/shortcuts-places-order-pending",
+          &encoded_order,
+          &property_error))
+      {
+        g_warning ("Unable to read the pending integrated Places order: %s",
+                   property_error != NULL
+                     ? property_error->message
+                     : "unknown read error");
+        g_clear_error (&property_error);
+        return FALSE;
+      }
+  }
+  if (encoded_order == NULL)
+    {
+      /*
+       * NULL is safe here only because the error-bearing getter above already
+       * confirmed that the durable pending property is absent.  In-memory
+       * state still controls whether the main order must be refreshed and
+       * reconciled before it can be discharged.
+       */
+      if (model->places_order_transaction != NULL)
+        {
+          GError                         *property_error = NULL;
+          gchar                          **discharged_order;
+          gchar                          **refreshed_order = NULL;
+
+          /*
+           * A peer may have recovered and cleared the durable journal while
+           * this model still holds its old in-memory copy. Confirm the
+           * pending property's absence with an error-bearing channel lookup;
+           * a failed lookup must retain the local intent.
+           */
+          if (!thunar_preferences_get_string_list (
+                model->preferences,
+                "/shortcuts-places-order",
+                &refreshed_order,
+                &property_error))
+            {
+              g_warning ("Unable to read the main integrated Places order");
+              g_clear_error (&property_error);
+              return FALSE;
+            }
+          g_strfreev (model->places_order);
+          model->places_order = refreshed_order;
+          refreshed_order = NULL;
+
+          canonical_order = g_new0 (gchar *, bookmark_order->len + 1);
+          for (n = 0; n < bookmark_order->len; ++n)
+            canonical_order[n] =
+              g_strdup (g_ptr_array_index (bookmark_order, n));
+          discharged_order = thunar_shortcuts_model_recover_places_order (
+            (const gchar *const *) model->places_order,
+            NULL,
+            (const gchar *const *) canonical_order,
+            NULL);
+
+          /*
+           * The success-bearing presence check above proves that a peer
+           * cleared the durable intent.  Its main order may legitimately
+           * differ from this model's stale cached vector, so adopt the
+           * refreshed main/canonical merge before discharging the local
+           * copy instead of treating that normal peer update as a conflict.
+           */
+          g_strfreev (model->places_order);
+          model->places_order = discharged_order;
+          discharged_order = NULL;
+          g_clear_pointer (&model->places_order_transaction, g_strfreev);
+          g_strfreev (discharged_order);
+          g_strfreev (canonical_order);
+        }
+      return TRUE;
+    }
+
+  if (g_strcmp0 (encoded_order[0], PLACES_ORDER_PENDING_VERSION) != 0)
+    {
+      g_warning ("Discarding an unrecognized pending integrated Places order");
+      if (!thunar_shortcuts_model_clear_pending_places_order (
+            model,
+            (const gchar *const *) encoded_order))
+        {
+          g_warning ("Failed to clear the unrecognized pending integrated Places order");
+          g_strfreev (encoded_order);
+          return FALSE;
+        }
+      g_clear_pointer (&model->places_order_transaction, g_strfreev);
+      g_strfreev (encoded_order);
+      return TRUE;
+    }
+
+  canonical_order = g_new0 (gchar *, bookmark_order->len + 1);
+  for (n = 0; n < bookmark_order->len; ++n)
+    canonical_order[n] = g_strdup (g_ptr_array_index (bookmark_order, n));
+  pending_order = g_strdupv (encoded_order + 1);
+
+  /*
+   * Main order is part of the recovery input.  Do not use the ordinary
+   * property getter here: its NULL result cannot distinguish a failed read
+   * from an absent/default property, and recovery must retain the journal on
+   * either transport or malformed-value failure.
+   */
+  {
+    GError *property_error = NULL;
+
+    if (!thunar_preferences_get_string_list (
+          model->preferences,
+          "/shortcuts-places-order",
+          &main_order,
+          &property_error))
+      {
+        g_warning ("Unable to read the main integrated Places order: %s",
+                   property_error != NULL
+                     ? property_error->message
+                     : "unknown read error");
+        g_clear_error (&property_error);
+        g_strfreev (canonical_order);
+        g_strfreev (encoded_order);
+        g_strfreev (pending_order);
+        return FALSE;
+      }
+  }
+  g_strfreev (model->places_order);
+  model->places_order = main_order;
+  main_order = NULL;
+  recovered_order = thunar_shortcuts_model_recover_places_order (
+    (const gchar *const *) model->places_order,
+    (const gchar *const *) pending_order,
+    (const gchar *const *) canonical_order,
+    NULL);
+
+  success = thunar_shortcuts_model_store_order_verified (
+              model,
+              THUNAR_SHORTCUT_SECTION_PLACES,
+              (const gchar *const *) recovered_order)
+            == THUNAR_ORDER_STORE_COMMITTED;
+  if (!success)
+    {
+      g_warning ("Failed to recover the integrated Places order; pending intent was retained");
+    }
+  else if (!thunar_shortcuts_model_clear_pending_places_order (
+             model,
+             (const gchar *const *) encoded_order))
+    {
+      g_warning ("Failed to clear the recovered pending integrated Places order");
+      success = FALSE;
+    }
+  else
+    {
+      g_clear_pointer (&model->places_order_transaction, g_strfreev);
+    }
+
+  g_strfreev (canonical_order);
+  g_strfreev (encoded_order);
+  g_strfreev (main_order);
+  g_strfreev (pending_order);
+  g_strfreev (recovered_order);
+  return success;
+}
+
+
+
+static void
+thunar_shortcuts_model_refresh_order_positions (ThunarShortcutsModel *model,
+                                                ThunarShortcutSection section)
+{
+  GList *lp;
+
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *shortcut = lp->data;
+      gchar          *order_id;
+
+      if (thunar_shortcuts_model_get_section (shortcut->group) != section
+          || shortcut->order_id == NULL)
+        continue;
+
+      if (section == THUNAR_SHORTCUT_SECTION_DEVICES
+          && shortcut->device_prior_order_id != NULL)
+        {
+          shortcut->order_position = G_MAXINT;
+          if (model->devices_order != NULL)
+            {
+              for (guint n = 0; model->devices_order[n] != NULL; ++n)
+                {
+                  if (g_strcmp0 (model->devices_order[n],
+                                 shortcut->device_prior_order_id) == 0)
+                    {
+                      shortcut->order_position = n;
+                      break;
+                    }
+                }
+            }
+        }
+      else
+        {
+          order_id = g_strdup (shortcut->order_id);
+          thunar_shortcuts_model_set_order_id (model, shortcut, order_id);
+          g_free (order_id);
+        }
+    }
+}
+
+
+
+static void
+thunar_shortcuts_model_sort_shortcuts (ThunarShortcutsModel *model)
+{
+  GPtrArray    *old_shortcuts;
+  GList        *lp;
+  GtkTreePath  *path;
+  gboolean      changed = FALSE;
+  gint         *order;
+  gint          n;
+  guint         old_n;
+
+  old_shortcuts = g_ptr_array_new ();
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    g_ptr_array_add (old_shortcuts, lp->data);
+
+  order = g_newa (gint, old_shortcuts->len);
+  model->shortcuts = g_list_sort (model->shortcuts, thunar_shortcuts_model_sort_func);
+  for (lp = model->shortcuts, n = 0; lp != NULL; lp = lp->next, n++)
+    {
+      for (old_n = 0; old_n < old_shortcuts->len; old_n++)
+        if (g_ptr_array_index (old_shortcuts, old_n) == lp->data)
+          break;
+
+      order[n] = old_n;
+      if (order[n] != (gint) n)
+        changed = TRUE;
+    }
+
+  if (changed)
+    {
+      path = gtk_tree_path_new ();
+      gtk_tree_model_rows_reordered (GTK_TREE_MODEL (model), path, NULL, order);
+      gtk_tree_path_free (path);
+    }
+
+  g_ptr_array_free (old_shortcuts, TRUE);
+}
+
+
+
+static void
+thunar_shortcuts_model_order_changed (ThunarPreferences   *preferences,
+                                      GParamSpec          *pspec,
+                                      ThunarShortcutsModel *model)
+{
+  ThunarShortcutSection section;
+  const gchar          *property_name;
+  GPtrArray             *bookmark_order = NULL;
+  gboolean              device_order_changed = FALSE;
+  gboolean              device_visibility_changed = FALSE;
+  gboolean              devices_locked = FALSE;
+  ThunarDeviceOrderingSnapshot *device_snapshot = NULL;
+
+  (void) preferences;
+
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+  if (model->saving_order)
+    return;
+
+  property_name = g_param_spec_get_name (pspec);
+  if (g_strcmp0 (property_name, "shortcuts-places-order") == 0)
+    section = THUNAR_SHORTCUT_SECTION_PLACES;
+  else if (g_strcmp0 (property_name, "shortcuts-devices-order") == 0)
+    section = THUNAR_SHORTCUT_SECTION_DEVICES;
+  else
+    return;
+
+  if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      devices_locked =
+        thunar_shortcuts_model_acquire_devices_order_lock (model, NULL);
+      if (!devices_locked
+          || !thunar_shortcuts_model_refresh_order (model, section))
+        {
+          if (devices_locked)
+            thunar_shortcuts_model_release_devices_order_lock (model);
+          thunar_shortcuts_model_request_devices_reconcile (model);
+          return;
+        }
+      thunar_shortcuts_model_refresh_order_positions (model, section);
+      thunar_shortcuts_model_sort_shortcuts (model);
+      device_snapshot =
+        thunar_shortcuts_model_snapshot_device_ordering (model);
+    }
+
+  /*
+   * Xfconf owns the integrated slots, but GTK owns the relative order of
+   * bookmark rows.  Capture that sequence before applying the live vector.
+   * During reconciliation the completed file snapshot is the authoritative
+   * sequence even while old rows are being replaced.
+   */
+  if (section == THUNAR_SHORTCUT_SECTION_PLACES
+      && model->bookmark_file_entries != NULL)
+    {
+      bookmark_order =
+        thunar_shortcuts_model_get_bookmark_entries_order (model->bookmark_file_entries);
+    }
+  else if (section == THUNAR_SHORTCUT_SECTION_PLACES
+           && model->bookmark_source_confirmed)
+    {
+      bookmark_order = thunar_shortcuts_model_get_bookmark_order (model);
+    }
+  else if (section == THUNAR_SHORTCUT_SECTION_PLACES)
+    {
+      bookmark_order = thunar_shortcuts_model_get_persisted_bookmark_order (model);
+    }
+
+  if (section != THUNAR_SHORTCUT_SECTION_DEVICES)
+    thunar_shortcuts_model_refresh_order (model, section);
+  if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      device_order_changed = thunar_shortcuts_model_reconcile_device_collisions (
+        model,
+        NULL,
+        NULL,
+        NULL,
+        NULL,
+        &device_visibility_changed);
+    }
+  if (bookmark_order != NULL)
+    {
+      thunar_shortcuts_model_merge_bookmark_order (model, bookmark_order);
+      g_ptr_array_unref (bookmark_order);
+    }
+  thunar_shortcuts_model_refresh_order_positions (model, section);
+  thunar_shortcuts_model_sort_shortcuts (model);
+  if (section == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      if (device_order_changed && model->devices_order != NULL)
+        {
+          if (!thunar_shortcuts_model_save_order (
+                model,
+                THUNAR_SHORTCUT_SECTION_DEVICES,
+                FALSE))
+            {
+              gboolean latest_read =
+                thunar_shortcuts_model_refresh_order (
+                  model,
+                  THUNAR_SHORTCUT_SECTION_DEVICES);
+
+              thunar_shortcuts_model_restore_device_ordering (
+                model,
+                device_snapshot,
+                !latest_read);
+              thunar_shortcuts_model_request_devices_reconcile (model);
+            }
+        }
+      if (device_visibility_changed)
+        thunar_shortcuts_model_header_visibility (model);
+      thunar_shortcuts_model_free_device_ordering_snapshot (
+        device_snapshot);
+      thunar_shortcuts_model_release_devices_order_lock (model);
+    }
+}
+
+
+
+static gint
+thunar_shortcuts_model_sort_func (gconstpointer shortcut_a,
+                                  gconstpointer shortcut_b)
+{
+  const ThunarShortcut *a = shortcut_a;
+  const ThunarShortcut *b = shortcut_b;
+  ThunarShortcutSection section_a;
+  ThunarShortcutSection section_b;
+  gboolean              header_a;
+  gboolean              header_b;
+
+  section_a = thunar_shortcuts_model_get_section (a->group);
+  section_b = thunar_shortcuts_model_get_section (b->group);
+  if (section_a != section_b)
+    return section_a - section_b;
+
+  if (section_a == THUNAR_SHORTCUT_SECTION_PLACES
+      || section_a == THUNAR_SHORTCUT_SECTION_DEVICES)
+    {
+      header_a = (a->group & THUNAR_SHORTCUT_GROUP_HEADER) != 0;
+      header_b = (b->group & THUNAR_SHORTCUT_GROUP_HEADER) != 0;
+      if (header_a != header_b)
+        return header_a ? -1 : 1;
+
+      if (!header_a && a->order_position != b->order_position)
+        return a->order_position > b->order_position ? 1 : -1;
+    }
+
+  /* Preserve the default subtype order for entries not yet persisted. */
+  if (a->group != b->group)
+    return a->group - b->group;
+
+  /* use sort order */
+  if (a->sort_id != b->sort_id)
+    return a->sort_id > b->sort_id ? 1 : -1;
+
+  if (a->device != NULL && b->device != NULL)
+    return thunar_device_compare_by_name (a->device, b->device);
+
+  return g_strcmp0 (a->name, b->name);
+}
+
+
+
+static void
+thunar_shortcuts_model_add_shortcut_with_path (ThunarShortcutsModel *model,
+                                               ThunarShortcut       *shortcut,
+                                               GtkTreePath          *path)
+{
+  GtkTreeIter  iter;
+  GtkTreePath *sorted_path = NULL;
+
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+  _thunar_return_if_fail (shortcut->file == NULL || THUNAR_IS_FILE (shortcut->file));
+
+  if (G_LIKELY (shortcut->file != NULL))
+    {
+      /* enable monitoring for the file */
+      thunar_file_watch (shortcut->file);
+
+      /* subscribe to relevant signals */
+      shortcut->file_destroy_id =
+        g_signal_connect (G_OBJECT (shortcut->file), "destroy",
+                          G_CALLBACK (thunar_shortcuts_model_file_destroyed), model);
+      shortcut->file_changed_id =
+        g_signal_connect (G_OBJECT (shortcut->file), "changed",
+                          G_CALLBACK (thunar_shortcuts_model_file_changed), model);
+    }
+
+  if (path == NULL)
+    {
+      /* insert the new shortcut to the shortcuts list */
+      model->shortcuts = g_list_insert_sorted (model->shortcuts, shortcut, thunar_shortcuts_model_sort_func);
+      sorted_path = gtk_tree_path_new_from_indices (g_list_index (model->shortcuts, shortcut), -1);
+      path = sorted_path;
+    }
+  else
+    {
+      model->shortcuts = g_list_insert (model->shortcuts, shortcut, gtk_tree_path_get_indices (path)[0]);
+    }
+
+  /* tell everybody that we have a new shortcut */
+  gtk_tree_model_get_iter (GTK_TREE_MODEL (model), &iter, path);
+  gtk_tree_model_row_inserted (GTK_TREE_MODEL (model), path, &iter);
+
+  if (sorted_path)
+    gtk_tree_path_free (sorted_path);
+}
+
+
+
+static void
+thunar_shortcuts_model_add_shortcut (ThunarShortcutsModel *model,
+                                     ThunarShortcut       *shortcut)
+{
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+  _thunar_return_if_fail (shortcut->file == NULL || THUNAR_IS_FILE (shortcut->file));
+
+  thunar_shortcuts_model_add_shortcut_with_path (model, shortcut, NULL);
+}
+
+
+
+static void
+thunar_shortcuts_model_remove_shortcut (ThunarShortcut       *shortcut,
+                                        ThunarShortcutsModel *model)
+{
+  GtkTreePath *path;
+  gint         idx;
+
+  /* determine the index of the shortcut */
+  idx = g_list_index (model->shortcuts, shortcut);
+  if (G_LIKELY (idx >= 0))
+    {
+      /* unlink the shortcut from the model */
+      model->shortcuts = g_list_remove (model->shortcuts, shortcut);
+
+      /* tell everybody that we have lost a shortcut */
+      path = gtk_tree_path_new_from_indices (idx, -1);
+      gtk_tree_model_row_deleted (GTK_TREE_MODEL (model), path);
+      gtk_tree_path_free (path);
+
+      /* actually free the shortcut */
+      thunar_shortcut_free (shortcut, model);
+
+      /* update header visibility */
+      thunar_shortcuts_model_header_visibility (model);
+    }
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_local_file (GFile *gfile)
+{
+  _thunar_return_val_if_fail (G_IS_FILE (gfile), FALSE);
+
+  /* schemes we'd like to have as ThunarFiles in the model */
+  if (g_file_has_uri_scheme (gfile, "file")
+      || g_file_has_uri_scheme (gfile, "computer")
+      || g_file_has_uri_scheme (gfile, "recent"))
+    return TRUE;
+
+  return FALSE;
+}
