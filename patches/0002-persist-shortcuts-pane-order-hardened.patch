+static void
+test_model_peer_recovers_pending_transaction (void)
+{
+  g_autofree gchar *first_path =
+    g_build_filename (test_root, "peer-first", NULL);
+  g_autofree gchar *second_path =
+    g_build_filename (test_root, "peer-second", NULL);
+  g_autoptr (GFile) first_file = NULL;
+  g_autoptr (GFile) second_file = NULL;
+  g_autofree gchar *first_uri = NULL;
+  g_autofree gchar *second_uri = NULL;
+  ThunarShortcutsModel *model_a = NULL;
+  ThunarPreferences *preferences;
+  gchar *contents = NULL;
+  gchar **pending_order = NULL;
+  gchar **before_peer_order = NULL;
+  gchar **peer_order = NULL;
+  gchar **final_order = NULL;
+  gchar  *first_order_id;
+  gchar  *second_order_id;
+  gint    warning_start;
+  gint    cancellation_warning_start;
+
+  cancellation_warning_start =
+    g_atomic_int_get (&expected_xfconf_cancellation_warning_count);
+  expect_xfconf_cancellation_warnings = TRUE;
+  g_assert_cmpint (g_mkdir_with_parents (first_path, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (second_path, 0700), ==, 0);
+  first_file = g_file_new_for_path (first_path);
+  second_file = g_file_new_for_path (second_path);
+  first_uri = g_file_get_uri (first_file);
+  second_uri = g_file_get_uri (second_file);
+
+  g_remove (bookmarks_path);
+  write_bookmark_file (bookmarks_path, "file:///peer-initial\n");
+  preferences = thunar_preferences_get ();
+  g_object_set (preferences,
+                "shortcuts-places-order-pending", NULL,
+                NULL);
+  g_object_get (preferences,
+                "shortcuts-places-order", &before_peer_order,
+                NULL);
+  g_object_unref (preferences);
+
+  /*
+   * Model A publishes GTK successfully, but its pending-clear read is
+   * ambiguous.  It must retain the in-memory transaction until a peer can
+   * recover the durable journal.
+   */
+  model_a = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  warning_start = g_atomic_int_get (&expected_pending_read_warning_count);
+  expect_pending_read_warnings = TRUE;
+  thunar_shortcuts_model_set_bookmark_write_test_hook (
+    pending_read_failure_hook,
+    NULL);
+  thunar_shortcuts_model_add (model_a, NULL, first_file);
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  iterate_main_context_for (100);
+  thunar_preferences_set_pending_order_test_read_failure (FALSE);
+
+  preferences = thunar_preferences_get ();
+  g_object_get (preferences,
+                "shortcuts-places-order-pending", &pending_order,
+                NULL);
+  g_assert_nonnull (pending_order);
+  g_strfreev (pending_order);
+  pending_order = NULL;
+  g_object_unref (preferences);
+
+  /*
+   * A NULL pending getter is also used to exercise the error-bearing lookup
+   * directly: this must not be mistaken for a confirmed absence.
+   */
+  thunar_preferences_set_pending_order_test_read_failure (TRUE);
+  preferences = thunar_preferences_get ();
+  {
+    GError *property_error = NULL;
+
+    g_assert_cmpint (
+      thunar_preferences_query_property (
+        preferences,
+        "/shortcuts-places-order-pending",
+        &property_error),
+      ==,
+      THUNAR_PREFERENCES_PROPERTY_ERROR);
+    g_assert_error (property_error, G_IO_ERROR, G_IO_ERROR_FAILED);
+    g_clear_error (&property_error);
+  }
+  g_object_unref (preferences);
+  thunar_preferences_set_pending_order_test_read_failure (FALSE);
+
+  /*
+   * A fresh model has no in-memory transaction, but a failed NULL-like
+   * pending read is still not confirmed absence.  Construction must retain
+   * the durable intent and report the read failure rather than discharging it
+   * merely because its local transaction pointer is NULL.
+   */
+  {
+    ThunarShortcutsModel *fresh_model;
+    gint                  fresh_warning_start;
+
+    fresh_warning_start =
+      g_atomic_int_get (&expected_pending_read_warning_count);
+    thunar_preferences_set_pending_order_test_read_failure (TRUE);
+    fresh_model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context_for (100);
+    thunar_preferences_set_pending_order_test_read_failure (FALSE);
+    g_assert_cmpint (g_atomic_int_get (&expected_pending_read_warning_count)
+                     - fresh_warning_start,
+                     >=,
+                     1);
+    g_assert_cmpint (g_atomic_int_get (&expected_pending_read_warning_count)
+                     - fresh_warning_start,
+                     <=,
+                     2);
+    g_clear_object (&fresh_model);
+  }
+
+  /*
+   * Model B sees the durable intent, recovers it against the current GTK
+   * source, and clears the journal.  A's next operation must treat that
+   * success-bearing absence as dischargeable rather than blocking forever.
+   */
+  g_setenv ("THUNAR_SHORTCUTS_VIEW_SHARED_ROOT", test_root, TRUE);
+  g_test_trap_subprocess (
+    "/shortcuts-view/model-peer-recovery-worker",
+    0,
+    G_TEST_SUBPROCESS_INHERIT_STDOUT | G_TEST_SUBPROCESS_INHERIT_STDERR);
+  g_unsetenv ("THUNAR_SHORTCUTS_VIEW_SHARED_ROOT");
+  g_test_trap_assert_passed ();
+  iterate_main_context_for (300);
+
+  preferences = thunar_preferences_get ();
+  g_object_get (preferences,
+                "shortcuts-places-order", &peer_order,
+                "shortcuts-places-order-pending", &pending_order,
+                NULL);
+  g_assert_null (pending_order);
+  g_assert_nonnull (peer_order);
+  g_assert_false (test_strv_equal (
+    (const gchar *const *) before_peer_order,
+    (const gchar *const *) peer_order));
+  g_strfreev (pending_order);
+  pending_order = NULL;
+  g_object_unref (preferences);
+
+  thunar_shortcuts_model_add (model_a, NULL, second_file);
+  iterate_main_context_for (300);
+  expect_pending_read_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_pending_read_warning_count)
+                   - warning_start,
+                   >=,
+                   1);
+  g_assert_cmpint (g_atomic_int_get (&expected_pending_read_warning_count)
+                   - warning_start,
+                   <=,
+                   4);
+  g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+  g_assert_nonnull (strstr (contents, first_uri));
+  g_assert_nonnull (strstr (contents, second_uri));
+  g_free (contents);
+  preferences = thunar_preferences_get ();
+  g_object_get (preferences,
+                "shortcuts-places-order", &final_order,
+                NULL);
+  first_order_id = g_strdup_printf ("bookmark:%s", first_uri);
+  second_order_id = g_strdup_printf ("bookmark:%s", second_uri);
+  g_assert_true (test_strv_contains (
+    (const gchar *const *) final_order,
+    first_order_id));
+  g_assert_true (test_strv_contains (
+    (const gchar *const *) final_order,
+    second_order_id));
+  g_free (first_order_id);
+  g_free (second_order_id);
+  g_assert_false (test_strv_equal (
+    (const gchar *const *) peer_order,
+    (const gchar *const *) final_order));
+  g_object_unref (preferences);
+  g_strfreev (before_peer_order);
+  g_strfreev (peer_order);
+  g_strfreev (final_order);
+  g_clear_object (&model_a);
+  iterate_main_context_for (300);
+  g_remove (bookmarks_path);
+  iterate_main_context_for (1000);
+  expect_xfconf_cancellation_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_xfconf_cancellation_warning_count)
+                   - cancellation_warning_start,
+                   <=,
+                   1);
+}
