+static gboolean
+thunar_shortcuts_model_capture_insertion (ThunarShortcutsModel     *model,
+                                          gint                      index,
+                                          ThunarShortcutInsertion *insertion)
+{
+  ThunarShortcut *anchor;
+
+  memset (insertion, 0, sizeof (*insertion));
+  if (index == (gint) g_list_length (model->shortcuts))
+    {
+      insertion->insertion_side = THUNAR_SHORTCUT_INSERT_AT_END;
+      return TRUE;
+    }
+
+  anchor = g_list_nth_data (model->shortcuts, index);
+  if (anchor == NULL)
+    return FALSE;
+  if (anchor->group == THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS
+      && !thunar_shortcuts_model_order_id_is_unique (model, anchor))
+    return FALSE;
+
+  insertion->insertion_side = THUNAR_SHORTCUT_INSERT_BEFORE;
+  return thunar_shortcuts_model_capture_identity (model,
+                                                  anchor,
+                                                  &insertion->anchor);
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_resolve_insertion (ThunarShortcutsModel           *model,
+                                          const ThunarShortcutInsertion *insertion,
+                                          gint                           *index)
+{
+  if (insertion->insertion_side == THUNAR_SHORTCUT_INSERT_AT_END)
+    {
+      *index = g_list_length (model->shortcuts);
+      return TRUE;
+    }
+
+  return thunar_shortcuts_model_resolve_identity (model,
+                                                  &insertion->anchor,
+                                                  index)
+         != NULL;
+}
+
+
+
+static void
+thunar_shortcuts_model_clear_insertion (ThunarShortcutInsertion *insertion)
+{
+  thunar_shortcuts_model_clear_identity (&insertion->anchor);
+  memset (insertion, 0, sizeof (*insertion));
+}
