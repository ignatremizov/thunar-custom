+static void
+test_model_peer_recovery_worker (void)
+{
+  g_autofree gchar *first_path =
+    g_build_filename (test_root, "peer-first", NULL);
+  g_autoptr (GFile) first_file = g_file_new_for_path (first_path);
+  g_autofree gchar *first_uri = g_file_get_uri (first_file);
+  g_autofree gchar *first_order_id =
+    g_strdup_printf ("bookmark:%s", first_uri);
+  ThunarShortcutsModel *model;
+  ThunarPreferences    *preferences;
+  GPtrArray            *before_paths;
+  GPtrArray            *after_paths;
+  gchar                **order = NULL;
+  gchar                **expected_order = NULL;
+  guint                  n;
+  guint                  bookmark_index = G_MAXUINT;
+
+  if (!shared_test_environment)
+    {
+      g_test_skip ("worker is only run by the peer recovery parent test");
+      return;
+    }
+
+  peer_cancellation_warning_start =
+    g_atomic_int_get (&expected_xfconf_cancellation_warning_count);
+  expect_xfconf_cancellation_warnings = TRUE;
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (400);
+  before_paths = shortcut_paths (
+    GTK_TREE_MODEL (model),
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    TRUE);
+  g_assert_cmpuint (before_paths->len, ==, 2);
+
+  preferences = thunar_preferences_get ();
+  g_object_get (preferences,
+                "shortcuts-places-order", &order,
+                "shortcuts-places-order-pending", &expected_order,
+                NULL);
+  g_assert_null (expected_order);
+  g_strfreev (expected_order);
+  expected_order = g_strdupv (order);
+  for (n = 0; order != NULL && order[n] != NULL; ++n)
+    if (g_strcmp0 (order[n], first_order_id) == 0)
+      {
+        bookmark_index = n;
+        break;
+      }
+  g_assert_cmpuint (bookmark_index, <, g_strv_length (order));
+  g_assert_cmpuint (bookmark_index, >, 0);
+  g_free (expected_order[bookmark_index]);
+  expected_order[bookmark_index] = expected_order[0];
+  expected_order[0] = g_strdup (first_order_id);
+  g_assert_false (test_strv_equal (
+    (const gchar *const *) order,
+    (const gchar *const *) expected_order));
+  g_object_set (preferences,
+                "shortcuts-places-order", expected_order,
+                NULL);
+  g_strfreev (order);
+  order = NULL;
+  g_object_get (preferences,
+                "shortcuts-places-order", &order,
+                NULL);
+  g_assert_true (test_strv_equal (
+    (const gchar *const *) order,
+    (const gchar *const *) expected_order));
+  g_object_unref (preferences);
+  iterate_main_context_for (300);
+  after_paths = shortcut_paths (
+    GTK_TREE_MODEL (model),
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    TRUE);
+  g_assert_cmpint (gtk_tree_path_compare (g_ptr_array_index (before_paths, 0),
+                                          g_ptr_array_index (after_paths, 0)),
+                   !=,
+                   0);
+  g_ptr_array_unref (before_paths);
+  g_ptr_array_unref (after_paths);
+  g_strfreev (order);
+  g_strfreev (expected_order);
+  g_clear_object (&model);
+}
