+static void
+test_bookmark_publish_limits (void)
+{
+  GString             *contents;
+  ThunarShortcutsModel *model;
+  gchar               *unchanged;
+  gchar               *installed = NULL;
+  gchar               *uri;
+  guint                n;
+
+  /*
+   * Fill the file to the record boundary, then prove the next mutation is
+   * rejected before publication and leaves the last durable snapshot intact.
+   */
+  contents = g_string_new (NULL);
+  for (n = 0; n < THUNAR_UTIL_BOOKMARKS_MAX_RECORDS; ++n)
+    g_string_append_printf (contents,
+                            "https://bookmark-limit-%u.invalid/\n",
+                            n);
+  write_bookmarks (contents->str);
+  unchanged = g_strdup (contents->str);
+  g_string_free (contents, TRUE);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context ();
+  uri = g_strdup ("https://bookmark-limit-overflow.invalid/");
+  {
+    GFile *file = g_file_new_for_uri (uri);
+
+    expect_limit_warning = TRUE;
+    thunar_shortcuts_model_add (model, NULL, file);
+    /*
+     * Thunar 4.18 resolves a newly added file asynchronously before it
+     * serializes the bookmark list. Keep the expectation active until that
+     * native callback path has completed.
+     */
+    iterate_main_context_for (100);
+    expect_limit_warning = FALSE;
+    g_object_unref (file);
+  }
+  g_assert_cmpint (g_atomic_int_get (&expected_limit_warning_count), ==, 1);
+  g_assert_true (g_file_get_contents (bookmarks_path,
+                                      &installed,
+                                      NULL,
+                                      NULL));
+  g_assert_cmpstr (installed, ==, unchanged);
+  g_free (installed);
+  installed = NULL;
+  g_free (unchanged);
+  unchanged = NULL;
+  g_free (uri);
+  g_object_unref (model);
+
+  /*
+   * Independently exercise the byte boundary through rename.  The input is
+   * exactly accepted; the larger requested label must never be installed.
+   */
+  uri = make_uri ("byte-limit");
+  {
+    gsize label_length = THUNAR_UTIL_BOOKMARKS_MAX_BYTES - strlen (uri) - 2;
+    gchar *label = g_malloc (label_length + 1);
+    gchar *oversized_label =
+      g_malloc0 (THUNAR_UTIL_BOOKMARKS_MAX_BYTES + 1);
+    GtkTreePath *path;
+    GtkTreeIter iter;
+
+    memset (label, 'a', label_length);
+    label[label_length] = '\0';
+    g_free (unchanged);
+    unchanged = g_strdup_printf ("%s %s\n", uri, label);
+    g_assert_cmpuint (strlen (unchanged), ==, THUNAR_UTIL_BOOKMARKS_MAX_BYTES);
+    write_bookmarks (unchanged);
+    model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context ();
+    path = find_bookmark_path (GTK_TREE_MODEL (model), uri);
+    g_assert_nonnull (path);
+    g_assert_true (gtk_tree_model_get_iter (
+      GTK_TREE_MODEL (model), &iter, path));
+    memset (oversized_label, 'b', THUNAR_UTIL_BOOKMARKS_MAX_BYTES);
+    expect_limit_warning = TRUE;
+    thunar_shortcuts_model_rename (model, &iter, oversized_label);
+    expect_limit_warning = FALSE;
+    g_assert_cmpint (g_atomic_int_get (&expected_limit_warning_count), ==, 2);
+    g_assert_true (g_file_get_contents (bookmarks_path,
+                                        &installed,
+                                        NULL,
+                                        NULL));
+    g_assert_cmpstr (installed, ==, unchanged);
+    g_free (installed);
+    installed = NULL;
+    gtk_tree_path_free (path);
+    g_free (label);
+    g_free (oversized_label);
+    g_object_unref (model);
+  }
+  g_free (unchanged);
+  g_free (uri);
+}
