+static void
+thunar_shortcuts_model_device_added (ThunarDeviceMonitor  *device_monitor,
+                                     ThunarDevice         *device,
+                                     ThunarShortcutsModel *model)
+{
+  ThunarShortcut            *shortcut;
+  ThunarShortcutFileGetData *data;
+  GFile                     *mount_point;
+  gboolean                   locked = FALSE;
+  GList                     *lp;
+
+  _thunar_return_if_fail (device_monitor == NULL || THUNAR_DEVICE_MONITOR (device_monitor));
+  _thunar_return_if_fail (device_monitor == NULL || model->device_monitor == device_monitor);
+  _thunar_return_if_fail (THUNAR_IS_DEVICE (device));
+  _thunar_return_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model));
+
+  if (device_monitor != NULL
+      && thunar_preferences_xfconf_available (model->preferences))
+    {
+      locked =
+        thunar_shortcuts_model_acquire_devices_order_lock (model, NULL);
+      if (!locked
+          || !thunar_shortcuts_model_refresh_order (
+                model,
+                THUNAR_SHORTCUT_SECTION_DEVICES))
+        {
+          if (locked)
+            thunar_shortcuts_model_release_devices_order_lock (model);
+          thunar_shortcuts_model_request_devices_reconcile (model);
+          return;
+        }
+    }
+
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    if (THUNAR_SHORTCUT (lp->data)->device == device)
+      break;
+  if (lp != NULL
+      || g_hash_table_contains (model->pending_device_adds, device))
+    {
+      if (locked)
+        thunar_shortcuts_model_release_devices_order_lock (model);
+      return;
+    }
+
+  /* allocate a new shortcut */
+  shortcut = thunar_shortcut_new ();
+  shortcut->device = g_object_ref (device);
+  thunar_shortcuts_model_update_device_shortcut_without_order (model,
+                                                               shortcut);
+
+  mount_point = thunar_device_get_root (device);
+  if (mount_point != NULL)
+    {
+      data = g_slice_new0 (ThunarShortcutFileGetData);
+      data->shortcut = shortcut;
+      data->model = g_object_ref (model);
+
+      g_hash_table_add (model->pending_device_adds, device);
+      thunar_file_get_async (mount_point, NULL, &thunar_shortcuts_model_device_added_finish, data);
+    }
+  else /* some devices (e.g. usb flashdrives) do not have a mountpoint */
+    {
+      /* insert in the model */
+      thunar_shortcuts_model_add_shortcut (model, shortcut);
+      thunar_shortcuts_model_finish_device_add_ordering (model, shortcut);
+      thunar_shortcuts_model_header_visibility (model);
+    }
+
+  if (locked)
+    thunar_shortcuts_model_release_devices_order_lock (model);
+}
