+static ThunarDeviceOrderingSnapshot *
+thunar_shortcuts_model_snapshot_device_ordering (ThunarShortcutsModel *model)
+{
+  ThunarDeviceOrderingSnapshot *snapshot;
+  GList                        *lp;
+
+  snapshot = g_new0 (ThunarDeviceOrderingSnapshot, 1);
+  snapshot->order = g_strdupv (model->devices_order);
+  snapshot->entries = g_ptr_array_new_with_free_func (
+    thunar_shortcuts_model_free_device_ordering_entry);
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *shortcut = lp->data;
+
+      if (shortcut->device != NULL
+          && (shortcut->group & THUNAR_SHORTCUT_GROUP_DEVICES) != 0)
+        {
+          ThunarDeviceOrderingEntry *entry;
+
+          entry = g_new0 (ThunarDeviceOrderingEntry, 1);
+          entry->shortcut = shortcut;
+          entry->order_id = g_strdup (shortcut->order_id);
+          entry->prior_order_id = g_strdup (
+            shortcut->device_prior_order_id);
+          g_ptr_array_add (snapshot->entries, entry);
+        }
+    }
+  return snapshot;
+}
