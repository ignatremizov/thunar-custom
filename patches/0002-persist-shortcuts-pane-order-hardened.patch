+                          || monitor == window->bookmark_parent_monitor
+                          || monitor == window->legacy_bookmark_parent_monitor
+                          || monitor == window->bookmark_target_monitor
+                          || monitor == window->legacy_bookmark_target_monitor);
+
+  if (window->bookmark_monitor == monitor)
+    {
+      file_monitor = &window->bookmark_monitor;
+      bookmark_file = window->bookmark_file;
+    }
+  else if (window->legacy_bookmark_monitor == monitor)
+    {
+      file_monitor = &window->legacy_bookmark_monitor;
+      bookmark_file = window->legacy_bookmark_file;
+      legacy = TRUE;
+    }
+  else if (window->bookmark_target_monitor == monitor)
+    {
+      target_monitor = TRUE;
+      bookmark_file = window->bookmark_file;
+    }
+  else if (window->legacy_bookmark_target_monitor == monitor)
+    {
+      target_monitor = TRUE;
+      bookmark_file = window->legacy_bookmark_file;
+      legacy = TRUE;
+    }
+
+  direct_monitor = file_monitor != NULL;
+  if (direct_monitor)
+    {
+      GFile    *parent;
+      gboolean  parent_exists;
+
+      parent = g_file_get_parent (bookmark_file);
+      parent_exists = parent != NULL && g_file_query_exists (parent, NULL);
+      if (event_type == G_FILE_MONITOR_EVENT_DELETED
+          || event_type == G_FILE_MONITOR_EVENT_MOVED
+          || event_type == G_FILE_MONITOR_EVENT_UNMOUNTED
+          || !parent_exists)
+        {
+          g_file_monitor_cancel (*file_monitor);
+          g_clear_object (file_monitor);
+          thunar_window_arm_bookmark_monitor (window, legacy);
+        }
+      g_clear_object (&parent);
+    }
+
+  if (monitor == window->bookmark_parent_monitor)
+    {
+      thunar_window_arm_bookmark_monitor (window, FALSE);
+      if (window->bookmark_update_id == 0)
+        window->bookmark_update_id =
+          g_idle_add (thunar_window_update_bookmarks_idle, window);
+      if (g_test_initialized () && bookmark_monitor_test_hook != NULL)
+        bookmark_monitor_test_hook (window, bookmark_monitor_test_hook_data);
+      return;
+    }
+
+  if (monitor == window->legacy_bookmark_parent_monitor)
+    {
+      thunar_window_arm_bookmark_monitor (window, TRUE);
+      if (window->bookmark_update_id == 0)
+        window->bookmark_update_id =
+          g_idle_add (thunar_window_update_bookmarks_idle, window);
+      if (g_test_initialized () && bookmark_monitor_test_hook != NULL)
+        bookmark_monitor_test_hook (window, bookmark_monitor_test_hook_data);
+      return;
+    }
+
+  if (target_monitor)
+    {
+      GFileMonitor **target_file_monitor;
+      GFile        **target_file;
+
+      target_file_monitor = legacy
+                              ? &window->legacy_bookmark_target_monitor
+                              : &window->bookmark_target_monitor;
+      target_file = legacy
+                      ? &window->legacy_bookmark_target_file
+                      : &window->bookmark_target_file;
+      if (event_type == G_FILE_MONITOR_EVENT_DELETED
+          || event_type == G_FILE_MONITOR_EVENT_MOVED
+          || event_type == G_FILE_MONITOR_EVENT_UNMOUNTED
+          || (*target_file != NULL && !g_file_query_exists (*target_file, NULL)))
+        {
+          g_file_monitor_cancel (*target_file_monitor);
+          g_clear_object (target_file_monitor);
+          g_clear_object (target_file);
+        }
+      thunar_window_update_bookmark_target_monitor (window, legacy);
+      if (window->bookmark_update_id == 0)
+        window->bookmark_update_id =
+          g_idle_add (thunar_window_update_bookmarks_idle, window);
+      if (g_test_initialized () && bookmark_monitor_test_hook != NULL)
+        bookmark_monitor_test_hook (window, bookmark_monitor_test_hook_data);
+      return;
+    }
+
+  if (window->bookmark_update_id == 0)
+    window->bookmark_update_id =
+      g_idle_add (thunar_window_update_bookmarks_idle, window);
+
+  if (g_test_initialized () && bookmark_monitor_test_hook != NULL)
+    bookmark_monitor_test_hook (window, bookmark_monitor_test_hook_data);
 }
 
 
