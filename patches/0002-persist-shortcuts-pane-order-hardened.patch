+static gboolean
+thunar_shortcuts_model_reconcile_devices_from_source (
+  ThunarShortcutsModel *model)
+{
+  GHashTable *current_devices;
+  GPtrArray  *stale_devices;
+  GList      *devices;
+  GList      *lp;
+  GParamSpec *order_pspec;
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model), FALSE);
+
+  if (!thunar_shortcuts_model_acquire_devices_order_lock (model, NULL))
+    return FALSE;
+  if (!thunar_shortcuts_model_refresh_order (
+        model,
+        THUNAR_SHORTCUT_SECTION_DEVICES))
+    {
+      thunar_shortcuts_model_release_devices_order_lock (model);
+      return FALSE;
+    }
+
+  /*
+   * Reconstruct intent from owned sources instead of retaining callback
+   * arguments across the timeout.  The monitor list owns one reference per
+   * entry; stale_devices separately keeps removed rows alive while mutation
+   * changes the model list.
+   */
+  devices = thunar_shortcuts_model_get_devices (model);
+  current_devices = g_hash_table_new (g_direct_hash, g_direct_equal);
+  for (lp = devices; lp != NULL; lp = lp->next)
+    g_hash_table_add (current_devices, lp->data);
+
+  stale_devices =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) g_object_unref);
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *shortcut = lp->data;
+
+      if (shortcut->device != NULL
+          && !g_hash_table_contains (current_devices, shortcut->device))
+        g_ptr_array_add (stale_devices, g_object_ref (shortcut->device));
+    }
+
+  for (guint n = 0; n < stale_devices->len; ++n)
+    thunar_shortcuts_model_device_removed (
+      model->device_monitor,
+      g_ptr_array_index (stale_devices, n),
+      model);
+
+  for (lp = devices; lp != NULL; lp = lp->next)
+    {
+      ThunarDevice *device = lp->data;
+      GList        *row;
+
+      for (row = model->shortcuts; row != NULL; row = row->next)
+        if (THUNAR_SHORTCUT (row->data)->device == device)
+          break;
+
+      if (row != NULL)
+        thunar_shortcuts_model_device_changed (model->device_monitor,
+                                               device,
+                                               model);
+      else if (!g_hash_table_contains (model->pending_device_adds, device))
+        thunar_shortcuts_model_device_added (NULL, device, model);
+    }
