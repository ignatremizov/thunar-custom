+static void
+test_devices_order_two_models_and_stale_noop (void)
+{
+  const gchar *baseline[] = {
+    "device:filesystem",
+    "device:a",
+    "device:b",
+    "device:c",
+    "device:d",
+    NULL,
+  };
+  g_autoptr (TestVolume) volume_a =
+    test_volume_new ("A", "a", "/dev/test-a", NULL);
+  g_autoptr (TestVolume) volume_b =
+    test_volume_new ("B", "b", "/dev/test-b", NULL);
+  g_autoptr (TestVolume) volume_c =
+    test_volume_new ("C", "c", "/dev/test-c", NULL);
+  g_autoptr (TestVolume) volume_d =
+    test_volume_new ("D", "d", "/dev/test-d", NULL);
+  g_autoptr (ThunarDevice) device_a = test_device_new (volume_a);
+  g_autoptr (ThunarDevice) device_b = test_device_new (volume_b);
+  g_autoptr (ThunarDevice) device_c = test_device_new (volume_c);
+  g_autoptr (ThunarDevice) device_d = test_device_new (volume_d);
+  ThunarDevice *devices[] = {
+    device_a,
+    device_b,
+    device_c,
+    device_d,
+  };
+  g_autoptr (ThunarPreferences) preferences = thunar_preferences_get ();
+  ThunarDeviceMonitor *monitor = thunar_device_monitor_get ();
+  ThunarShortcutsModel *model_a;
+  ThunarShortcutsModel *model_b;
+  GtkTreePath *writer_b_source;
+  GtkTreePath *writer_b_anchor;
+  GtkTreePath *source;
+  GtkTreePath *anchor;
+  GtkTreePath *result = NULL;
+  gchar **stored = NULL;
+  ThunarDevice *selected;
+
+  g_object_set (preferences,
+                "shortcuts-devices-order", baseline,
+                NULL);
+  model_a = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  model_b = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  emit_test_devices (monitor, devices, G_N_ELEMENTS (devices));
+
+  /*
+   * Model B retains its original list while model A commits the disjoint
+   * relation D<C.  Its later B<A request must rebase against A's durable
+   * vector instead of collecting its stale list and undoing D<C.
+   */
+  writer_b_source = device_path (GTK_TREE_MODEL (model_b), device_b);
+  writer_b_anchor = device_path (GTK_TREE_MODEL (model_b), device_a);
+  source = device_path (GTK_TREE_MODEL (model_a), device_d);
+  anchor = device_path (GTK_TREE_MODEL (model_a), device_c);
+  g_assert_true (thunar_shortcuts_model_move (model_a,
+                                              source,
+                                              anchor,
+                                              &result));
+  selected = path_device (GTK_TREE_MODEL (model_a), result);
+  g_assert_true (selected == device_d);
+  g_clear_object (&selected);
+  g_clear_pointer (&result, gtk_tree_path_free);
+  gtk_tree_path_free (source);
+  gtk_tree_path_free (anchor);
+
+  g_assert_true (thunar_shortcuts_model_move (model_b,
+                                              writer_b_source,
+                                              writer_b_anchor,
+                                              &result));
+  selected = path_device (GTK_TREE_MODEL (model_b), result);
+  g_assert_true (selected == device_b);
+  g_clear_object (&selected);
+  g_clear_pointer (&result, gtk_tree_path_free);
+  gtk_tree_path_free (writer_b_source);
+  gtk_tree_path_free (writer_b_anchor);
+
+  stored = read_devices_order (preferences);
+  g_assert_cmpint (strv_index ((const gchar *const *) stored, "device:b"),
+                   <,
+                   strv_index ((const gchar *const *) stored, "device:a"));
+  g_assert_cmpint (strv_index ((const gchar *const *) stored, "device:d"),
+                   <,
+                   strv_index ((const gchar *const *) stored, "device:c"));
+  g_strfreev (stored);
+  stored = NULL;
+  g_clear_object (&model_a);
+  g_clear_object (&model_b);
+
+  /*
+   * Repeat with a request which is a no-op only in the stale model.  Another
+   * model first commits B<A; the stale A<B operation must refresh and move.
+   */
+  g_object_set (preferences,
+                "shortcuts-devices-order", baseline,
+                NULL);
