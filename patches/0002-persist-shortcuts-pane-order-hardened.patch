+static void
+test_record_limit_and_excess_are_transactional (void)
+{
+  g_autofree gchar *case_dir = make_case_dir ("record-limit");
+  g_autofree gchar *canonical_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autoptr (GFile) canonical = g_file_new_for_path (canonical_path);
+  g_autoptr (GFile) source = NULL;
+  g_autofree gchar *etag = NULL;
+  g_autoptr (GString) contents = g_string_sized_new (
+    THUNAR_UTIL_BOOKMARKS_MAX_RECORDS * 16);
+  BookmarkResults results;
+  GError *error = NULL;
+  guint n;
+
