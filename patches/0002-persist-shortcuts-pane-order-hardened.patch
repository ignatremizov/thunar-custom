+  thunar_shortcuts_model_order_changed (model->preferences,
+                                        order_pspec,
+                                        model);
+
+  g_ptr_array_unref (stale_devices);
+  g_hash_table_unref (current_devices);
+  g_list_free_full (devices, g_object_unref);
+  thunar_shortcuts_model_release_devices_order_lock (model);
+  return TRUE;
