+        continue;
+      if (n > 0)
+        {
+          if (groups[n - 1] != request->previous_group
+              || g_strcmp0 (order_ids[n - 1],
+                            request->previous_order_id) != 0)
+            continue;
+        }
+      else if (request->previous_group != 0
+               || request->previous_order_id != NULL)
+        continue;
+      if (n + 1 < n_rows)
+        {
+          if (groups[n + 1] != request->next_group
+              || g_strcmp0 (order_ids[n + 1],
+                            request->next_order_id) != 0)
+            continue;
+        }
+      else if (request->next_group != 0
+               || request->next_order_id != NULL)
+        continue;
+
+      rebased_index = n;
+      ++matches;
+    }
+
+  if (cardinality != request->cardinality
+      || (request->cardinality > 1 && matches != 1)
+      || rebased_index < 0)
+    return FALSE;
+
+  if (row_index != NULL)
+    *row_index = rebased_index;
+  return TRUE;
+}
