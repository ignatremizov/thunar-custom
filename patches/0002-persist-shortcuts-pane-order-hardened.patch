+static void
+thunar_shortcuts_model_restore_device_ordering (
+  ThunarShortcutsModel          *model,
+  ThunarDeviceOrderingSnapshot *snapshot,
+  gboolean                      restore_order)
+{
+  const gchar *const *durable_order;
+
+  if (restore_order)
+    {
+      g_strfreev (model->devices_order);
+      model->devices_order = g_strdupv (snapshot->order);
+    }
+  durable_order = (const gchar *const *) model->devices_order;
+
+  for (guint n = 0; n < snapshot->entries->len; ++n)
+    {
+      ThunarDeviceOrderingEntry *entry =
+        g_ptr_array_index (snapshot->entries, n);
+      ThunarShortcut *shortcut = entry->shortcut;
+      const gchar    *durable_slot;
+
+      if (!thunar_shortcuts_model_has_shortcut (model, shortcut))
+        continue;
+
+      durable_slot = entry->prior_order_id != NULL
+                       ? entry->prior_order_id
+                       : entry->order_id;
+      g_clear_pointer (&shortcut->device_prior_order_id, g_free);
+
+      if (g_strcmp0 (shortcut->order_id, entry->order_id) != 0
+          && thunar_shortcuts_model_order_has_id (durable_order,
+                                                  durable_slot))
+        {
+          /*
+           * The device's current UUID/group/hidden state is a live fact and
+           * is intentionally not rolled back.  Its last durable slot becomes
+           * a prior claim until a later successful callback can migrate it.
+           */
+          shortcut->device_prior_order_id = g_strdup (durable_slot);
+        }
+      else if (entry->prior_order_id != NULL
+               && thunar_shortcuts_model_order_has_id (
+                    durable_order,
+                    entry->prior_order_id))
+        {
+          shortcut->device_prior_order_id = g_strdup (
+            entry->prior_order_id);
+        }
+    }
+
+  thunar_shortcuts_model_refresh_order_positions (
+    model,
+    THUNAR_SHORTCUT_SECTION_DEVICES);
+  thunar_shortcuts_model_sort_shortcuts (model);
+}
