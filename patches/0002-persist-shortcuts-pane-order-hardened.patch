+    THUNAR_SHORTCUT_GROUP_DEVICES_VOLUMES,
+  };
+  const gchar *device_ids[] = {
+    NULL,
+    NULL,
+    "device:a",
+    "device:x",
+    NULL,
+    "device:c",
+    "device:d",
+  };
+  const ThunarShortcutGroup duplicate_places_groups[] = {
+    THUNAR_SHORTCUT_GROUP_PLACES_HEADER,
+    THUNAR_SHORTCUT_GROUP_PLACES_DEFAULT,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_DEVICES_HEADER,
+  };
+  const gchar *duplicate_places_ids[] = {
+    NULL,
+    "place:home",
+    "bookmark:file:///duplicate",
+    "bookmark:file:///duplicate",
