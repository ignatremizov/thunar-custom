+  memset (request, 0, sizeof (*request));
+  request->group = groups[row_index];
+  request->old_order_id = g_strdup (order_ids[row_index]);
+  request->occurrence =
+    thunar_shortcuts_model_row_occurrence (groups, order_ids, row_index);
+  for (n = 0; n < n_rows; ++n)
+    if (groups[n] == request->group
