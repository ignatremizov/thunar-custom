+static gboolean
+thunar_shortcuts_model_capture_identity (ThunarShortcutsModel   *model,
+                                         ThunarShortcut         *shortcut,
+                                         ThunarShortcutIdentity *identity)
+{
+  GList *lp;
+  GList *previous = NULL;
+  GList *next;
+
+  memset (identity, 0, sizeof (*identity));
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcut *candidate = lp->data;
+
+      if (candidate == shortcut)
+        {
+          for (next = model->shortcuts; next != NULL; next = next->next)
+            {
+              ThunarShortcut *other = next->data;
+
+              if (other->group == shortcut->group
+                  && g_strcmp0 (other->order_id, shortcut->order_id) == 0)
+                ++identity->cardinality;
+            }
+          identity->group = shortcut->group;
+          identity->order_id = g_strdup (shortcut->order_id);
+          identity->label = g_strdup (shortcut->name);
+          if (previous != NULL)
+            {
+              ThunarShortcut *other = previous->data;
+
+              identity->previous_group = other->group;
+              identity->previous_order_id = g_strdup (other->order_id);
+            }
+          if (lp->next != NULL)
+            {
+              ThunarShortcut *other = lp->next->data;
+
+              identity->next_group = other->group;
+              identity->next_order_id = g_strdup (other->order_id);
+            }
+          return TRUE;
+        }
+
+      previous = lp;
+    }
+
+  return FALSE;
+}
+
+
+
+static ThunarShortcut *
+thunar_shortcuts_model_resolve_identity (ThunarShortcutsModel         *model,
+                                         const ThunarShortcutIdentity *identity,
+                                         gint                         *index)
+{
+  GList *lp;
+  gint   row_index;
+  guint  cardinality = 0;
+  guint  matches = 0;
+  ThunarShortcut *resolved = NULL;
+  gint resolved_index = -1;
+
+  for (lp = model->shortcuts, row_index = 0;
+       lp != NULL;
+       lp = lp->next, ++row_index)
+    {
+      ThunarShortcut *candidate = lp->data;
+
+      if (candidate->group != identity->group
+          || g_strcmp0 (candidate->order_id, identity->order_id) != 0)
+        continue;
+
+      ++cardinality;
+      if (identity->cardinality <= 1)
+        {
+          resolved = candidate;
+          resolved_index = row_index;
+          continue;
+        }
+
+      if (g_strcmp0 (candidate->name, identity->label) != 0)
+        continue;
+      if (row_index > 0)
+        {
+          ThunarShortcut *previous =
+            g_list_nth_data (model->shortcuts, row_index - 1);
+
+          if (previous->group != identity->previous_group
+              || g_strcmp0 (previous->order_id,
+                            identity->previous_order_id) != 0)
+            continue;
+        }
+      else if (identity->previous_group != 0
+               || identity->previous_order_id != NULL)
+        continue;
+      if (lp->next != NULL)
+        {
+          ThunarShortcut *next = lp->next->data;
+
+          if (next->group != identity->next_group
+              || g_strcmp0 (next->order_id,
+                            identity->next_order_id) != 0)
+            continue;
+        }
+      else if (identity->next_group != 0
+               || identity->next_order_id != NULL)
+        continue;
+
+      resolved = candidate;
+      resolved_index = row_index;
+      ++matches;
+    }
+
+  if (cardinality != identity->cardinality
+      || (identity->cardinality > 1 && matches != 1))
+    return NULL;
+
+  if (resolved != NULL && index != NULL)
+    *index = resolved_index;
+  return resolved;
+}
+
+
+
+static void
+thunar_shortcuts_model_clear_identity (ThunarShortcutIdentity *identity)
+{
+  g_clear_pointer (&identity->order_id, g_free);
+  g_clear_pointer (&identity->label, g_free);
+  g_clear_pointer (&identity->previous_order_id, g_free);
+  g_clear_pointer (&identity->next_order_id, g_free);
+  memset (identity, 0, sizeof (*identity));
+}
