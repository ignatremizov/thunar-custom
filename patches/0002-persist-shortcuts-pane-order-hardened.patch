+
+static void
+thunar_shortcuts_model_update_bookmark_generation (ThunarShortcutsModel *model,
+                                                   GFile                 *source_file,
+                                                   gchar                 *etag)
+{
+  /* source_file is borrowed; etag ownership is transferred. */
+  g_set_object (&model->bookmark_source, source_file);
+  g_free (model->bookmark_source_etag);
+  model->bookmark_source_etag = etag;
+}
