+static void
+window_monitor_arm_race_hook (ThunarWindow *window,
+                              gboolean      legacy,
+                              gpointer      user_data)
+{
+  WindowMonitorArmRace *race = user_data;
+
+  (void) window;
+  if (!legacy && !race->fired)
+    {
+      if (!g_file_test (race->config_dir, G_FILE_TEST_IS_DIR))
+        g_assert_cmpint (g_mkdir (race->config_dir, 0700), ==, 0);
+      race->fired = TRUE;
+    }
+}
+
+
+
+static void
+window_direct_monitor_arm_race_hook (ThunarWindow *window,
+                                     gboolean      legacy,
+                                     gpointer      user_data)
+{
+  WindowDirectMonitorArmRace *race = user_data;
+
+  (void) window;
+  if (!legacy
+      && !race->fired
+      && g_file_test (race->parent_dir, G_FILE_TEST_IS_DIR))
+    {
+      if (g_file_test (bookmarks_path, G_FILE_TEST_EXISTS))
+        g_assert_cmpint (g_remove (bookmarks_path), ==, 0);
+      g_assert_cmpint (g_rmdir (race->parent_dir), ==, 0);
+      race->fired = TRUE;
+    }
+}
+
+
+
+static void
+window_monitor_destroy (WindowMonitorTeardown *teardown)
+{
+  if (*teardown->window != NULL)
+    gtk_window_close (GTK_WINDOW (*teardown->window));
+  g_clear_object (teardown->window);
+  teardown->destroy_id = 0;
+}
+
+
+
+static gboolean
+window_monitor_destroy_idle (gpointer user_data)
+{
+  WindowMonitorTeardown *teardown = user_data;
+
+  window_monitor_destroy (teardown);
+  return G_SOURCE_REMOVE;
+}
+
+
+
+static void
+window_monitor_teardown_hook (ThunarWindow *window,
+                              gpointer      user_data)
+{
+  WindowMonitorTeardown *teardown = user_data;
+
+  (void) window;
+  teardown->queued = TRUE;
+  if (teardown->destroy_id == 0)
+    teardown->destroy_id =
+      g_idle_add_full (G_PRIORITY_HIGH,
+                       window_monitor_destroy_idle,
+                       teardown,
+                       NULL);
+}
