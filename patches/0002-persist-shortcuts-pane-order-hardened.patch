+static void
+test_byte_limit_and_oversize_are_transactional (void)
+{
+  static const gchar prefix[] = "file:///boundary Boundary-";
+  g_autofree gchar *case_dir = make_case_dir ("byte-limit");
+  g_autofree gchar *canonical_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autofree gchar *contents = g_malloc (THUNAR_UTIL_BOOKMARKS_MAX_BYTES + 2);
+  g_autoptr (GFile) canonical = g_file_new_for_path (canonical_path);
+  g_autoptr (GFile) source = NULL;
+  g_autofree gchar *etag = NULL;
+  BookmarkResults results;
+  GError *error = NULL;
+
+  memcpy (contents, prefix, sizeof (prefix) - 1);
+  memset (contents + sizeof (prefix) - 1,
+          'x',
+          THUNAR_UTIL_BOOKMARKS_MAX_BYTES - (sizeof (prefix) - 1));
+  contents[THUNAR_UTIL_BOOKMARKS_MAX_BYTES] = '\0';
+  write_path_len (canonical_path,
+                  contents,
+                  THUNAR_UTIL_BOOKMARKS_MAX_BYTES);
+  results_init (&results);
+
+  g_assert_true (thunar_util_load_bookmarks_with_etag_full (
+    canonical, collect_bookmark, &results, &source, &etag, &error));
+  g_assert_no_error (error);
+  g_assert_cmpuint (results.calls, ==, 1);
+  g_assert_true (g_file_equal (source, canonical));
+  g_assert_nonnull (etag);
+  results_clear (&results);
+
+  contents[THUNAR_UTIL_BOOKMARKS_MAX_BYTES] = 'x';
+  contents[THUNAR_UTIL_BOOKMARKS_MAX_BYTES + 1] = '\0';
+  write_path_len (canonical_path,
+                  contents,
+                  THUNAR_UTIL_BOOKMARKS_MAX_BYTES + 1);
+  g_clear_object (&source);
+  g_clear_pointer (&etag, g_free);
+  results_init (&results);
+
+  g_assert_false (thunar_util_load_bookmarks_with_etag_full (
+    canonical, collect_bookmark, &results, &source, &etag, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_MESSAGE_TOO_LARGE);
+  g_assert_cmpuint (results.calls, ==, 0);
+  g_assert_null (source);
+  g_assert_null (etag);
+  g_clear_error (&error);
+  results_clear (&results);
+}
+
+
