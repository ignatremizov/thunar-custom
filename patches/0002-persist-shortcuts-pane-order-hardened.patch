+int
+main (int argc, char **argv)
+{
+  g_autofree gchar *config_dir;
+  g_autofree gchar *cache_dir;
+  g_autofree gchar *data_dir;
+  g_autofree gchar *runtime_dir;
+  g_autofree gchar *state_dir;
+  g_autofree gchar *gtk_dir;
+  GError *error = NULL;
+  gint result;
+
+  test_root = g_dir_make_tmp ("thunar-no-xfconf-XXXXXX", &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (test_root);
+
+  config_dir = g_build_filename (test_root, "config", NULL);
+  cache_dir = g_build_filename (test_root, "cache", NULL);
+  data_dir = g_build_filename (test_root, "data", NULL);
+  runtime_dir = g_build_filename (test_root, "runtime", NULL);
+  state_dir = g_build_filename (test_root, "state", NULL);
+  gtk_dir = g_build_filename (config_dir, "gtk-3.0", NULL);
+  g_assert_cmpint (g_mkdir_with_parents (gtk_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (cache_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (data_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (runtime_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (state_dir, 0700), ==, 0);
+  g_setenv ("HOME", test_root, TRUE);
+  g_setenv ("XDG_CONFIG_HOME", config_dir, TRUE);
+  g_setenv ("XDG_CACHE_HOME", cache_dir, TRUE);
+  g_setenv ("XDG_DATA_HOME", data_dir, TRUE);
+  g_setenv ("XDG_RUNTIME_DIR", runtime_dir, TRUE);
+  g_setenv ("XDG_STATE_HOME", state_dir, TRUE);
+  /*
+   * Keep this no-Xfconf process independent of the caller's desktop.  The
+   * empty bus address prevents GIO consumers from reaching a live session,
+   * and the local VFS avoids starting GVfs helpers while constructing the
+   * model.  Unsetting DISPLAY makes the one accepted thumbnailer diagnostic
+   * deterministic in both interactive and headless invocations.
+   */
+  g_setenv ("DBUS_SESSION_BUS_ADDRESS", "unix:path=/dev/null", TRUE);
+  g_setenv ("GIO_USE_VFS", "local", TRUE);
+  g_unsetenv ("DISPLAY");
+  g_assert_true (g_str_has_prefix (g_get_home_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_config_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_cache_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_data_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_runtime_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_state_dir (), test_root));
+
+  bookmarks_path = g_build_filename (gtk_dir, "bookmarks", NULL);
+  g_test_init (&argc, &argv, NULL);
+  g_log_set_always_fatal (G_LOG_LEVEL_ERROR);
+  g_log_set_writer_func (test_log_writer, NULL, NULL);
+  g_log_set_handler ("thunar",
+                     G_LOG_LEVEL_WARNING | G_LOG_LEVEL_CRITICAL,
+                     test_legacy_log_handler,
+                     NULL);
+  thunar_preferences_xfconf_init_failed ();
+  g_test_add_func ("/shortcuts-model/no-xfconf/gtk-only-places-contract",
+                   test_gtk_only_places_contract);
+  g_test_add_func ("/shortcuts-model/no-xfconf/empty-bookmark-blocks",
+                   test_empty_bookmark_blocks);
+  g_test_add_func ("/shortcuts-model/no-xfconf/bookmark-publish-limits",
+                   test_bookmark_publish_limits);
+  g_test_add_func ("/shortcuts-model/no-xfconf/dual-bookmark-monitors-and-teardown",
+                   test_dual_bookmark_monitors_and_teardown);
+  g_test_add_func ("/shortcuts-model/no-xfconf/monitor-arm-rechecks-ancestor",
+                   test_monitor_arm_rechecks_ancestor);
+  g_test_add_func ("/shortcuts-model/no-xfconf/monitor-arm-rechecks-direct-path",
+                   test_monitor_arm_rechecks_direct_path);
+  g_test_add_func ("/shortcuts-model/no-xfconf/move-returns-rebased-path",
+                   test_move_returns_rebased_path);
+  result = g_test_run ();
+  g_assert_cmpint (g_atomic_int_get (&unexpected_warning_count), ==, 0);
+
+  g_free (bookmarks_path);
+  remove_tree (test_root);
+  g_free (test_root);
+  return result;
+}
