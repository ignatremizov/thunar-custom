+static void
+test_move_returns_rebased_path (void)
+{
+  g_autofree gchar *uri_a = make_uri ("rebase-a");
+  g_autofree gchar *uri_b = make_uri ("rebase-b");
+  g_autofree gchar *uri_c = make_uri ("rebase-c");
+  g_autofree gchar *initial_contents =
+    g_strdup_printf ("%s A\n%s B\n%s C\n", uri_a, uri_b, uri_c);
+  g_autofree gchar *prefix_contents =
+    g_strdup_printf ("file:///external-prefix\n%s", initial_contents);
+  ThunarShortcutsModel *model;
+  GtkTreePath *source_path;
+  GtkTreePath *destination_path;
+  GtkTreePath *result_path;
+  GtkTreePath *expected_path;
+  MovePrefixHook hook;
+
+  /*
+   * Insert an external prefix between path capture and preparation.  The
+   * first request is already satisfied (B before C), so the rebased no-op
+   * must return B's shifted child path.
+   */
+  write_bookmarks (initial_contents);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context ();
+  source_path = find_bookmark_path (GTK_TREE_MODEL (model), uri_b);
+  destination_path = find_bookmark_path (GTK_TREE_MODEL (model), uri_c);
+  g_assert_nonnull (source_path);
+  g_assert_nonnull (destination_path);
+  hook.contents = prefix_contents;
+  hook.fired = FALSE;
+  thunar_shortcuts_model_set_bookmark_write_test_hook (move_prefix_hook,
+                                                       &hook);
+  result_path = NULL;
+  g_assert_true (thunar_shortcuts_model_move (
+    model,
+    source_path,
+    destination_path,
+    &result_path));
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  g_assert_true (hook.fired);
+  expected_path = find_bookmark_path (GTK_TREE_MODEL (model), uri_b);
+  g_assert_nonnull (expected_path);
+  g_assert_nonnull (result_path);
+  g_assert_cmpint (gtk_tree_path_compare (result_path, expected_path), ==, 0);
+  gtk_tree_path_free (expected_path);
+  gtk_tree_path_free (result_path);
+  gtk_tree_path_free (destination_path);
+  gtk_tree_path_free (source_path);
+  g_object_unref (model);
+  iterate_main_context ();
+
+  /*
+   * A real C-before-A move must likewise return C's post-rebase path, not
+   * the stale destination path captured before the external insertion.
+   */
+  write_bookmarks (initial_contents);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context ();
+  source_path = find_bookmark_path (GTK_TREE_MODEL (model), uri_c);
+  destination_path = find_bookmark_path (GTK_TREE_MODEL (model), uri_a);
+  g_assert_nonnull (source_path);
+  g_assert_nonnull (destination_path);
+  hook.contents = prefix_contents;
+  hook.fired = FALSE;
+  thunar_shortcuts_model_set_bookmark_write_test_hook (move_prefix_hook,
+                                                       &hook);
+  result_path = NULL;
+  g_assert_true (thunar_shortcuts_model_move (
+    model,
+    source_path,
+    destination_path,
+    &result_path));
+  thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+  g_assert_true (hook.fired);
+  expected_path = find_bookmark_path (GTK_TREE_MODEL (model), uri_c);
+  g_assert_nonnull (expected_path);
+  g_assert_nonnull (result_path);
+  g_assert_cmpint (gtk_tree_path_compare (result_path, expected_path), ==, 0);
+  gtk_tree_path_free (expected_path);
+  gtk_tree_path_free (result_path);
+  gtk_tree_path_free (destination_path);
+  gtk_tree_path_free (source_path);
+  g_object_unref (model);
+  iterate_main_context ();
+}
