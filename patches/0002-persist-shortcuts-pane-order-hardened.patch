+#ifdef G_OS_UNIX
+static gboolean
+read_pipe_byte (gint fd)
+{
+  gchar    byte;
+  ssize_t  n_read;
+
+  do
+    {
+      n_read = read (fd, &byte, 1);
+    }
+  while (n_read < 0 && errno == EINTR);
+
+  return n_read == 1;
+}
+
+
+
+static gboolean
+write_pipe_byte (gint fd)
+{
+  const gchar byte = 'x';
+  ssize_t     n_written;
+
+  do
+    {
+      n_written = write (fd, &byte, 1);
+    }
+  while (n_written < 0 && errno == EINTR);
+
+  return n_written == 1;
+}
+#endif
