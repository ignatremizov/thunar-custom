+
+
+static GPtrArray *
+model_row_tokens (GtkTreeModel *model)
+{
+  GPtrArray  *rows;
+  GtkTreeIter iter;
+  gboolean    valid;
+
+  rows = g_ptr_array_new ();
+  for (valid = gtk_tree_model_get_iter_first (model, &iter);
+       valid;
+       valid = gtk_tree_model_iter_next (model, &iter))
+    g_ptr_array_add (rows, iter.user_data);
+
+  return rows;
+}
+
+
+
+static void
+rows_reordered (GtkTreeModel *model,
+                GtkTreePath  *path,
+                GtkTreeIter  *parent,
+                gint         *new_order,
+                ReorderProbe *probe)
+{
+  GPtrArray *current_rows;
+  guint      n;
+
+  g_assert_cmpint (gtk_tree_path_get_depth (path), ==, 0);
+  g_assert_null (parent);
+
+  current_rows = model_row_tokens (model);
+  g_assert_cmpuint (current_rows->len, ==, probe->previous_rows->len);
+  for (n = 0; n < current_rows->len; ++n)
+    g_assert_true (g_ptr_array_index (current_rows, n)
+                   == g_ptr_array_index (probe->previous_rows, new_order[n]));
+
+  g_ptr_array_unref (probe->previous_rows);
+  probe->previous_rows = current_rows;
+  ++probe->emissions;
+}
+
+
+
+static gulong
+reorder_probe_connect (GtkTreeModel *model,
+                       ReorderProbe *probe)
+{
+  probe->previous_rows = model_row_tokens (model);
+  probe->emissions = 0;
+  return g_signal_connect (model,
+                           "rows-reordered",
+                           G_CALLBACK (rows_reordered),
+                           probe);
+}
+
+
+
+static void
+reorder_probe_disconnect (GtkTreeModel *model,
+                          ReorderProbe *probe,
+                          gulong        signal_id)
+{
+  g_signal_handler_disconnect (model, signal_id);
+  g_ptr_array_unref (probe->previous_rows);
+}
+
+
+
+static void
+row_changed_probe (GtkTreeModel *model,
+                   GtkTreePath  *path,
+                   GtkTreeIter  *iter,
+                   RowChangedProbe *probe)
+{
+  GtkTreeIter  probe_iter;
+  ThunarFile  *file;
+  GFile       *location;
+  gboolean     valid;
+  guint        matching_rows = 0;
+
+  (void) path;
+  (void) iter;
+
+  for (valid = gtk_tree_model_get_iter_first (model, &probe_iter);
+       valid;
+       valid = gtk_tree_model_iter_next (model, &probe_iter))
+    {
+      file = NULL;
+      location = NULL;
+      gtk_tree_model_get (model,
+                          &probe_iter,
+                          THUNAR_SHORTCUTS_MODEL_COLUMN_FILE, &file,
+                          THUNAR_SHORTCUTS_MODEL_COLUMN_LOCATION, &location,
+                          -1);
+      if (location != NULL
+          && probe->expected_location != NULL
+          && g_file_equal (location, probe->expected_location))
+        {
+          ++matching_rows;
+          if (file != NULL)
+            probe->final_state = FALSE;
+        }
+      g_clear_object (&file);
+      g_clear_object (&location);
+    }
+  if (matching_rows != 2)
+    probe->final_state = FALSE;
+  ++probe->emissions;
+}
