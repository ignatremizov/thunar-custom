+
+  return link (stage_path, target_path);
+#else
+  errno = ENOTSUP;
+  return -1;
+#endif
+}
+
+
+
+void
+thunar_util_set_bookmarks_no_hard_links_for_test (gboolean enabled)
+{
+  g_atomic_int_set (&thunar_util_bookmarks_no_hard_links_for_test, enabled);
+}
+
+
+
+static gint
+thunar_util_rename_noreplace (const gchar *stage_path,
+                              const gchar *target_path)
+{
+#if defined(__linux__) && defined(SYS_renameat2) && defined(AT_FDCWD)
+#define THUNAR_RENAME_NOREPLACE (1U << 0)
+  gint result;
+
+  result = syscall (SYS_renameat2,
+                    AT_FDCWD,
+                    stage_path,
+                    AT_FDCWD,
+                    target_path,
+                    THUNAR_RENAME_NOREPLACE);
+#undef THUNAR_RENAME_NOREPLACE
+  return result;
+#else
+  /*
+   * POSIX rename() may replace an existing target and is never a safe
+   * fallback. Platforms without an exclusive primitive fail closed.
+   */
+  errno = ENOTSUP;
+  return -1;
+#endif
+}
+
+
+
+static gboolean
+thunar_util_install_staged_file (const gchar  *stage_path,
+                                 const gchar  *target_path,
+                                 gboolean     *stage_was_moved,
+                                 GError      **error)
+{
+  gint link_errno;
+  gint rename_errno;
+
+  *stage_was_moved = FALSE;
+  if (thunar_util_link_for_bookmarks (stage_path, target_path) == 0)
+    return TRUE;
+
+  link_errno = errno;
+  if (link_errno == EEXIST)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_EXISTS,
+                           "The bookmarks file already exists");
+      return FALSE;
+    }
+
+  /*
+   * FUSE and other restricted filesystems can reject hard links while still
+   * supporting an atomic, exclusive rename.
+   */
+  if (thunar_util_rename_noreplace (stage_path, target_path) == 0)
+    {
+      *stage_was_moved = TRUE;
+      return TRUE;
+    }
+
+  rename_errno = errno;
+  if (rename_errno == EEXIST)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_EXISTS,
+                           "The bookmarks file already exists");
+      return FALSE;
+    }
+
+  if (rename_errno == ENOTSUP
+#ifdef EOPNOTSUPP
+      || rename_errno == EOPNOTSUPP
+#endif
+      || rename_errno == ENOSYS
+      || rename_errno == EINVAL)
+    {
+      g_set_error (error,
+                   G_IO_ERROR,
+                   G_IO_ERROR_NOT_SUPPORTED,
+                   "The filesystem rejected hard links (%s) and has no supported atomic no-replace rename",
+                   g_strerror (link_errno));
+      return FALSE;
+    }
+
+  g_set_error (error,
+               G_IO_ERROR,
+               g_io_error_from_errno (rename_errno),
+               "Failed to install the bookmarks file without replacing an existing file: %s",
+               g_strerror (rename_errno));
+  return FALSE;
+}
+
+
+
+gboolean
+thunar_util_create_file_atomically (GFile        *file,
+                                    const gchar  *contents,
+                                    gsize         length,
+                                    gchar       **new_etag,
+                                    GError      **error)
+{
+  GFile    *parent = NULL;
+  GFile    *stage_file = NULL;
+  gchar    *parent_path = NULL;
+  gchar    *target_path = NULL;
+  gchar    *stage_path = NULL;
+  gchar    *staged_contents = NULL;
+  gchar    *staged_etag = NULL;
+  gchar    *installed_contents = NULL;
+  gchar    *installed_etag = NULL;
+  gsize     staged_length = 0;
+  gsize     installed_length = 0;
+  gint      stage_fd = -1;
+  FILE     *stage_fp = NULL;
+  gboolean  stage_exists = FALSE;
+  gboolean  stage_was_moved = FALSE;
+  gboolean  success = FALSE;
+  gint      saved_errno;
+
+  if (new_etag != NULL)
+    *new_etag = NULL;
+  if (!G_IS_FILE (file) || !g_file_is_native (file) || contents == NULL)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_INVALID_ARGUMENT,
+                           "A native file and contents are required");
+      return FALSE;
+    }
+
+  parent = g_file_get_parent (file);
+  parent_path = parent != NULL ? g_file_get_path (parent) : NULL;
+  target_path = g_file_get_path (file);
+  if (parent_path == NULL || target_path == NULL)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_INVALID_ARGUMENT,
+                           "The target is not a local path");
+      goto finished;
+    }
+
+  stage_path = g_build_filename (parent_path, ".thunar-bookmarks-XXXXXX", NULL);
+  stage_fd = g_mkstemp (stage_path);
+  if (stage_fd < 0)
+    {
+      saved_errno = errno;
+      g_set_error (error,
+                   G_FILE_ERROR,
+                   g_file_error_from_errno (saved_errno),
+                   "Failed to create a temporary bookmarks file");
+      goto finished;
+    }
+  stage_exists = TRUE;
+  stage_fp = fdopen (stage_fd, "w");
+  if (stage_fp == NULL)
+    {
+      saved_errno = errno;
+      close (stage_fd);
+      stage_fd = -1;
+      g_set_error_literal (error,
+                           G_FILE_ERROR,
+                           G_FILE_ERROR_IO,
+                           "Failed to write the temporary bookmarks file");
+      goto finished;
+    }
+  stage_fd = -1;
+  {
+    gboolean write_ok;
+    gboolean close_ok;
+
+    write_ok = fwrite (contents, 1, length, stage_fp) == length;
+    close_ok = fclose (stage_fp) == 0;
+    stage_fp = NULL;
+    if (!write_ok || !close_ok)
+      {
+        g_set_error_literal (error,
+                             G_FILE_ERROR,
+                             G_FILE_ERROR_IO,
+                             "Failed to write the temporary bookmarks file");
+        goto finished;
+      }
+  }
+
+  stage_file = g_file_new_for_path (stage_path);
+  if (!g_file_load_contents (stage_file,
+                             NULL,
+                             &staged_contents,
+                             &staged_length,
+                             &staged_etag,
+                             error)
+      || staged_etag == NULL
+      || staged_length != length
+      || memcmp (staged_contents, contents, length) != 0)
+    {
+      if (error != NULL && *error == NULL)
+        g_set_error_literal (error,
+                             G_IO_ERROR,
+                             G_IO_ERROR_WRONG_ETAG,
+                             "The staged bookmarks file changed");
+      goto finished;
+    }
+
+  if (!thunar_util_install_staged_file (stage_path,
+                                        target_path,
+                                        &stage_was_moved,
+                                        error))
+    goto finished;
+
+  if (stage_was_moved)
+    stage_exists = FALSE;
+  else if (g_unlink (stage_path) == 0)
+    stage_exists = FALSE;
+  else
+    g_warning ("Failed to remove installed bookmarks staging path \"%s\": %s",
+               stage_path,
+               g_strerror (errno));
+
+  if (!g_file_load_contents (file,
+                             NULL,
+                             &installed_contents,
+                             &installed_length,
+                             &installed_etag,
+                             error)
+      || installed_etag == NULL
+      || g_strcmp0 (staged_etag, installed_etag) != 0
+      || installed_length != length
+      || memcmp (installed_contents, contents, length) != 0)
+    {
+      if (error != NULL && *error == NULL)
+        g_set_error_literal (error,
+                             G_IO_ERROR,
+                             G_IO_ERROR_WRONG_ETAG,
+                             "The installed bookmarks file changed");
+      goto finished;
+    }
+
+  if (new_etag != NULL)
+    {
+      *new_etag = installed_etag;
+      installed_etag = NULL;
+    }
+  success = TRUE;
+
+finished:
+  if (stage_fp != NULL)
+    fclose (stage_fp);
+  if (stage_fd >= 0)
+    close (stage_fd);
+  if (stage_exists && g_unlink (stage_path) < 0)
+    g_warning ("Failed to remove bookmarks staging path \"%s\": %s",
+               stage_path,
+               g_strerror (errno));
+  g_clear_object (&stage_file);
+  g_clear_object (&parent);
+  g_free (parent_path);
+  g_free (target_path);
+  g_free (stage_path);
+  g_free (staged_contents);
+  g_free (staged_etag);
+  g_free (installed_contents);
+  g_free (installed_etag);
+  return success;
+}
+
+
+
+gint
+thunar_util_acquire_bookmarks_lock (GError **error)
+{
+  gchar *lock_dir;
+  gchar *lock_path;
+  gint   lock_fd;
+  gint   lock_errno;
+
+  lock_dir = g_build_filename (g_get_user_cache_dir (), "Thunar", NULL);
+  if (g_mkdir_with_parents (lock_dir, 0700) < 0)
+    {
+      lock_errno = errno;
+      g_set_error (error,
+                   G_IO_ERROR,
+                   g_io_error_from_errno (lock_errno),
+                   "Failed to create the GTK bookmarks lock directory: %s",
+                   g_strerror (lock_errno));
+      g_free (lock_dir);
+      return -1;
+    }
+
+  lock_path = g_build_filename (lock_dir, "gtk-bookmarks-write.lock", NULL);
+  lock_fd = g_open (lock_path, O_CREAT | O_RDWR, 0600);
+  if (lock_fd < 0)
+    {
+      lock_errno = errno;
+      g_set_error (error,
+                   G_IO_ERROR,
+                   g_io_error_from_errno (lock_errno),
+                   "Failed to open the GTK bookmarks lock: %s",
+                   g_strerror (lock_errno));
+      g_free (lock_path);
+      g_free (lock_dir);
+      return -1;
+    }
+
+  do
+    {
+      lock_errno = flock (lock_fd, LOCK_EX | LOCK_NB) < 0 ? errno : 0;
+    }
+  while (lock_errno == EINTR);
+  if (lock_errno != 0)
+    {
+      if (lock_errno == EWOULDBLOCK || lock_errno == EAGAIN)
+        g_set_error_literal (error,
+                             G_IO_ERROR,
+                             G_IO_ERROR_WOULD_BLOCK,
+                             "The GTK bookmarks lock is busy");
+      else
+        g_set_error (error,
+                     G_IO_ERROR,
+                     g_io_error_from_errno (lock_errno),
+                     "Failed to acquire the GTK bookmarks lock: %s",
+                     g_strerror (lock_errno));
+      close (lock_fd);
+      lock_fd = -1;
+    }
+
+  g_free (lock_path);
+  g_free (lock_dir);
+  return lock_fd;
+}
+
+
+
+void
+thunar_util_release_bookmarks_lock (gint lock_fd)
+{
+  if (lock_fd >= 0 && close (lock_fd) < 0)
+    g_warning ("Failed to close the GTK bookmarks lock: %s",
+               g_strerror (errno));
 }
 
 
