+static void
+test_model_duplicate_bookmark_rebase_is_bounded (void)
+{
+  g_autofree gchar *duplicate_uri =
+    g_strdup (bookmark_uris[0]);
+  g_autofree gchar *anchor_uri =
+    g_strdup (bookmark_uris[1]);
+  g_autofree gchar *add_path =
+    g_build_filename (test_root, "duplicate-add", NULL);
+  g_autoptr (GFile) add_file = NULL;
+  ThunarShortcutsModel *stable_model = NULL;
+
+  g_assert_cmpint (g_mkdir_with_parents (add_path, 0700), ==, 0);
+  add_file = g_file_new_for_path (add_path);
+
+  /*
+   * A same-URI insertion before a labelled duplicate changes its
+   * cardinality.  Rename must reject the refreshed occurrence rather than
+   * applying the request to a different row.
+   */
+  {
+    g_autofree gchar *initial =
+      g_strdup_printf ("%s First\n%s Second\n", duplicate_uri, duplicate_uri);
+    g_autofree gchar *external =
+      g_strdup_printf ("%s External\n%s First\n%s Second\n",
+                       duplicate_uri,
+                       duplicate_uri,
+                       duplicate_uri);
+    ThunarShortcutsModel *model;
+    GPtrArray *paths;
+    GtkTreeIter iter;
+    BookmarkRaceHook hook = {
+      bookmarks_path,
+      external,
+      THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PREPARE,
+      FALSE,
+    };
+    gchar *contents = NULL;
+    gint   warning_start;
+
+    write_bookmark_file (bookmarks_path, initial);
+    model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context_for (200);
+    paths = shortcut_paths (
+      GTK_TREE_MODEL (model),
+      THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+      TRUE);
+    g_assert_cmpuint (paths->len, ==, 2);
+    g_assert_true (gtk_tree_model_get_iter (
+      GTK_TREE_MODEL (model),
+      &iter,
+      g_ptr_array_index (paths, 1)));
+    warning_start = g_atomic_int_get (&expected_bookmark_rebase_warning_count);
+    expect_bookmark_rebase_warnings = TRUE;
+    thunar_shortcuts_model_set_bookmark_write_test_hook (
+      bookmark_race_hook,
+      &hook);
+    thunar_shortcuts_model_rename (model, &iter, "Renamed");
+    thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+    iterate_main_context_for (100);
+    expect_bookmark_rebase_warnings = FALSE;
+    g_assert_cmpint (g_atomic_int_get (&expected_bookmark_rebase_warning_count)
+                     - warning_start,
+                     ==,
+                     1);
+    g_assert_true (hook.fired);
+    g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+    g_assert_cmpstr (contents, ==, external);
+    g_free (contents);
+    g_ptr_array_unref (paths);
+    g_clear_object (&model);
+    iterate_main_context_for (200);
+  }
+
+  /*
+   * Deleting the earlier occurrence is equally ambiguous.  The selected
+   * labelled row must not silently turn into the remaining duplicate.
+   */
+  {
+    g_autofree gchar *initial =
+      g_strdup_printf ("%s First\n%s Second\n", duplicate_uri, duplicate_uri);
+    g_autofree gchar *external =
+      g_strdup_printf ("%s Second\n", duplicate_uri);
+    ThunarShortcutsModel *model;
+    GPtrArray *paths;
+    GtkTreePath *selected_path;
+    gchar *contents = NULL;
+    BookmarkRaceHook hook = {
+      bookmarks_path,
+      external,
+      THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PREPARE,
+      FALSE,
+    };
+    gint warning_start;
+
+    write_bookmark_file (bookmarks_path, initial);
+    model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context_for (200);
+    paths = shortcut_paths (
+      GTK_TREE_MODEL (model),
+      THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+      TRUE);
+    g_assert_cmpuint (paths->len, ==, 2);
+    selected_path = gtk_tree_path_copy (g_ptr_array_index (paths, 1));
+    warning_start = g_atomic_int_get (&expected_bookmark_rebase_warning_count);
+    expect_bookmark_rebase_warnings = TRUE;
+    thunar_shortcuts_model_set_bookmark_write_test_hook (
+      bookmark_race_hook,
+      &hook);
+    thunar_shortcuts_model_remove (model, selected_path);
+    thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+    iterate_main_context_for (100);
+    expect_bookmark_rebase_warnings = FALSE;
+    g_assert_cmpint (g_atomic_int_get (&expected_bookmark_rebase_warning_count)
+                     - warning_start,
+                     ==,
+                     0);
+    g_assert_true (hook.fired);
+    g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+    g_assert_cmpstr (contents, ==, external);
+    g_free (contents);
+    gtk_tree_path_free (selected_path);
+    g_ptr_array_unref (paths);
+    g_clear_object (&model);
+    iterate_main_context_for (200);
+  }
+
+  /*
+   * An initially unique add anchor can become a duplicate before prepare.
+   * Reject the anchor rather than selecting one mutable occurrence.
+   */
+  {
+    g_autofree gchar *initial =
+      g_strdup_printf ("%s Existing\n%s Anchor\n", duplicate_uri, anchor_uri);
+    g_autofree gchar *external =
+      g_strdup_printf ("%s Existing\n%s New\n%s Anchor\n",
+                       duplicate_uri,
+                       anchor_uri,
+                       anchor_uri);
+    ThunarShortcutsModel *model;
+    GtkTreePath *anchor_path;
+    BookmarkRaceHook hook = {
+      bookmarks_path,
+      external,
+      THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PREPARE,
+      FALSE,
+    };
+    gchar *contents = NULL;
+    gint   warning_start;
+
+    write_bookmark_file (bookmarks_path, initial);
+    model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context_for (200);
+    anchor_path = find_bookmark_path (
+      GTK_TREE_MODEL (model),
+      anchor_uri);
+    g_assert_nonnull (anchor_path);
+    warning_start = g_atomic_int_get (&expected_bookmark_rebase_warning_count);
+    expect_bookmark_rebase_warnings = TRUE;
+    thunar_shortcuts_model_set_bookmark_write_test_hook (
+      bookmark_race_hook,
+      &hook);
+    thunar_shortcuts_model_add (model, anchor_path, add_file);
+    thunar_shortcuts_model_set_bookmark_write_test_hook (NULL, NULL);
+    iterate_main_context_for (100);
+    expect_bookmark_rebase_warnings = FALSE;
+    g_assert_cmpint (g_atomic_int_get (&expected_bookmark_rebase_warning_count)
+                     - warning_start,
+                     ==,
+                     1);
+    g_assert_true (hook.fired);
+    g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+    g_assert_cmpstr (contents, ==, external);
+    g_free (contents);
+    gtk_tree_path_free (anchor_path);
+    g_clear_object (&model);
+    iterate_main_context_for (200);
+  }
+
+  /*
+   * A stable four-row duplicate snapshot is intentionally resolved by the
+   * original node.  Context alone cannot identify either middle occurrence,
+   * but no refresh occurred here, so rename/remove must still affect exactly
+   * the selected rows.
+   */
+  {
+    g_autofree gchar *identical =
+      g_strdup_printf ("%s Dup\n%s Dup\n%s Dup\n%s Dup\n",
+                       duplicate_uri,
+                       duplicate_uri,
+                       duplicate_uri,
+                       duplicate_uri);
+    GPtrArray *identical_paths;
+    GtkTreeIter identical_iter;
+    GtkTreePath *remove_path;
+    gchar *expected;
+    gchar *contents = NULL;
+
+    write_bookmark_file (bookmarks_path, identical);
+    stable_model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+    iterate_main_context_for (200);
+    identical_paths = shortcut_paths (
+      GTK_TREE_MODEL (stable_model),
+      THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+      TRUE);
+    g_assert_cmpuint (identical_paths->len, ==, 4);
+    g_assert_true (gtk_tree_model_get_iter (
+      GTK_TREE_MODEL (stable_model),
+      &identical_iter,
+      g_ptr_array_index (identical_paths, 2)));
+    thunar_shortcuts_model_rename (stable_model, &identical_iter, "Middle");
+    expected = g_strdup_printf ("%s Dup\n%s Dup\n%s Middle\n%s Dup\n",
+                                duplicate_uri,
+                                duplicate_uri,
+                                duplicate_uri,
+                                duplicate_uri);
+    g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+    g_assert_cmpstr (contents, ==, expected);
+    g_free (expected);
+    g_free (contents);
+    contents = NULL;
+    remove_path = gtk_tree_path_copy (g_ptr_array_index (identical_paths, 1));
+    thunar_shortcuts_model_remove (stable_model, remove_path);
+    gtk_tree_path_free (remove_path);
+    g_assert_true (g_file_get_contents (bookmarks_path, &contents, NULL, NULL));
+    expected = g_strdup_printf ("%s Dup\n%s Middle\n%s Dup\n",
+                                duplicate_uri,
+                                duplicate_uri,
+                                duplicate_uri);
+    g_assert_cmpstr (contents, ==, expected);
+    g_free (expected);
+    g_free (contents);
+    g_ptr_array_unref (identical_paths);
+    g_clear_object (&stable_model);
+    iterate_main_context_for (200);
+  }
+
+  g_remove (bookmarks_path);
+}
