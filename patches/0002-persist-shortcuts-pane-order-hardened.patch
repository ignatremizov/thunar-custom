+static void
+copy_xfconf_dbus_service (void)
+{
+  const gchar *const *system_data_dirs;
+  GError             *error = NULL;
+  gboolean            found = FALSE;
+  guint               n;
+
+  system_data_dirs = g_get_system_data_dirs ();
+  for (n = 0; system_data_dirs[n] != NULL; ++n)
+    {
+      gchar *source;
+      gchar *destination;
+      gchar *contents = NULL;
+      gsize  length;
+
+      source = g_build_filename (system_data_dirs[n],
+                                 "dbus-1",
+                                 "services",
+                                 "org.xfce.Xfconf.service",
+                                 NULL);
+      if (g_file_get_contents (source, &contents, &length, NULL))
+        {
+          destination = g_build_filename (dbus_services_dir,
+                                          "org.xfce.Xfconf.service",
+                                          NULL);
+          g_assert_true (g_file_set_contents (destination,
+                                              contents,
+                                              length,
+                                              &error));
+          g_assert_no_error (error);
+          g_free (destination);
+          found = TRUE;
+        }
+      g_free (contents);
+      g_free (source);
+      if (found)
+        break;
+    }
+
+  g_assert_true (found);
