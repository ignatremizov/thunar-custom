+static void
+apply_row_move (ThunarShortcutGroup *groups,
+                const gchar       **order_ids,
+                gint                src_index,
+                gint                effective_dst_index)
+{
+  ThunarShortcutGroup moved_group = groups[src_index];
+  const gchar        *moved_id = order_ids[src_index];
+  gint                n;
+
+  if (src_index < effective_dst_index)
+    {
+      for (n = src_index; n < effective_dst_index; ++n)
+        {
+          groups[n] = groups[n + 1];
+          order_ids[n] = order_ids[n + 1];
+        }
+    }
+  else
+    {
+      for (n = src_index; n > effective_dst_index; --n)
+        {
+          groups[n] = groups[n - 1];
+          order_ids[n] = order_ids[n - 1];
+        }
+    }
+
+  groups[effective_dst_index] = moved_group;
+  order_ids[effective_dst_index] = moved_id;
+}
