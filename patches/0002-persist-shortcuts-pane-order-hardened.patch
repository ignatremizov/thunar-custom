+static GtkTreePath *
+find_bookmark_path (GtkTreeModel  *model,
+                    const gchar   *uri)
+{
+  GtkTreeIter iter;
+  gint        index = 0;
+
+  for (gboolean valid = gtk_tree_model_get_iter_first (model, &iter);
+       valid;
+       valid = gtk_tree_model_iter_next (model, &iter), ++index)
+    {
+      GFile *location = NULL;
+      gchar *candidate_uri;
+
+      gtk_tree_model_get (model,
+                          &iter,
+                          THUNAR_SHORTCUTS_MODEL_COLUMN_LOCATION,
+                          &location,
+                          -1);
+      candidate_uri = location != NULL ? g_file_get_uri (location) : NULL;
+      g_clear_object (&location);
+      if (g_strcmp0 (candidate_uri, uri) == 0)
+        {
+          g_free (candidate_uri);
+          return gtk_tree_path_new_from_indices (index, -1);
+        }
+      g_free (candidate_uri);
+    }
+
+  return NULL;
+}
