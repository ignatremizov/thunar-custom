+static void
+thunar_shortcuts_model_merge_bookmark_order (ThunarShortcutsModel *model,
+                                             GPtrArray             *bookmark_order)
+{
+  GPtrArray *merged;
+  guint      bookmark_position = 0;
+  guint      n;
+
+  if (model->places_order == NULL || bookmark_order == NULL)
+    return;
+
+  merged = g_ptr_array_new_with_free_func (g_free);
+  for (n = 0; model->places_order[n] != NULL; ++n)
+    {
+      if (g_str_has_prefix (model->places_order[n], "bookmark:"))
+        {
+          if (bookmark_position < bookmark_order->len)
+            g_ptr_array_add (merged,
+                             g_strdup (g_ptr_array_index (bookmark_order,
+                                                          bookmark_position++)));
+        }
+      else
+        {
+          g_ptr_array_add (merged, g_strdup (model->places_order[n]));
+        }
+    }
+
+  while (bookmark_position < bookmark_order->len)
+    g_ptr_array_add (merged,
+                     g_strdup (g_ptr_array_index (bookmark_order,
+                                                  bookmark_position++)));
+
+  g_ptr_array_add (merged, NULL);
+  g_strfreev (model->places_order);
+  model->places_order = (gchar **) g_ptr_array_free (merged, FALSE);
+
+  /* Re-evaluate built-in positions before loading the GTK bookmark rows. */
+  thunar_shortcuts_model_refresh_order_positions (model, THUNAR_SHORTCUT_SECTION_PLACES);
+}
+
+
+
+static GPtrArray *
+thunar_shortcuts_model_get_bookmark_order (ThunarShortcutsModel *model)
+{
+  GPtrArray      *bookmark_order;
+  GList          *lp;
+  ThunarShortcut *shortcut;
+  gchar          *order_id;
+
+  bookmark_order = g_ptr_array_new_with_free_func (g_free);
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      shortcut = lp->data;
+      if (shortcut->group != THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS
+          || shortcut->location == NULL)
+        continue;
+
+      order_id = thunar_shortcuts_model_get_bookmark_order_id (shortcut->location);
+      if (order_id != NULL
+          && !thunar_shortcuts_model_order_contains (bookmark_order, order_id))
+        g_ptr_array_add (bookmark_order, order_id);
+      else
+        g_free (order_id);
+    }
+
+  return bookmark_order;
+}
+
+
+
+static GPtrArray *
+thunar_shortcuts_model_get_bookmark_sequence (ThunarShortcutsModel *model)
+{
+  GPtrArray      *bookmark_sequence;
+  GList          *lp;
+  ThunarShortcut *shortcut;
+  gchar          *order_id;
+
+  bookmark_sequence = g_ptr_array_new_with_free_func (g_free);
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      shortcut = lp->data;
+      if (shortcut->group != THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS
+          || shortcut->location == NULL)
+        continue;
+
+      order_id = thunar_shortcuts_model_get_bookmark_order_id (shortcut->location);
+      if (order_id != NULL)
+        g_ptr_array_add (bookmark_sequence, order_id);
+      else
+        g_free (order_id);
+    }
+
+  return bookmark_sequence;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_bookmark_order_equal (GPtrArray *order_a,
+                                             GPtrArray *order_b)
+{
+  guint n;
+
+  if (order_a == order_b)
+    return TRUE;
+  if (order_a == NULL || order_b == NULL || order_a->len != order_b->len)
+    return FALSE;
+
+  for (n = 0; n < order_a->len; ++n)
+    if (g_strcmp0 (g_ptr_array_index (order_a, n),
+                   g_ptr_array_index (order_b, n)) != 0)
+      return FALSE;
+
+  return TRUE;
+}
+
+
+
+static GPtrArray *
+thunar_shortcuts_model_get_bookmark_entries_order (GPtrArray *entries)
+{
+  GPtrArray *bookmark_order;
+  guint      n;
+
+  bookmark_order = g_ptr_array_new_with_free_func (g_free);
+  for (n = 0; n < entries->len; ++n)
+    {
+      ThunarShortcutBookmark *bookmark;
+
+      bookmark = g_ptr_array_index (entries, n);
+      if (bookmark->order_id != NULL
+          && !thunar_shortcuts_model_order_contains (bookmark_order, bookmark->order_id))
+        g_ptr_array_add (bookmark_order, g_strdup (bookmark->order_id));
+    }
+
+  return bookmark_order;
+}
+
+
+
+static GPtrArray *
+thunar_shortcuts_model_get_persisted_bookmark_order (ThunarShortcutsModel *model)
+{
+  GPtrArray *bookmark_order;
+  guint      n;
+
+  bookmark_order = g_ptr_array_new_with_free_func (g_free);
+  if (model->places_order == NULL)
+    return bookmark_order;
+
+  for (n = 0; model->places_order[n] != NULL; ++n)
+    {
+      if (g_str_has_prefix (model->places_order[n], "bookmark:")
+          && !thunar_shortcuts_model_order_contains (bookmark_order, model->places_order[n]))
+        g_ptr_array_add (bookmark_order, g_strdup (model->places_order[n]));
+    }
+
+  return bookmark_order;
+}
+
+
+
+static gboolean
+thunar_shortcuts_model_bookmark_entries_equal (GPtrArray *entries_a,
+                                               GPtrArray *entries_b)
+{
+  guint n;
+
+  if (entries_a == entries_b)
+    return TRUE;
+  if (entries_a == NULL || entries_b == NULL || entries_a->len != entries_b->len)
+    return FALSE;
+
+  for (n = 0; n < entries_a->len; ++n)
+    {
+      ThunarShortcutBookmark *bookmark_a;
+      ThunarShortcutBookmark *bookmark_b;
+
+      bookmark_a = g_ptr_array_index (entries_a, n);
+      bookmark_b = g_ptr_array_index (entries_b, n);
+      if (g_strcmp0 (bookmark_a->order_id, bookmark_b->order_id) != 0
+          || g_strcmp0 (bookmark_a->name, bookmark_b->name) != 0)
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+
+
+static GPtrArray *
+thunar_shortcuts_model_snapshot_bookmarks (ThunarShortcutsModel *model)
+{
+  GPtrArray      *snapshot;
+  GList          *lp;
+  ThunarShortcut *shortcut;
+  guint           row_num = 1;
+
+  snapshot =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) thunar_shortcuts_model_bookmark_entry_free);
+  for (lp = model->shortcuts; lp != NULL; lp = lp->next)
+    {
+      ThunarShortcutBookmark *bookmark;
+      GFile                  *location;
+
+      shortcut = lp->data;
+      if (shortcut->group != THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS)
+        continue;
+
+      location = shortcut->location != NULL
+                   ? g_object_ref (shortcut->location)
+                   : (shortcut->file != NULL
+                        ? g_object_ref (thunar_file_get_file (shortcut->file))
+                        : NULL);
+      if (location == NULL)
+        continue;
+
+      bookmark = g_new0 (ThunarShortcutBookmark, 1);
+      bookmark->file = location;
+      bookmark->name = g_strdup (shortcut->name);
+      bookmark->row_num = row_num++;
+      bookmark->order_id = thunar_shortcuts_model_get_bookmark_order_id (location);
+      g_ptr_array_add (snapshot, bookmark);
+    }
+
+  return snapshot;
+}
+
+
+
+static void
+thunar_shortcuts_model_update_bookmark_snapshot (ThunarShortcutsModel *model)
+{
+  GPtrArray *snapshot;
+
+  snapshot = thunar_shortcuts_model_snapshot_bookmarks (model);
+  if (model->bookmark_snapshot != NULL)
+    g_ptr_array_unref (model->bookmark_snapshot);
+  model->bookmark_snapshot = snapshot;
+}
