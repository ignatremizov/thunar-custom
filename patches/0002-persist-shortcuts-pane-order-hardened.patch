+int
+main (int argc, char **argv)
+{
+  const gchar         *shared_root;
+  gchar              *config_dir;
+  gchar              *cache_dir;
+  gchar              *data_dir;
+  gchar              *runtime_dir;
+  gchar              *state_dir;
+  gchar              *gtk_dir;
+  GError             *error = NULL;
+  gint                result;
+  guint               n;
+
+  shared_root = g_getenv ("THUNAR_SHORTCUTS_VIEW_SHARED_ROOT");
+  shared_test_environment = shared_root != NULL;
+  if (shared_test_environment)
+    test_root = g_strdup (shared_root);
+  else
+    {
+      test_root = g_dir_make_tmp ("thunar-shortcuts-view-XXXXXX", &error);
+      g_assert_no_error (error);
+    }
+  g_assert_nonnull (test_root);
+
+  config_dir = g_build_filename (test_root, "config", NULL);
+  cache_dir = g_build_filename (test_root, "cache", NULL);
+  data_dir = g_build_filename (test_root, "data", NULL);
+  runtime_dir = g_build_filename (test_root, "runtime", NULL);
+  state_dir = g_build_filename (test_root, "state", NULL);
+  gtk_dir = g_build_filename (config_dir, "gtk-3.0", NULL);
+  g_assert_cmpint (g_mkdir_with_parents (gtk_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (cache_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (data_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (runtime_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir_with_parents (state_dir, 0700), ==, 0);
+  g_setenv ("HOME", test_root, TRUE);
+  g_setenv ("XDG_CONFIG_HOME", config_dir, TRUE);
+  g_setenv ("XDG_CACHE_HOME", cache_dir, TRUE);
+  g_setenv ("XDG_DATA_HOME", data_dir, TRUE);
+  g_setenv ("XDG_RUNTIME_DIR", runtime_dir, TRUE);
+  g_setenv ("XDG_STATE_HOME", state_dir, TRUE);
+  g_assert_true (g_str_has_prefix (g_get_home_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_config_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_cache_dir (), test_root));
+  g_assert_true (g_str_has_prefix (g_get_user_data_dir (), test_root));
+
+  dbus_services_dir = g_build_filename (test_root, "dbus-services", NULL);
+  if (!shared_test_environment)
+    {
+      g_assert_cmpint (g_mkdir_with_parents (dbus_services_dir, 0700), ==, 0);
+      copy_xfconf_dbus_service ();
+    }
+
+  bookmarks_path = g_build_filename (gtk_dir, "bookmarks", NULL);
+  for (n = 0; n < G_N_ELEMENTS (bookmark_uris); ++n)
+    {
+      gchar *directory;
+      GFile *file;
+
+      directory = g_strdup_printf ("%s/bookmark-%u", test_root, n);
+      g_assert_cmpint (g_mkdir_with_parents (directory, 0700), ==, 0);
+      file = g_file_new_for_path (directory);
+      bookmark_uris[n] = g_file_get_uri (file);
+      g_object_unref (file);
+      g_free (directory);
+    }
+  if (!shared_test_environment)
+    write_test_bookmarks ();
+
+  g_test_init (&argc, &argv, NULL);
+  g_setenv ("NO_AT_BRIDGE", "1", TRUE);
+  display_available = gtk_init_check (&argc, &argv);
+  /*
+   * Model setup intentionally has no thumbnailer on this private bus.  GLib
+   * structured logs bypass g_test_expect_message(), so accept only that exact
+   * unavailable-service warning and count every other warning as a failure.
+   */
+  g_log_set_always_fatal (G_LOG_LEVEL_ERROR);
+  g_log_set_writer_func (test_log_writer, NULL, NULL);
+  g_log_set_handler ("thunar",
+                     G_LOG_LEVEL_WARNING | G_LOG_LEVEL_CRITICAL,
+                     test_legacy_log_handler,
+                     NULL);
+  if (!shared_test_environment)
+    {
+      test_bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+      g_test_dbus_add_service_dir (test_bus, dbus_services_dir);
+      g_test_dbus_up (test_bus);
+    }
+  g_assert_true (xfconf_init (&error));
+  g_assert_no_error (error);
+
+  g_test_add_func ("/shortcuts-view/window-bookmark-monitor-teardown",
+                   test_window_bookmark_monitor_teardown);
+  g_test_add_func ("/shortcuts-view/model-and-filter-contracts",
+                   test_model_and_filter_contracts);
+  g_test_add_func ("/shortcuts-view/order-lock-contention-is-prompt-and-unchanged",
+                   test_order_lock_contention_is_prompt_and_unchanged);
+  g_test_add_func (
+    "/shortcuts-view/devices-contention-reconciles-coalesced-lifecycle-and-order",
+    test_devices_contention_reconciles_coalesced_lifecycle_and_order);
+  g_test_add_func ("/shortcuts-view/devices-contention-retry-teardown",
+                   test_devices_contention_retry_teardown);
+  g_test_add_func ("/shortcuts-view/devices-order-two-models-and-stale-noop",
+                   test_devices_order_two_models_and_stale_noop);
+  g_test_add_func ("/shortcuts-view/devices-order-uuidless-hidden-malformed-read",
+                   test_devices_order_uuidless_hidden_and_malformed_read);
+  g_test_add_func ("/shortcuts-view/devices-move-compare-retry",
+                   test_devices_move_compare_retry);
+  g_test_add_func ("/shortcuts-view/devices-callback-rollback-and-restart-claim",
+                   test_devices_callback_save_rollback_and_restart_claim);
+  g_test_add_func ("/shortcuts-view/model-guarded-bookmark-source-races",
+                   test_model_guarded_bookmark_source_races);
+  g_test_add_func ("/shortcuts-view/model-peer-recovers-pending-transaction",
+                   test_model_peer_recovers_pending_transaction);
+  g_test_add_func ("/shortcuts-view/model-dangling-alias-and-symlink-target-monitor",
+                   test_model_dangling_alias_and_symlink_target_monitor);
+  g_test_add_func ("/shortcuts-view/model-peer-recovery-worker",
+                   test_model_peer_recovery_worker);
+  g_test_add_func ("/shortcuts-view/model-duplicate-bookmark-rebase-is-bounded",
+                   test_model_duplicate_bookmark_rebase_is_bounded);
+  g_test_add_func ("/shortcuts-view/model-file-changed-duplicate-rebase-is-atomic",
+                   test_model_file_changed_duplicate_rebase_is_atomic);
+  g_test_add_func ("/shortcuts-view/pending-recovery-main-read-failure",
+                   test_pending_recovery_main_read_failure);
+  g_test_add_func ("/shortcuts-view/preferences-transport-failure",
+                   test_preferences_transport_failure);
+  g_test_add_func ("/shortcuts-view/preferences-transport-failure-worker",
+                   test_preferences_transport_failure_worker);
+  result = g_test_run ();
+  expect_pending_read_warnings = FALSE;
+  expect_window_bookmark_load_warnings = FALSE;
+  thunar_preferences_set_pending_order_test_read_failure (FALSE);
+
+  xfconf_shutdown ();
+  if (g_getenv ("THUNAR_SHORTCUTS_VIEW_SHARED_ROOT") != NULL
+      || g_getenv ("THUNAR_SHORTCUTS_VIEW_TRANSPORT_WORKER") != NULL)
+    iterate_main_context_for (1000);
+  if (g_getenv ("THUNAR_SHORTCUTS_VIEW_SHARED_ROOT") != NULL)
+    {
+      g_assert_cmpint (
+        g_atomic_int_get (&expected_xfconf_cancellation_warning_count)
+        - peer_cancellation_warning_start,
+        <=,
+        1);
+      expect_xfconf_cancellation_warnings = FALSE;
+    }
+  if (g_getenv ("THUNAR_SHORTCUTS_VIEW_TRANSPORT_WORKER") != NULL)
+    {
+      g_assert_cmpint (g_atomic_int_get (&expected_transport_failure_warning_count),
+                       ==,
+                       1);
+      expect_transport_failure_warnings = FALSE;
+    }
+  g_assert_cmpint (g_atomic_int_get (&unexpected_warning_count), ==, 0);
+  /*
+   * GIO keeps the session-bus connection in a process-global cache.  Stop the
+   * private daemon, but keep its controller alive until this test process exits
+   * instead of blocking in GTestDBus teardown on that cached connection.
+   */
+  if (!shared_test_environment)
+    g_test_dbus_stop (test_bus);
+  g_assert_cmpint (g_atomic_int_get (&unexpected_warning_count), ==, 0);
+  for (n = 0; n < G_N_ELEMENTS (bookmark_uris); ++n)
+    g_free (bookmark_uris[n]);
+  g_free (dbus_services_dir);
+  g_free (bookmarks_path);
+  g_free (gtk_dir);
+  g_free (runtime_dir);
+  g_free (state_dir);
+  g_free (data_dir);
+  g_free (cache_dir);
+  g_free (config_dir);
+  if (!shared_test_environment)
+    remove_tree (test_root);
+  g_free (test_root);
+  return result;
+}
