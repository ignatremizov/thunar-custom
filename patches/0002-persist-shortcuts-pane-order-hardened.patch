+static gint
+strv_index (const gchar *const *values,
+            const gchar        *wanted)
+{
+  if (values != NULL)
+    for (guint n = 0; values[n] != NULL; ++n)
+      if (g_strcmp0 (values[n], wanted) == 0)
+        return n;
+
+  return -1;
+}
