+static gboolean
+thunar_shortcuts_model_retry_bookmark_monitors (gpointer user_data)
+{
+  ThunarShortcutsModel *model = THUNAR_SHORTCUTS_MODEL (user_data);
+
+  _thunar_return_val_if_fail (THUNAR_IS_SHORTCUTS_MODEL (model),
+                              G_SOURCE_REMOVE);
+  model->bookmarks_monitor_retry_id = 0;
+  thunar_shortcuts_model_arm_bookmark_monitor (model, FALSE);
+  thunar_shortcuts_model_arm_bookmark_monitor (model, TRUE);
+  if ((model->bookmarks_monitor == NULL
+       && model->bookmarks_parent_monitor == NULL)
+      || (model->legacy_bookmarks_monitor == NULL
+          && model->legacy_bookmarks_parent_monitor == NULL))
+    thunar_shortcuts_model_schedule_bookmark_monitor_retry (model);
+  else
+    model->bookmarks_monitor_retry_attempt = 0;
+  return G_SOURCE_REMOVE;
+}
