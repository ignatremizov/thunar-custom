+    {
+      g_atomic_int_inc (&expected_bookmark_rebase_warning_count);
+      g_free (message);
+      g_free (domain);
+      return G_LOG_WRITER_HANDLED;
+    }
+
+  if (expect_window_bookmark_load_warnings
+      && (log_level & G_LOG_LEVEL_MASK) == G_LOG_LEVEL_WARNING
+      && g_strcmp0 (domain, "thunar") == 0
+      && message != NULL
+      && g_str_has_prefix (message, "Failed to reconcile GTK bookmarks: "))
+    {
+      g_atomic_int_inc (&expected_window_bookmark_load_warning_count);
+      g_free (message);
+      g_free (domain);
+      return G_LOG_WRITER_HANDLED;
+    }
+
+  if ((log_level & (G_LOG_LEVEL_WARNING | G_LOG_LEVEL_CRITICAL)) != 0)
+    g_atomic_int_inc (&unexpected_warning_count);
+  g_free (message);
+  g_free (domain);
+  return g_log_writer_default (log_level, fields, n_fields, NULL);
+}
+
+
+
+static void
+test_legacy_log_handler (const gchar   *log_domain,
+                         GLogLevelFlags log_level,
+                         const gchar   *message,
+                         gpointer       user_data)
+{
+  const GLogField fields[] = {
+    { "GLIB_DOMAIN", log_domain, -1 },
+    { "MESSAGE", message, -1 },
+  };
+
+  test_log_writer (log_level, fields, G_N_ELEMENTS (fields), user_data);
+}
