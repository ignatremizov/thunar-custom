+static GLogWriterOutput
+test_log_writer (GLogLevelFlags   log_level,
+                 const GLogField *fields,
+                 gsize            n_fields,
+                 gpointer         user_data)
+{
+  gchar *domain;
+  gchar *message;
+
+  (void) user_data;
+
+  domain = log_field_dup (fields, n_fields, "GLIB_DOMAIN");
+  message = log_field_dup (fields, n_fields, "MESSAGE");
+  if ((log_level & G_LOG_LEVEL_MASK) == G_LOG_LEVEL_WARNING
+      && g_strcmp0 (domain, "thunar") == 0
+      && message != NULL
+      && g_str_has_prefix (
+        message,
+        "ThunarThumbnailer: Failed to retrieve supported types:"))
+    {
+      g_atomic_int_inc (&expected_warning_count);
+      g_free (message);
+      g_free (domain);
+      return G_LOG_WRITER_HANDLED;
+    }
+
+  if (expect_write_failure_warnings
+      && (log_level & G_LOG_LEVEL_MASK) == G_LOG_LEVEL_WARNING
