+static void
+thunar_shortcuts_model_free_device_ordering_entry (gpointer data)
+{
+  ThunarDeviceOrderingEntry *entry = data;
+
+  g_free (entry->order_id);
+  g_free (entry->prior_order_id);
+  g_free (entry);
+}
