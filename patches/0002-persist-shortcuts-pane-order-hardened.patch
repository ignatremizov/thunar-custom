+static void
+test_dual_bookmark_monitors_and_teardown (void)
+{
+  g_autofree gchar *uri_legacy_a = make_uri ("monitor-legacy-a");
+  g_autofree gchar *uri_legacy_b = make_uri ("monitor-legacy-b");
+  g_autofree gchar *uri_legacy_c = make_uri ("monitor-legacy-c");
+  g_autofree gchar *uri_canonical_a = make_uri ("monitor-canonical-a");
+  g_autofree gchar *uri_canonical_b = make_uri ("monitor-canonical-b");
+  g_autofree gchar *legacy_path =
+    g_build_filename (g_get_home_dir (), ".gtk-bookmarks", NULL);
+  ThunarShortcutsModel *model = NULL;
+  GtkTreePath *path;
+  ModelMonitorTeardown teardown = { &model, FALSE, 0 };
+  g_autofree gchar *gtk_dir = g_path_get_dirname (bookmarks_path);
+  g_autofree gchar *config_dir = g_path_get_dirname (gtk_dir);
+
+  g_remove (bookmarks_path);
+  g_assert_cmpint (g_rmdir (gtk_dir), ==, 0);
+  remove_tree (config_dir);
+  write_bookmark_line (legacy_path, uri_legacy_a, "Legacy A");
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+  path = find_bookmark_path (GTK_TREE_MODEL (model), uri_legacy_a);
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+
+  write_bookmark_line (legacy_path, uri_legacy_b, "Legacy B");
+  iterate_main_context_for (300);
+  path = find_bookmark_path (GTK_TREE_MODEL (model), uri_legacy_b);
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+
+  /*
+   * Create each ancestor separately.  The model must move its monitor from
+   * HOME to XDG_CONFIG_HOME and then to gtk-3.0 as each level appears.
+   */
+  g_assert_cmpint (g_mkdir (config_dir, 0700), ==, 0);
+  iterate_main_context_for (150);
+  g_assert_cmpint (g_mkdir (gtk_dir, 0700), ==, 0);
+  iterate_main_context_for (100);
+  write_bookmark_line (bookmarks_path, uri_canonical_a, "Canonical A");
+  write_bookmark_line (legacy_path, uri_legacy_c, "Legacy C");
+  write_bookmark_line (bookmarks_path, uri_canonical_b, "Canonical B");
+  iterate_main_context_for (500);
+  path = find_bookmark_path (GTK_TREE_MODEL (model), uri_canonical_b);
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+  g_assert_null (find_bookmark_path (GTK_TREE_MODEL (model), uri_legacy_c));
+
+  /*
+   * Removing the containing directory invalidates the direct pathname
+   * monitor.  Re-arm from the surviving ancestor, then walk the directory
+   * back into existence and prove that both the first recreation and a later
+   * edit still reach the model.
+   */
+  g_assert_cmpint (g_remove (bookmarks_path), ==, 0);
+  g_assert_cmpint (g_rmdir (gtk_dir), ==, 0);
+  iterate_main_context_for (300);
+  g_assert_cmpint (g_mkdir (gtk_dir, 0700), ==, 0);
+  iterate_main_context_for (300);
+  write_bookmark_line (bookmarks_path, uri_canonical_a, "Recreated A");
+  iterate_main_context_for (400);
+  path = find_bookmark_path (GTK_TREE_MODEL (model), uri_canonical_a);
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+  g_assert_null (find_bookmark_path (GTK_TREE_MODEL (model), uri_canonical_b));
+  write_bookmark_line (bookmarks_path, uri_canonical_b, "Recreated B");
+  iterate_main_context_for (400);
+  path = find_bookmark_path (GTK_TREE_MODEL (model), uri_canonical_b);
+  g_assert_nonnull (path);
+  gtk_tree_path_free (path);
+
+  /*
+   * The monitor hook runs only after the callback has queued its coalesced
+   * idle.  Let the self-save suppression window expire first so this is an
+   * idle rather than its delayed retry timer.  Destroy from that hook and
+   * then drain the main context to prove the queued callback is harmless.
+   */
+  iterate_main_context_for (2200);
+  teardown.queued = FALSE;
+  thunar_shortcuts_model_set_bookmark_monitor_test_hook (
+    model_monitor_teardown_hook,
+    &teardown);
+  write_bookmark_line (bookmarks_path, uri_canonical_a, "Canonical A");
+  iterate_main_context_for (300);
+  thunar_shortcuts_model_set_bookmark_monitor_test_hook (NULL, NULL);
+  g_assert_true (teardown.queued);
+  g_assert_null (model);
+  iterate_main_context_for (300);
+  g_remove (bookmarks_path);
+  g_remove (legacy_path);
+}
