+static void
+test_pending_recovery_main_read_failure (void)
+{
+  const gchar *pending_order[] = {
+    "thunar-places-order-pending-v1",
+    "bookmark:file:///pending-recovery",
+    NULL,
+  };
+  ThunarPreferences *preferences;
+  ThunarShortcutsModel *model;
+  gchar **original_order = NULL;
+  gchar **durable_pending = NULL;
+  gint warning_start;
+
+  write_bookmark_file (bookmarks_path, "file:///pending-recovery\n");
+  preferences = thunar_preferences_get ();
+  g_object_get (preferences,
+                "shortcuts-places-order", &original_order,
+                NULL);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  iterate_main_context_for (200);
+
+  g_object_set (preferences,
+                "shortcuts-places-order-pending", pending_order,
+                NULL);
+
+  /*
+   * Recovery must not write or clear the durable pending vector when its
+   * main-order input is unreadable, even though the pending property itself
+   * is readable.
+   */
+  warning_start = g_atomic_int_get (&expected_pending_read_warning_count);
+  expect_pending_read_warnings = TRUE;
+  thunar_preferences_set_main_order_test_read_failure (TRUE);
+  thunar_shortcuts_model_reload (model);
+  iterate_main_context_for (100);
+  thunar_preferences_set_main_order_test_read_failure (FALSE);
+  expect_pending_read_warnings = FALSE;
+  g_assert_cmpint (g_atomic_int_get (&expected_pending_read_warning_count)
+                   - warning_start,
+                   ==,
+                   1);
+  g_object_get (preferences,
+                "shortcuts-places-order-pending", &durable_pending,
+                NULL);
+  g_assert_nonnull (durable_pending);
+  g_assert_cmpstr (durable_pending[0], ==, pending_order[0]);
+  g_strfreev (durable_pending);
+
+  g_object_set (preferences,
+                "shortcuts-places-order",
+                original_order,
+                NULL);
+  /*
+   * No explicit reload is needed here: the failed recovery schedules a
+   * bounded retry, which must discharge the durable journal once the
+   * injected read failure is removed.
+   */
+  iterate_main_context_for (1000);
+  g_object_get (preferences,
+                "shortcuts-places-order-pending", &durable_pending,
+                NULL);
+  g_assert_null (durable_pending);
+
+  g_strfreev (durable_pending);
+  g_strfreev (original_order);
+  g_object_unref (model);
+  g_object_unref (preferences);
+  g_remove (bookmarks_path);
+}
