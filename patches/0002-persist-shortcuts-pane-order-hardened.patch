+static void
+test_places_order_recovery_crash_windows (void)
+{
+  const gchar *old_main[] = {
+    "place:recent",
+    "bookmark:file:///a",
+    "place:home",
+    "bookmark:file:///b",
+    "place:trash",
+    NULL,
+  };
+  const gchar *pending[] = {
+    "place:recent",
+    "bookmark:file:///b",
+    "place:home",
+    "bookmark:file:///a",
+    "bookmark:file:///c",
+    "place:trash",
+    NULL,
+  };
+  const gchar *old_gtk[] = {
+    "bookmark:file:///a",
+    "bookmark:file:///b",
+    NULL,
+  };
+  const gchar *new_gtk[] = {
+    "bookmark:file:///b",
+    "bookmark:file:///a",
+    "bookmark:file:///c",
+    NULL,
+  };
+  const gchar *external_gtk[] = {
+    "bookmark:file:///external",
+    "bookmark:file:///b",
+    "bookmark:file:///extra",
+    NULL,
+  };
+  const gchar *external_expected[] = {
+    "place:recent",
+    "bookmark:file:///external",
+    "place:home",
+    "bookmark:file:///b",
+    "place:trash",
+    "bookmark:file:///extra",
+    NULL,
+  };
+  ThunarPlacesOrderRecovery recovery;
+  gchar **resolved;
+
+  /* Crash before GTK mutation: old GTK does not validate pending intent. */
+  resolved = thunar_shortcuts_model_recover_places_order (
+    old_main, pending, old_gtk, &recovery);
+  g_assert_cmpint (recovery, ==, THUNAR_PLACES_ORDER_RECOVERY_CLEAR_PENDING);
+  assert_strv (resolved, old_main);
+  g_strfreev (resolved);
+
+  /* Crash after GTK mutation but before main: matching GTK promotes pending. */
+  resolved = thunar_shortcuts_model_recover_places_order (
+    old_main, pending, new_gtk, &recovery);
+  g_assert_cmpint (recovery, ==, THUNAR_PLACES_ORDER_RECOVERY_PROMOTE_PENDING);
+  assert_strv (resolved, pending);
+  g_strfreev (resolved);
+
+  /* Crash after main commit: the redundant pending vector is only cleared. */
+  resolved = thunar_shortcuts_model_recover_places_order (
+    pending, pending, new_gtk, &recovery);
+  g_assert_cmpint (recovery, ==, THUNAR_PLACES_ORDER_RECOVERY_CLEAR_PENDING);
+  assert_strv (resolved, pending);
+  g_strfreev (resolved);
+
+  /*
+   * A different external GTK sequence invalidates pending.  Preserve the
+   * external canonical order while retaining the old integrated slot shape.
+   */
+  resolved = thunar_shortcuts_model_recover_places_order (
+    old_main, pending, external_gtk, &recovery);
+  g_assert_cmpint (recovery, ==, THUNAR_PLACES_ORDER_RECOVERY_CLEAR_PENDING);
+  assert_strv (resolved, external_expected);
+  g_strfreev (resolved);
+}
