+static void
+test_immediate_successor_is_noop (void)
+{
+  ThunarShortcutGroup groups[] = {
+    THUNAR_SHORTCUT_GROUP_PLACES_HEADER,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_DEVICES_HEADER,
+  };
+  const gchar *order_ids[] = {
+    NULL,
+    "place:a",
+    "place:b",
+    NULL,
+  };
+  ThunarShortcutMoveRequest request = {
+    0,
+  };
+  const gchar *refreshed_order_ids[] = {
+    NULL,
+    "place:b",
+    "place:a",
+    NULL,
+  };
+  const ThunarShortcutGroup refreshed_groups[] = {
+    THUNAR_SHORTCUT_GROUP_PLACES_HEADER,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+    THUNAR_SHORTCUT_GROUP_DEVICES_HEADER,
+  };
+  gint refreshed_src;
+  gint refreshed_dst;
+  gint refreshed_effective_dst;
+
+  /* The destination is the source's immediate successor in the original
+   * model.  It is a valid drop, but the effective destination is unchanged. */
+  assert_move (groups, order_ids, G_N_ELEMENTS (groups), 1, 2, TRUE, 1);
+  g_assert_true (thunar_shortcuts_model_capture_move_request_for_rows (
+    groups,
+    order_ids,
+    NULL,
+    G_N_ELEMENTS (groups),
+    1,
+    2,
+    &request));
+  g_assert_true (request.no_op);
+  /*
+   * The no-op decision belongs after Places prepare/rebase.  If another
+   * writer swaps the adjacent rows while this request waits, the same
+   * captured relation is now a real move rather than a stale no-op.
+   */
+  g_assert_true (thunar_shortcuts_model_rebase_move_request_for_rows (
+    refreshed_groups,
+    refreshed_order_ids,
+    NULL,
+    G_N_ELEMENTS (refreshed_groups),
+    &request,
+    &refreshed_src,
+    &refreshed_dst,
+    &refreshed_effective_dst));
+  g_assert_cmpint (refreshed_src, ==, 2);
+  g_assert_cmpint (refreshed_dst, ==, 1);
+  g_assert_cmpint (refreshed_effective_dst, ==, 1);
+  g_assert_cmpint (refreshed_effective_dst, !=, refreshed_src);
+  thunar_shortcuts_model_clear_move_request (&request);
+}
