+static void
+test_staging_path_is_removed_after_stream_failure (void)
+{
+#ifdef G_OS_UNIX
+  g_autofree gchar *case_dir = make_case_dir ("staged-stream-failure");
+  g_autofree gchar *target_path = g_build_filename (case_dir, "bookmarks", NULL);
+  g_autoptr (GFile) target_file = g_file_new_for_path (target_path);
+  struct rlimit saved_limit;
+  struct rlimit limited;
+  struct sigaction ignore_action = {
+    0,
+  };
+  struct sigaction saved_action;
+  gchar *new_etag = NULL;
+  GError *error = NULL;
+  gboolean success;
+
+  g_assert_cmpint (getrlimit (RLIMIT_FSIZE, &saved_limit), ==, 0);
+  ignore_action.sa_handler = SIG_IGN;
+  g_assert_cmpint (sigemptyset (&ignore_action.sa_mask), ==, 0);
+  g_assert_cmpint (sigaction (SIGXFSZ, &ignore_action, &saved_action), ==, 0);
+
+  limited = saved_limit;
+  limited.rlim_cur = 0;
+  g_assert_cmpint (setrlimit (RLIMIT_FSIZE, &limited), ==, 0);
+  success = thunar_util_create_file_atomically (
+    target_file,
+    "file:///must-not-survive\n",
+    strlen ("file:///must-not-survive\n"),
+    &new_etag,
+    &error);
+  g_assert_cmpint (setrlimit (RLIMIT_FSIZE, &saved_limit), ==, 0);
+  g_assert_cmpint (sigaction (SIGXFSZ, &saved_action, NULL), ==, 0);
+
+  g_assert_false (success);
+  g_assert_error (error, G_FILE_ERROR, G_FILE_ERROR_IO);
+  g_assert_null (new_etag);
+  g_assert_false (g_file_test (target_path, G_FILE_TEST_EXISTS));
+  assert_no_staging_files (case_dir);
+  g_clear_error (&error);
+#else
+  g_test_skip ("requires RLIMIT_FSIZE and SIGXFSZ");
+#endif
+}
