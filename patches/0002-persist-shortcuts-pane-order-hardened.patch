+ThunarPreferencesPropertyState
+thunar_preferences_query_property (ThunarPreferences *preferences,
+                                   const gchar       *prop_name,
+                                   GError           **error)
+{
+  GVariant *reply;
+  gboolean  exists;
+
+  _thunar_return_val_if_fail (THUNAR_IS_PREFERENCES (preferences),
+                              THUNAR_PREFERENCES_PROPERTY_ERROR);
+  _thunar_return_val_if_fail (prop_name != NULL,
+                              THUNAR_PREFERENCES_PROPERTY_ERROR);
+  _thunar_return_val_if_fail (error == NULL || *error == NULL,
+                              THUNAR_PREFERENCES_PROPERTY_ERROR);
+
+  if (preferences->channel == NULL)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_FAILED,
+                           "Xfconf channel is unavailable");
+      return THUNAR_PREFERENCES_PROPERTY_ERROR;
+    }
+  if (g_test_initialized ()
+      && pending_order_test_read_failure
+      && g_strcmp0 (prop_name, "/shortcuts-places-order-pending") == 0)
+    {
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           G_IO_ERROR_FAILED,
+                           "Injected Xfconf property lookup failure");
+      return THUNAR_PREFERENCES_PROPERTY_ERROR;
+    }
+
+  reply = thunar_preferences_call_xfconf (
+    preferences,
+    "PropertyExists",
+    g_variant_new ("(ss)", "thunar", prop_name),
+    G_VARIANT_TYPE ("(b)"),
+    error);
+  if (reply == NULL)
+    return THUNAR_PREFERENCES_PROPERTY_ERROR;
+
+  g_variant_get (reply, "(b)", &exists);
+  g_variant_unref (reply);
+  return exists
+    ? THUNAR_PREFERENCES_PROPERTY_PRESENT
+    : THUNAR_PREFERENCES_PROPERTY_ABSENT;
+}
