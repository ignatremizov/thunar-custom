+static void
+test_order_lock_contention_is_prompt_and_unchanged (void)
+{
+  const gchar *baseline[] = {
+    "device:filesystem",
+    "device:a",
+    "device:b",
+    NULL,
+  };
+  g_autoptr (TestVolume) volume_a =
+    test_volume_new ("A", "a", "/dev/test-contention-a", NULL);
+  g_autoptr (TestVolume) volume_b =
+    test_volume_new ("B", "b", "/dev/test-contention-b", NULL);
+  g_autoptr (ThunarDevice) device_a = test_device_new (volume_a);
+  g_autoptr (ThunarDevice) device_b = test_device_new (volume_b);
+  ThunarDevice *devices[] = {
+    device_a,
+    device_b,
+  };
+  g_autoptr (ThunarPreferences) preferences = thunar_preferences_get ();
+  ThunarDeviceMonitor *monitor = thunar_device_monitor_get ();
+  ThunarShortcutsModel *model;
+  GtkTreePath *source;
+  GtkTreePath *anchor;
+  gchar      **stored;
+  gint         lock_fd;
+  guint        heartbeats = 0;
+  guint        heartbeat_id;
+  gint64       started;
+  gint64       elapsed;
+
+  g_object_set (preferences,
+                "shortcuts-devices-order", baseline,
+                NULL);
+  model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  emit_test_devices (monitor, devices, G_N_ELEMENTS (devices));
+  g_assert_true (device_precedes (GTK_TREE_MODEL (model),
+                                  device_a,
+                                  device_b));
+  stored = read_devices_order (preferences);
+  g_assert_true (test_strv_equal ((const gchar *const *) stored, baseline));
+  g_strfreev (stored);
+
+  lock_fd = hold_order_lock ("devices-order-write.lock");
+  source = device_path (GTK_TREE_MODEL (model), device_b);
+  anchor = device_path (GTK_TREE_MODEL (model), device_a);
+  heartbeat_id = g_timeout_add (1, contention_heartbeat, &heartbeats);
+  started = g_get_monotonic_time ();
+  g_assert_false (thunar_shortcuts_model_move (model, source, anchor, NULL));
+  elapsed = g_get_monotonic_time () - started;
+  g_assert_cmpint (elapsed, <, 500 * 1000);
+  iterate_main_context_for (50);
+  g_assert_cmpuint (heartbeats, >, 0);
+  g_assert_true (device_precedes (GTK_TREE_MODEL (model),
+                                  device_a,
+                                  device_b));
+  stored = read_devices_order (preferences);
+  g_assert_true (test_strv_equal ((const gchar *const *) stored, baseline));
+  g_strfreev (stored);
+
+  close (lock_fd);
+  gtk_tree_path_free (source);
+  gtk_tree_path_free (anchor);
+  source = device_path (GTK_TREE_MODEL (model), device_b);
+  anchor = device_path (GTK_TREE_MODEL (model), device_a);
+  g_assert_true (thunar_shortcuts_model_move (model, source, anchor, NULL));
+  stored = read_devices_order (preferences);
+  g_assert_cmpint (strv_index ((const gchar *const *) stored, "device:b"),
+                   <,
+                   strv_index ((const gchar *const *) stored, "device:a"));
+  g_strfreev (stored);
+  g_source_remove (heartbeat_id);
+  gtk_tree_path_free (source);
+  gtk_tree_path_free (anchor);
+  g_object_set (preferences,
+                "shortcuts-devices-order", NULL,
+                NULL);
+  g_clear_object (&model);
+  g_object_unref (monitor);
+}
