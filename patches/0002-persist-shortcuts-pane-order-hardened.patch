+static void
+pending_read_failure_hook (ThunarShortcutsModel                       *model,
+                           ThunarShortcutsModelBookmarkWriteHookPoint  point,
+                           gpointer                                    user_data)
+{
+  (void) model;
+  (void) user_data;
+  if (point == THUNAR_SHORTCUTS_MODEL_BOOKMARK_WRITE_PUBLICATION)
+    thunar_preferences_set_pending_order_test_read_failure (TRUE);
+}
