+    "bookmark:file:///a",
+    NULL,
+  };
+  ThunarShortcutMoveRequest hidden_request = {
+    0,
+  };
+  gint effective_destination;
+  gchar **resolved;
+
+  /* A represented device may move within its side of the UUID-less row, but
+   * may not cross it in either direction. */
+  assert_move (device_groups,
+               device_ids,
+               G_N_ELEMENTS (device_groups),
+               2,
+               4,
+               TRUE,
+               3);
+  assert_move (device_groups,
+               device_ids,
