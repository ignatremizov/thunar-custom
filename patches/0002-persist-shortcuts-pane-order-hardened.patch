+static void
+test_preferences_transport_failure_worker (void)
+{
+  ThunarPreferences             *preferences;
+  GDBusConnection               *connection;
+  GError                        *error = NULL;
+  GVariant                      *reply;
+  gchar                         *owner = NULL;
+  guint32                        pid;
+  gchar                         *service_file;
+  ThunarPreferencesPropertyState state;
+  gboolean                       has_owner = TRUE;
+  gint64                         deadline;
+
+  if (g_getenv ("THUNAR_SHORTCUTS_VIEW_TRANSPORT_WORKER") == NULL)
+    {
+      g_test_skip ("worker is only run by the transport-failure parent test");
+      return;
+    }
+
+  /*
+   * Stop the private Xfconf service for real and remove its private
+   * activation file.  Without the latter, the next call would transparently
+   * start a fresh daemon and turn the transport failure into a false success.
+   */
+  preferences = thunar_preferences_get ();
+  connection = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  g_assert_nonnull (connection);
+  reply = g_dbus_connection_call_sync (
+    connection,
+    "org.freedesktop.DBus",
+    "/org/freedesktop/DBus",
+    "org.freedesktop.DBus",
+    "GetNameOwner",
+    g_variant_new ("(s)", "org.xfce.Xfconf"),
+    G_VARIANT_TYPE ("(s)"),
+    G_DBUS_CALL_FLAGS_NONE,
+    5000,
+    NULL,
+    &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (reply);
+  g_variant_get (reply, "(s)", &owner);
+  g_variant_unref (reply);
+  service_file = g_build_filename (
+    dbus_services_dir,
+    "org.xfce.Xfconf.service",
+    NULL);
+  g_assert_cmpint (g_remove (service_file), ==, 0);
+  g_free (service_file);
+  reply = g_dbus_connection_call_sync (
+    connection,
+    "org.freedesktop.DBus",
+    "/org/freedesktop/DBus",
+    "org.freedesktop.DBus",
+    "ReloadConfig",
+    NULL,
+    G_VARIANT_TYPE_UNIT,
+    G_DBUS_CALL_FLAGS_NONE,
+    1000,
+    NULL,
+    &error);
+  /*
+   * Some GTestDBus versions remove the generated config before entering a
+   * trapped subprocess.  The daemon is already using the private bus; a
+   * missing reload file is therefore harmless, while every other transport
+   * failure remains a test error.
+   */
+  if (reply == NULL
+      && g_error_matches (error,
+                          G_DBUS_ERROR,
+                          G_DBUS_ERROR_FILE_NOT_FOUND))
+    g_clear_error (&error);
+  else
+    {
+      g_assert_no_error (error);
+      g_assert_nonnull (reply);
+    }
+  g_clear_pointer (&reply, g_variant_unref);
+  reply = g_dbus_connection_call_sync (
+    connection,
+    "org.freedesktop.DBus",
+    "/org/freedesktop/DBus",
+    "org.freedesktop.DBus",
+    "GetConnectionUnixProcessID",
+    g_variant_new ("(s)", owner),
+    G_VARIANT_TYPE ("(u)"),
+    G_DBUS_CALL_FLAGS_NONE,
+    5000,
+    NULL,
+    &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (reply);
+  g_variant_get (reply, "(u)", &pid);
+  g_variant_unref (reply);
+  g_assert_cmpint (kill ((pid_t) pid, SIGTERM), ==, 0);
+  deadline = g_get_monotonic_time () + G_USEC_PER_SEC;
+  while (has_owner && g_get_monotonic_time () < deadline)
+    {
+      reply = g_dbus_connection_call_sync (
+        connection,
+        "org.freedesktop.DBus",
+        "/org/freedesktop/DBus",
+        "org.freedesktop.DBus",
+        "NameHasOwner",
+        g_variant_new ("(s)", "org.xfce.Xfconf"),
+        G_VARIANT_TYPE ("(b)"),
+        G_DBUS_CALL_FLAGS_NONE,
+        1000,
+        NULL,
+        &error);
+      g_assert_no_error (error);
+      g_assert_nonnull (reply);
+      g_variant_get (reply, "(b)", &has_owner);
+      g_variant_unref (reply);
+      if (has_owner)
+        g_usleep (10 * 1000);
+    }
+  g_assert_false (has_owner);
+  g_free (owner);
+  g_object_unref (connection);
+  state = thunar_preferences_query_property (
+    preferences,
+    "/shortcuts-places-order-pending",
+    &error);
+  g_assert_cmpint (state, ==, THUNAR_PREFERENCES_PROPERTY_ERROR);
+  g_assert_nonnull (error);
+  g_clear_error (&error);
+  {
+    gchar **unreadable_order = NULL;
+    const gchar *devices_order[] = {
+      "device:filesystem",
+      "device:transport-write",
+      NULL,
+    };
+
+    g_assert_false (thunar_preferences_get_string_list (
+      preferences,
+      "/shortcuts-devices-order",
+      &unreadable_order,
+      &error));
+    g_assert_null (unreadable_order);
+    g_assert_nonnull (error);
+    g_clear_error (&error);
+    g_assert_false (thunar_preferences_set_string_list (
+      preferences,
+      "/shortcuts-devices-order",
+      devices_order,
+      &error));
+    g_assert_nonnull (error);
+    g_clear_error (&error);
+  }
+  expect_transport_failure_warnings = TRUE;
+  g_object_unref (preferences);
+}
