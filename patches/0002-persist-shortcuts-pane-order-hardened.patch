+typedef struct
+{
+  const gchar *const *durable_order;
+  guint               writes;
+} DeviceWriteConflict;
+
+typedef struct
+{
+  const gchar *const *competing_order;
+  guint               writes;
+} DeviceMoveConflict;
+
+
+
+static void
+device_write_conflict_hook (
+  ThunarShortcutsModel                          *model,
+  ThunarShortcutsModelDeviceOrderWriteHookPoint  point,
+  gpointer                                       user_data)
+{
+  DeviceWriteConflict *conflict = user_data;
+
+  (void) model;
+  if (point == THUNAR_SHORTCUTS_MODEL_DEVICE_ORDER_WRITE_COMPLETE)
+    {
+      ThunarPreferences *preferences = thunar_preferences_get ();
+
+      ++conflict->writes;
+      g_object_set (preferences,
+                    "shortcuts-devices-order", conflict->durable_order,
+                    NULL);
+      g_object_unref (preferences);
+    }
+}
+
+
+
+static void
+device_move_conflict_hook (
+  ThunarShortcutsModel                          *model,
+  ThunarShortcutsModelDeviceOrderWriteHookPoint  point,
+  gpointer                                       user_data)
+{
+  DeviceMoveConflict *conflict = user_data;
+
+  (void) model;
+  if (point == THUNAR_SHORTCUTS_MODEL_DEVICE_ORDER_WRITE_COMPLETE)
+    {
+      ++conflict->writes;
+      if (conflict->writes == 1)
+        {
+          ThunarPreferences *preferences = thunar_preferences_get ();
+
+          g_object_set (preferences,
+                        "shortcuts-devices-order",
+                        conflict->competing_order,
+                        NULL);
+          g_object_unref (preferences);
+        }
+    }
+}
