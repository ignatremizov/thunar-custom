+
+
+static void
+test_model_and_filter_contracts (void)
+{
+  ThunarShortcutsModel *shortcuts_model;
+  GtkTreeModel         *model;
+  GtkTreeModel         *filter;
+  GPtrArray            *paths;
+  GtkTreePath          *src_path;
+  GtkTreePath          *dst_path;
+  GtkTreePath          *devices_path;
+  GtkTreePath          *network_path;
+  GtkTreePath          *filtered_src_path;
+  GtkTreePath          *filtered_dst_path;
+  GtkTreePath          *following_path;
+  GtkTreePath          *direct_child_dst;
+  GtkTreePath          *resolved_path;
+  GtkTreePath          *moved_path;
+  GtkTreePath          *current_path;
+  GtkTreePath          *invalid_path;
+  GtkTreeIter           persistent_iter;
+  GtkTreeIter           hidden_iter;
+  ReorderProbe          probe;
+  ThunarPreferences    *preferences;
+  GFile                *source_location = NULL;
+  gchar               **order = NULL;
+  gchar               **reversed_order;
+  gchar                *bookmarks_contents = NULL;
+  gsize                 order_length;
+  guint                 emissions_after_move;
+  guint                 n;
+  gboolean              visible;
+  gulong                signal_id;
+
+  shortcuts_model = g_object_new (THUNAR_TYPE_SHORTCUTS_MODEL, NULL);
+  thunar_shortcuts_model_reload (shortcuts_model);
+  iterate_main_context_for (100);
+  /*
+   * The 4.18 thumbnailer reports an unavailable proxy directly to stderr
+   * instead of emitting the later 4.21 structured warning.
+   */
+  g_assert_cmpint (g_atomic_int_get (&expected_warning_count), ==, 0);
+  g_assert_cmpint (g_atomic_int_get (&unexpected_warning_count), ==, 0);
+  model = GTK_TREE_MODEL (shortcuts_model);
+
+  /*
+   * Exercise a real upward move and the preference-driven sort emitter.
+   * Every signal must describe the list root and map each new row token to
+   * its old position, while the retained iterator follows its original row.
+   */
+  g_assert_true ((gtk_tree_model_get_flags (model)
+                  & GTK_TREE_MODEL_ITERS_PERSIST)
+                 != 0);
+  paths = shortcut_paths (model,
+                          THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+                          TRUE);
+  g_assert_cmpuint (paths->len, ==, G_N_ELEMENTS (bookmark_uris));
+  src_path = g_ptr_array_index (paths, 2);
+  dst_path = g_ptr_array_index (paths, 0);
+  g_assert_true (gtk_tree_model_get_iter (model, &persistent_iter, src_path));
+  gtk_tree_model_get (model,
+                      &persistent_iter,
+                      THUNAR_SHORTCUTS_MODEL_COLUMN_LOCATION, &source_location,
+                      -1);
+  g_assert_nonnull (source_location);
+
+  signal_id = reorder_probe_connect (model, &probe);
+  g_assert_true (thunar_shortcuts_model_move (shortcuts_model,
+                                              src_path,
+                                              dst_path,
+                                              NULL));
+  g_assert_cmpuint (probe.emissions, ==, 1);
+  assert_iter_location (model, &persistent_iter, source_location);
+  moved_path = gtk_tree_model_get_path (model, &persistent_iter);
+  g_assert_cmpint (gtk_tree_path_compare (moved_path, dst_path), ==, 0);
+  gtk_tree_path_free (moved_path);
+
+  g_assert_true (g_file_get_contents (bookmarks_path,
+                                      &bookmarks_contents,
+                                      NULL,
+                                      NULL));
+  g_assert_true (g_str_has_prefix (bookmarks_contents, bookmark_uris[2]));
+  g_free (bookmarks_contents);
+
+  preferences = thunar_preferences_get ();
+  g_object_get (G_OBJECT (preferences),
+                "shortcuts-places-order", &order,
+                NULL);
+  g_assert_nonnull (order);
+  order_length = g_strv_length (order);
+  g_assert_cmpuint (order_length, >, 1);
+  reversed_order = g_new0 (gchar *, order_length + 1);
+  for (n = 0; n < order_length; ++n)
+    reversed_order[n] = g_strdup (order[order_length - n - 1]);
+
+  emissions_after_move = probe.emissions;
+  g_object_set (G_OBJECT (preferences),
+                "shortcuts-places-order", reversed_order,
+                NULL);
+  g_assert_cmpuint (probe.emissions, >, emissions_after_move);
+  assert_iter_location (model, &persistent_iter, source_location);
+  reorder_probe_disconnect (model, &probe, signal_id);
+  g_strfreev (reversed_order);
+  g_strfreev (order);
+  g_object_unref (preferences);
+  g_object_unref (source_location);
+  g_ptr_array_unref (paths);
+
+  /*
+   * With every Devices row filtered out, the visible boundary before Network
+   * spans the hidden Devices section.  It must resolve to the Devices header,
+   * then commit a real downward Places move with a correct reorder mapping.
+   */
+  filter = gtk_tree_model_filter_new (model, NULL);
+  gtk_tree_model_filter_set_visible_func (GTK_TREE_MODEL_FILTER (filter),
+                                          hide_devices,
+                                          NULL,
+                                          NULL);
+  paths = shortcut_paths (model,
+                          THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+                          TRUE);
+  src_path = g_ptr_array_index (paths, 0);
+  devices_path = group_path (model, THUNAR_SHORTCUT_GROUP_DEVICES_HEADER);
+  network_path = group_path (model, THUNAR_SHORTCUT_GROUP_NETWORK_HEADER);
+  g_assert_nonnull (devices_path);
+  g_assert_nonnull (network_path);
+  g_assert_true (gtk_tree_model_get_iter (model, &persistent_iter, src_path));
+  filtered_dst_path =
+    gtk_tree_model_filter_convert_child_path_to_path (
+      GTK_TREE_MODEL_FILTER (filter), network_path);
+  g_assert_nonnull (filtered_dst_path);
+  resolved_path = thunar_shortcuts_view_convert_drop_path_to_child (
+    filter, src_path, filtered_dst_path);
+  g_assert_nonnull (resolved_path);
+  g_assert_cmpint (gtk_tree_path_compare (resolved_path, devices_path), ==, 0);
+
+  signal_id = reorder_probe_connect (model, &probe);
+  g_assert_true (thunar_shortcuts_model_move (shortcuts_model,
+                                              src_path,
+                                              resolved_path,
+                                              NULL));
+  g_assert_cmpuint (probe.emissions, ==, 1);
+  moved_path = gtk_tree_model_get_path (model, &persistent_iter);
+  g_assert_cmpint (gtk_tree_path_get_indices (moved_path)[0],
+                   ==,
+                   gtk_tree_path_get_indices (devices_path)[0] - 1);
+  reorder_probe_disconnect (model, &probe, signal_id);
+  gtk_tree_path_free (moved_path);
+  gtk_tree_path_free (resolved_path);
+  gtk_tree_path_free (filtered_dst_path);
+  gtk_tree_path_free (network_path);
+  gtk_tree_path_free (devices_path);
+  g_ptr_array_unref (paths);
+  g_object_unref (filter);
+
+  /*
+   * A filtered lower-half self-drop is the interval immediately after the
+   * source, even when a hidden row precedes the next visible row.  Resolve it
+   * in child coordinates and prove the model reports TRUE without reordering.
+   */
+  paths = shortcut_paths (model, THUNAR_SHORTCUT_GROUP_PLACES, FALSE);
+  g_assert_cmpuint (paths->len, >=, 3);
+  src_path = g_ptr_array_index (paths, 0);
+  dst_path = g_ptr_array_index (paths, 1);
+  following_path = g_ptr_array_index (paths, 2);
+  g_assert_true (gtk_tree_model_get_iter (model, &persistent_iter, src_path));
+  thunar_shortcuts_model_set_hidden (shortcuts_model, dst_path, TRUE);
+  g_assert_true (gtk_tree_model_get_iter (model, &hidden_iter, dst_path));
+  gtk_tree_model_get (model,
+                      &hidden_iter,
+                      THUNAR_SHORTCUTS_MODEL_COLUMN_VISIBLE, &visible,
+                      -1);
+  g_assert_false (visible);
+
+  filter = gtk_tree_model_filter_new (model, NULL);
+  gtk_tree_model_filter_set_visible_column (
+    GTK_TREE_MODEL_FILTER (filter),
+    THUNAR_SHORTCUTS_MODEL_COLUMN_VISIBLE);
+  filtered_src_path =
+    gtk_tree_model_filter_convert_child_path_to_path (
+      GTK_TREE_MODEL_FILTER (filter), src_path);
+  g_assert_nonnull (filtered_src_path);
+  filtered_dst_path = gtk_tree_path_copy (filtered_src_path);
+  gtk_tree_path_next (filtered_dst_path);
+  direct_child_dst =
+    gtk_tree_model_filter_convert_path_to_child_path (
+      GTK_TREE_MODEL_FILTER (filter), filtered_dst_path);
+  g_assert_nonnull (direct_child_dst);
+  g_assert_cmpint (gtk_tree_path_compare (direct_child_dst, following_path),
+                   ==,
+                   0);
+
+  resolved_path = thunar_shortcuts_view_convert_drop_path_to_child (
+    filter, src_path, filtered_dst_path);
+  g_assert_nonnull (resolved_path);
+  g_assert_cmpint (gtk_tree_path_get_indices (resolved_path)[0],
+                   ==,
+                   gtk_tree_path_get_indices (src_path)[0] + 1);
+  g_assert_cmpint (gtk_tree_path_compare (resolved_path, dst_path), ==, 0);
+
+  signal_id = reorder_probe_connect (model, &probe);
+  g_assert_true (thunar_shortcuts_model_move (shortcuts_model,
+                                              src_path,
+                                              resolved_path,
+                                              NULL));
+  g_assert_cmpuint (probe.emissions, ==, 0);
+  moved_path = gtk_tree_model_get_path (model, &persistent_iter);
+  g_assert_cmpint (gtk_tree_path_compare (moved_path, src_path), ==, 0);
+  reorder_probe_disconnect (model, &probe, signal_id);
+
+  /*
+   * A rejected cross-section request is neither committed nor satisfied.
+   * It must return FALSE without moving the row or emitting a reorder.
+   */
+  invalid_path = group_path (model, THUNAR_SHORTCUT_GROUP_NETWORK_HEADER);
+  g_assert_nonnull (invalid_path);
+  signal_id = reorder_probe_connect (model, &probe);
+  g_assert_false (thunar_shortcuts_model_move (shortcuts_model,
+                                               src_path,
+                                               invalid_path,
+                                               NULL));
+  g_assert_cmpuint (probe.emissions, ==, 0);
+  current_path = gtk_tree_model_get_path (model, &persistent_iter);
+  g_assert_cmpint (gtk_tree_path_compare (current_path, moved_path), ==, 0);
+  gtk_tree_path_free (current_path);
+  reorder_probe_disconnect (model, &probe, signal_id);
+
+  gtk_tree_path_free (invalid_path);
+  gtk_tree_path_free (moved_path);
+  gtk_tree_path_free (resolved_path);
+  gtk_tree_path_free (direct_child_dst);
+  gtk_tree_path_free (filtered_dst_path);
+  gtk_tree_path_free (filtered_src_path);
+  g_object_unref (filter);
+  g_ptr_array_unref (paths);
+
+  /*
+   * Duplicate bookmarks share one cached ThunarFile.  A destroy callback
+   * must clear every row's file reference before emitting row-changed, so
+   * observers see the final location-backed state for both rows.
+   */
+  {
+    ThunarFile      *destroyed_file = NULL;
+    ThunarFile      *duplicate_file = NULL;
+    GFile            *destroyed_location = NULL;
+    GPtrArray        *duplicate_paths;
+    RowChangedProbe  destroy_probe = {
+      NULL,
+      0,
+      TRUE,
+    };
+    GtkTreeIter      first_iter;
+    GtkTreeIter      second_iter;
+    gulong           destroy_signal_id;
+    gchar           *duplicate_contents;
+
+    duplicate_contents =
+      g_strdup_printf ("%s First\n%s Second\n",
+                       bookmark_uris[0],
+                       bookmark_uris[0]);
+    g_assert_true (g_file_set_contents (bookmarks_path,
+                                        duplicate_contents,
+                                        -1,
+                                        NULL));
+    g_free (duplicate_contents);
+
+    thunar_shortcuts_model_reload (shortcuts_model);
+    duplicate_paths = shortcut_paths (model,
+                                      THUNAR_SHORTCUT_GROUP_PLACES_BOOKMARKS,
+                                      TRUE);
+    g_assert_cmpuint (duplicate_paths->len, ==, 2);
+    g_assert_true (gtk_tree_model_get_iter (
+      model,
+      &first_iter,
+      g_ptr_array_index (duplicate_paths, 0)));
+    g_assert_true (gtk_tree_model_get_iter (
+      model,
+      &second_iter,
+      g_ptr_array_index (duplicate_paths, 1)));
+    gtk_tree_model_get (model,
+                        &first_iter,
+                        THUNAR_SHORTCUTS_MODEL_COLUMN_FILE, &destroyed_file,
+                        THUNAR_SHORTCUTS_MODEL_COLUMN_LOCATION, &destroyed_location,
+                        -1);
+    gtk_tree_model_get (model,
+                        &second_iter,
+                        THUNAR_SHORTCUTS_MODEL_COLUMN_FILE, &duplicate_file,
+                        -1);
+    g_assert_nonnull (destroyed_file);
+    g_assert_nonnull (destroyed_location);
+    g_assert_true (duplicate_file == destroyed_file);
+    g_object_unref (duplicate_file);
+
+    destroy_probe.expected_location = destroyed_location;
+    destroy_signal_id = g_signal_connect (
+      model,
+      "row-changed",
+      G_CALLBACK (row_changed_probe),
+      &destroy_probe);
+    thunar_file_signal_destroy (destroyed_file);
+    g_signal_handler_disconnect (model, destroy_signal_id);
+
+    g_assert_cmpuint (destroy_probe.emissions, ==, 2);
+    g_assert_true (destroy_probe.final_state);
+    g_object_unref (destroyed_location);
+    g_object_unref (destroyed_file);
+    g_ptr_array_unref (duplicate_paths);
+  }
+
+  g_object_unref (shortcuts_model);
+}
